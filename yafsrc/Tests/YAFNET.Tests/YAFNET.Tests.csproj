<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProductVersion />
    <TargetFramework>net10.0</TargetFramework>
    <ProjectTypeGuids>{3AC096D0-A1C2-E12C-1390-A8335801FDAB};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>YAF.Tests</RootNamespace>
    <AssemblyName>YAF.Tests</AssemblyName>
  </PropertyGroup>
  <!-- the tests run on System.Data.SQLite, with dotnet test -p:SqliteProvider=Microsoft.Data.Sqlite on Microsoft.Data.Sqlite
       (YAFNET.Data.Sqlite.Data), see TestInfrastructure/SqliteTestProvider.cs -->
  <PropertyGroup Condition="'$(SqliteProvider)' == 'Microsoft.Data.Sqlite'">
    <DefineConstants>$(DefineConstants);MICROSOFT_DATA_SQLITE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Deploy|AnyCPU'">
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\YetAnotherForum.NET\wwwroot\languages\english.json" Link="languages\english.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\YetAnotherForum.NET\wwwroot\languages\german-du.json" Link="languages\german-du.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- the chat project references the released YAF.NET packages, its rules file is compiled here -->
    <Compile Include="..\..\YAFNET.UI\YAFNET.UI.Chat\ChatRules.cs" Link="Chat\ChatRules.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\YAFNET.Core\YAFNET.Core.csproj" />
    <ProjectReference Include="..\..\YAFNET.Web\YAFNET.Web.csproj" />
    <ProjectReference Include="..\..\YAFNET.Data\YAFNET.Data.Sqlite\YAFNET.Data.Sqlite.csproj" Condition="'$(SqliteProvider)' != 'Microsoft.Data.Sqlite'" />
    <ProjectReference Include="..\..\YAFNET.Data\YAFNET.Data.Sqlite.Data\YAFNET.Data.Sqlite.Data.csproj" Condition="'$(SqliteProvider)' == 'Microsoft.Data.Sqlite'" />
    <ProjectReference Include="..\..\YAFNET.Data\YAFNET.Data.SqlServer\YAFNET.Data.SqlServer.csproj" />
    <ProjectReference Include="..\..\ServiceStack\ServiceStack.OrmLite.PostgreSQL\ServiceStack.OrmLite.PostgreSQL.Core.csproj" />
    <ProjectReference Include="..\..\ServiceStack\ServiceStack.OrmLite.MySql\ServiceStack.OrmLite.MySql.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Acornima" Version="1.9.2" />
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="coverlet.collector" Version="10.1.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.37.0.15768">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>