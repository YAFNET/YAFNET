@page
@using YAF.Core.Context
@using YAF.Core.Extensions
@using YAF.Types.Extensions
@using YAF.Types.Interfaces
@using YAF.Types.Interfaces.Services
@using YAF.UI.Chat
@using YAF.Web.HtmlHelpers
@model YAF.UI.Chat.Areas.Chat.Pages.ChatModel
@{
    ViewData["Title"] = "Chat";

    var currentUserId = BoardContext.Current.PageUserID;

    int? previousUserId = null;
    var previousCreated = DateTime.MinValue;
}

@* the styles of the chat, here and not in the layout, so a layout of the application (Areas/Chat/Pages/Shared/_Layout.cshtml) works too *@
<link rel="stylesheet" href="~/css/yaf-chat.css" asp-append-version="true" />

<div class="container-xxl yaf-chat">
    <div class="card chat-card shadow-sm">
        <div class="card-header d-flex align-items-center gap-3 py-3">
            <span class="chat-header-icon" aria-hidden="true">@Html.Icon("comments")</span>
            <div class="chat-title">
                <h1 class="h5 mb-0">Chat</h1>
                <div class="small text-body-secondary text-truncate">Messages to all members of @BoardContext.Current.BoardSettings.Name</div>
            </div>
            <span id="ChatStatus" class="chat-status ms-auto" role="status" data-state="connecting"
                  data-text-connecting="Connecting..."
                  data-text-connected="Connected"
                  data-text-reconnecting="Reconnecting..."
                  data-text-offline="Offline, reload the page">
                <span class="chat-status-dot" aria-hidden="true"></span>
                <span class="chat-status-text">Connecting...</span>
            </span>
        </div>

        <div id="ChatMessages" class="chat-messages" role="log" aria-live="polite" aria-label="Chat messages"
             data-user-id="@currentUserId"
             data-hub-url="@Url.Content("~/AllChatHub")">
            <div id="ChatEmpty" class="chat-empty @(Model.Messages.Count > 0 ? "d-none" : null)">
                @Html.Icon("comments", "fa-2x mb-2")
                <div class="fw-semibold">No messages yet</div>
                <div class="small">Write the first message.</div>
            </div>

            @foreach (var (message, user) in Model.Messages)
            {
                var own = user.ID == currentUserId;
                var created = DateTime.SpecifyKind(message.Created, DateTimeKind.Utc);
                var continued = ChatRules.ContinuesGroup(previousUserId, previousCreated, user.ID, created);
                var createdIso = created.ToString("o", System.Globalization.CultureInfo.InvariantCulture);

                previousUserId = user.ID;
                previousCreated = created;

                <div class="chat-msg@(own ? " chat-msg-own" : null)@(continued ? " chat-msg-continued" : null)"
                     data-user-id="@user.ID" data-created="@createdIso">
                    @if (!own)
                    {
                        <img class="chat-avatar" src="@(BoardContext.Current.Get<IAvatars>().GetAvatarUrlForUser(user))"
                             alt="" width="36" height="36" loading="lazy" />
                    }
                    <div class="chat-msg-body">
                        <div class="chat-msg-meta">
                            @if (!own)
                            {
                                <span class="chat-msg-name">@user.DisplayOrUserName()</span>
                            }
                            <time datetime="@createdIso">@message.DateTime</time>
                        </div>
                        <div class="chat-bubble" style="--chat-user-color: @AllChatHub.GetUserColor(user)">@message.Message</div>
                    </div>
                </div>
            }
        </div>

        <div class="card-footer chat-composer">
            @if (Model.CanSend)
            {
                <form id="ChatForm" class="d-flex gap-2" autocomplete="off">
                    <input type="text" id="messageInput" class="form-control" maxlength="@ChatRules.MaxMessageLength"
                           placeholder="Write a message..." aria-label="Message" />
                    <button type="submit" id="sendButton" class="btn btn-primary d-flex align-items-center gap-2" disabled>
                        @Html.Icon("paper-plane")
                        <span class="d-none d-sm-inline">Send</span>
                    </button>
                </form>
            }
            else
            {
                <div class="text-body-secondary small d-flex align-items-center gap-2">
                    @Html.Icon("lock")
                    Your account is suspended, you can read the chat but not write.
                </div>
            }
        </div>
    </div>
</div>

@section Scripts
{
    <script src="~/js/chat.min.js" asp-append-version="true"></script>
}
