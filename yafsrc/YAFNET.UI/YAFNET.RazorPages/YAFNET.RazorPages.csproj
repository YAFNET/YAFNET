<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
	<Version>4.0.8</Version>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <RootNamespace>YAF.RazorPages</RootNamespace>
    <Description>YAF.NET UI using ASP.NET Core MVC Razor Pages.</Description>
    <PackageId>YAFNET.RazorPages</PackageId>
    <PackageTags>forums yaf yaf.net YetAnotherForum.net forum</PackageTags>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
	<CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
	<EmbeddedResource Include="wwwroot\css\*.*" />
	<EmbeddedResource Include="wwwroot\css\themes\**\*.*" />      
	<EmbeddedResource Include="wwwroot\**\favicons\*" />
    <EmbeddedResource Include="wwwroot\**\images\*" />
    <EmbeddedResource Include="wwwroot\js\*.*" />
	<EmbeddedResource Include="wwwroot\js\sceditor\*.*" />
    <EmbeddedResource Include="wwwroot\**\languages\*" />
    <EmbeddedResource Include="wwwroot\**\resources\*" />
    <EmbeddedResource Include="wwwroot\**\webfonts\*" />
  </ItemGroup>

	<PropertyGroup>
		<StaticWebAssetBasePath Condition="$(StaticWebAssetBasePath) == ''">/</StaticWebAssetBasePath>
		<Title>YAF.NET Razor Pages UI</Title>
		<Company>Ingo Herbote</Company>
		<PackageIcon>yaf.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<Authors>Ingo Herbote</Authors>
	</PropertyGroup>

	<UsingTask TaskName="ExtractReleaseNotes" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
		<ParameterGroup>
			<ChangesFile ParameterType="System.String" Required="true" />
			<Version ParameterType="System.String" Required="true" />
			<ReleaseNotes ParameterType="System.String" Output="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System.IO" />
			<Using Namespace="System.Text.RegularExpressions" />
			<Code Type="Fragment" Language="cs">
<![CDATA[
var text = File.ReadAllText(ChangesFile);
var pattern = @"^# YetAnotherForum\.NET v" + Regex.Escape(Version) + @"\s*?\r?\n(.*?)(?=\r?\n# YetAnotherForum\.NET v|\z)";
var match = Regex.Match(text, pattern, RegexOptions.Singleline | RegexOptions.Multiline);
ReleaseNotes = match.Success ? match.Groups[1].Value.Trim() : string.Empty;
if (ReleaseNotes.Length > 30000)
{
    ReleaseNotes = ReleaseNotes.Substring(0, 30000);
}
]]>
			</Code>
		</Task>
	</UsingTask>

	<Target Name="SetPackageReleaseNotes" BeforeTargets="GenerateNuspec">
		<ExtractReleaseNotes ChangesFile="$(MSBuildProjectDirectory)/../../../CHANGES.md" Version="$(Version)">
			<Output TaskParameter="ReleaseNotes" PropertyName="PackageReleaseNotes" />
		</ExtractReleaseNotes>
	</Target>

	<ItemGroup>
	  <Content Remove="package.json" />
	</ItemGroup>          
	
	<ItemGroup>
		<Folder Include="Areas\Forums\Pages\" />
	</ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\LICENSE.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\yaf.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="package.json" />
    <None Include="package-lock.json" />
    <None Include="tsconfig.json" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="HtmlProperties" Version="1.0.2" />
	<PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" version="10.0.11" />
	<PackageReference Include="SonarAnalyzer.CSharp" Version="10.32.0.713">
	  <PrivateAssets>all</PrivateAssets>
	  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	</PackageReference>
	<PackageReference Include="YAFNET.Core" Version="4.0.8" />
	<PackageReference Include="YAFNET.Types" Version="4.0.8" />
	<PackageReference Include="YAFNET.Web" Version="4.0.8" />
	<PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" version="10.0.11" />
  </ItemGroup>

</Project>
