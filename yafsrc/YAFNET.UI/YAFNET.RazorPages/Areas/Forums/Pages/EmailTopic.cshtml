@page "{t:int}/{handler?}"

@using YAF.Types.Interfaces
@using YAF.Web.HtmlHelpers
@model EmailTopicModel

<form method="post" class="needs-validation post-action-page" novalidate>
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h2 class="h4 mb-0">@Html.Icon("envelope-open")@Html.LocalizedText("EMAILTOPIC", "TITLE")</h2>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <label asp-for="Input.Email" class="form-label"
                   localized-page="EMAILTOPIC"
                   localized-tag="TO">
            </label>
            <div class="input-group has-validation">
                <span class="input-group-text">@Html.Icon("at", "text-secondary")</span>
                <input asp-for="Input.Email" type="email" class="form-control" autocomplete="email" autofocus required />
                <div class="invalid-feedback">
                    @Html.LocalizedText("EMAILTOPIC", "NEED_EMAIL")
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            @Html.Icon("eye")@Html.LocalizedText("POSTMESSAGE", "PREVIEW")
        </div>
        <div class="card-body">
            <div class="mb-2">
                <span class="text-body-secondary">@Html.LocalizedText("EMAILTOPIC", "SUBJECT")</span>
                <span class="fw-semibold" id="EmailSubject">@Model.Subject</span>
            </div>
            <pre class="bg-body-tertiary border rounded p-3 mb-0" style="white-space: pre-wrap" id="EmailBody">@Model.Body</pre>
        </div>
    </div>

    <div class="post-action-bar">
        <a role="button"
           href="@Html.Raw(Model.Get<ILinkBuilder>().GetTopicLink(Model.PageBoardContext.PageTopic))"
           button-style="Secondary"
           icon="reply"
           text-localized-page="COMMON"
           text-localized-tag="CANCEL"></a>
        <button type="submit" button-style="Primary"
                icon="paper-plane"
                text-localized-tag="SEND"></button>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptPartial")
}
