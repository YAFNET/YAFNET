@page "{faq=index}/{handler?}"
@using YAF.Web.HtmlHelpers
@using YAF.Types.Interfaces
@model HelpModel

@{
    Model.PageBoardContext.CurrentForumPage.PageTitle = Html.HtmlEncode($"{Model.Get<ILocalization>().GetText("HELP_INDEX", "SUBTITLE")} &#183; {Model.Get<ILocalization>().GetText("HELP_INDEX", HelpModel.TitleTag(Request.RouteValues["faq"]?.ToString()))}").ToString();

    var faq = Request.RouteValues["faq"]?.ToString() ?? "index";
    var isSearch = faq == "search";
    var contents = isSearch
                       ? Model.HelpContents ?? []
                       : (Model.HelpContents ?? []).Where(check => check.HelpPage.ToLower().Equals(faq)).ToList();
}

<div class="container-fluid help-page">
    <div class="row g-0">

        @Html.HelpMenu()

        <div class="col flex-grow-1 ms-lg-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <h2 class="h4 mb-0">@Html.Icon("question-circle")@Html.LocalizedText("HELP_INDEX", "TITLE")</h2>
            </div>

            @if (faq == "index" || isSearch)
            {
                <form method="post" asp-route-faq="search" class="mb-3">
                    <div class="card help-search">
                        <div class="card-body">
                            @if (!isSearch)
                            {
                                <p class="text-body-secondary">
                                    @Html.LocalizedText("HELP_INDEX", "WELCOME")
                                </p>
                            }
                            <label asp-for="Input.Search" class="form-label visually-hidden"
                                   localized-page="HELP_INDEX" localized-tag="SEARCHFOR">
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">@Html.Icon("search", "text-secondary")</span>
                                <input asp-for="Input.Search" class="form-control" type="search"
                                       placeholder="@Model.GetText("HELP_INDEX", "SEARCHFOR").TrimEnd(':')" />
                                <button type="submit" button-style="Primary"
                                        text-localized-page="HELP_INDEX"
                                        text-localized-tag="BTNSEARCH">
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            }

            @foreach (var content in contents)
            {
                <div class="card mb-3 help-topic">
                    <div class="card-header fw-semibold">
                        @Html.Icon("question-circle", "text-primary")
                        @if (isSearch)
                        {
                            @* the title is encoded and the found words are marked *@
                            @Html.Raw(content.Title)
                        }
                        else
                        {
                            @content.Title
                        }
                    </div>
                    <div class="card-body">
                        @Html.Raw(content.Content)
                    </div>
                </div>
            }
        </div>
    </div>
</div>
