@page "{p:int=1}/{handler?}"

@model SpamLogModel
@using YAF.Core.Helpers
@using YAF.Core.Utilities
@using YAF.Types.Interfaces
@using YAF.Types.Extensions
@using YAF.Types.Interfaces.Services
@using YAF.Types.Objects
@using YAF.Web.HtmlHelpers

@{
    var totalRows = Model.List.NullOrEmpty() ? 0 : Model.List.FirstOrDefault()!.TotalRows;
}

<div class="admin-spam">

@Html.SpamProtectionNav()

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h2 class="h4 mb-0">
        @Html.Icon("book")@Html.LocalizedText("ADMIN_SPAMLOG", "TITLE")
        <span class="badge text-bg-secondary align-middle ms-1 spam-count">@totalRows</span>
    </h2>
    @if (totalRows > 0)
    {
        <div class="d-flex flex-wrap gap-2 spam-actions">
            <button button-style="Danger"
                    button-size="Small"
                    form="SpamList"
                    Icon="trash"
                    asp-page-handler="DeleteAll"
                    text-localized-page="ADMIN_EVENTLOG" text-localized-tag="DELETE_ALLOWED"
                    return-confirm-tag="CONFIRM_DELETE_ALL"></button>
        </div>
    }
</div>

<form method="post" id="SpamList">
    @* the time span of the entries *@
    <div class="d-flex flex-wrap align-items-end gap-2 mb-3 spam-search">
        <div>
            <label class="form-label small mb-1" asp-for="Input.SinceDate"
                   localized-page="ADMIN_EVENTLOG" localized-tag="SINCEDATE"></label>
            <input type="date" asp-for="Input.SinceDate" class="form-control form-control-sm" />
        </div>
        <div>
            <label class="form-label small mb-1" asp-for="Input.ToDate"
                   localized-page="ADMIN_EVENTLOG" localized-tag="TODATE"></label>
            <input type="date" asp-for="Input.ToDate" class="form-control form-control-sm" />
        </div>
        <button ID="ApplyButton"
                button-style="Secondary"
                button-size="Small"
                asp-page-handler="ApplyButton"
                asp-route-p="1"
                text-localized-page="ADMIN_EVENTLOG"
                text-localized-tag="APPLY"
                Icon="check"></button>
        <div class="input-group input-group-sm w-auto ms-auto">
            <span class="input-group-text">@Html.LocalizedText("SHOW"):</span>
            <select asp-for="@Model.Size"
                    asp-items="Model.PageSizeList"
                    title="@Html.LocalizedText("COMMON", "SHOW_TITLE")"
                    aria-label="@Html.LocalizedText("COMMON", "SHOW_TITLE")"
                    class="form-select"
                    onchange="this.form.submit();"></select>
        </div>
    </div>

    @if (!Model.List.NullOrEmpty())
    {
        <ul class="list-group mb-3 spam-list">
            @foreach (var item in Model.List)
            {
                var summary = Model.GetSummary(item.Description);

                <li class="list-group-item list-group-item-menu spam-log-row">
                    <input type="hidden" id="EventTypeID" value="@item.Type" />
                    <div class="d-flex flex-wrap justify-content-between gap-2">
                        <span class="fw-semibold text-break">@(item.Source.IsSet() ? item.Source : "N/A")</span>
                        <span class="small text-body-secondary text-nowrap">
                            @Html.Icon("calendar-day")@Html.Raw(Model.Get<IDateTimeService>().FormatDateTimeTopic(item.EventTime))
                        </span>
                    </div>
                    @if (summary.Message.IsSet())
                    {
                        <div class="spam-log-message text-break">@summary.Message</div>
                    }
                    <div class="spam-log-badges">
                        @if (item.UserID > 0)
                        {
                            <span class="badge text-bg-light border">
                                @Html.UserLink(item.UserID, Model.PageBoardContext.BoardSettings.EnableDisplayName ? item.DisplayName : item.Name, item.Suspended, item.UserStyle)
                            </span>
                        }
                        @if (summary.UserIp.IsSet())
                        {
                            <a class="badge text-bg-info text-decoration-none"
                               href="@string.Format(Model.PageBoardContext.BoardSettings.IPInfoPageURL, summary.UserIp)"
                               title="@Html.LocalizedText("COMMON", "TT_IPDETAILS")"
                               target="_blank" rel="noopener">@Html.Icon("desktop")@summary.UserIp</a>
                        }
                        @if (summary.Url.IsSet())
                        {
                            <span class="badge text-bg-secondary text-break">@Html.Icon("globe")@summary.Url</span>
                        }
                        @if (summary.UserAgent.IsSet())
                        {
                            <span class="badge text-bg-light border text-break">@Html.Icon("computer")@summary.UserAgent</span>
                        }
                    </div>
                    <div class="btn-group btn-group-sm mt-2">
                        @if (summary.HasException)
                        {
                            <button type="button"
                                    button-style="Info"
                                    button-size="Small"
                                    text-localized-tag="SHOW" text-localized-page="ADMIN_EVENTLOG"
                                    Icon="caret-square-down"
                                    class="@($"btn-toggle-{item.ID}")"
                                    bs-toggle="collapse"
                                    bs-target="@($"#eventDetails{item.ID}")"></button>
                        }
                        <button button-style="Danger"
                                button-size="Small"
                                asp-page-handler="Delete"
                                asp-route-id="@item.ID"
                                return-confirm-tag="CONFIRM_DELETE"
                                Icon="trash"
                                text-localized-tag="DELETE"></button>
                    </div>
                    <div class="dropdown-menu context-menu" aria-labelledby="context menu">
                        <button button-style="None"
                                class="dropdown-item"
                                asp-page-handler="Delete"
                                asp-route-id="@item.ID"
                                return-confirm-tag="CONFIRM_DELETE"
                                Icon="trash"
                                text-localized-tag="DELETE"></button>
                        <div class="dropdown-divider"></div>
                        <button button-style="None"
                                class="dropdown-item"
                                Icon="trash"
                                asp-page-handler="DeleteAll"
                                text-localized-page="ADMIN_EVENTLOG" text-localized-tag="DELETE_ALLOWED"
                                return-confirm-tag="CONFIRM_DELETE_ALL"></button>
                    </div>
                    @if (summary.HasException)
                    {
                        <div class="collapse mt-3" id="@($"eventDetails{item.ID}")">
                            <div class="card card-body">
                                <pre class="pre-scrollable stacktrace overflow-auto"><code>@Html.Raw(Model.FormatStackTrace(item.Description))</code></pre>
                            </div>
                        </div>
                    }
                </li>
            }
        </ul>

        @await Html.PartialAsync("_Pagination", new Pagination { TotalRows = totalRows, Size = Model.Size })
    }
    else
    {
        <div class="card mb-3">
            <div class="card-body">
                @await Html.PartialAsync("_NoEntryInfo")
            </div>
        </div>
    }
</form>

</div>

@section Scripts {
    <script>
    @Html.Raw(JsAndCssHelper.CompressJavaScript(JavaScriptBlocks.CollapseToggleJs(
        Model.GetText("ADMIN_EVENTLOG", "HIDE"),
        Model.GetText("ADMIN_EVENTLOG", "SHOW"))));
    </script>
}
