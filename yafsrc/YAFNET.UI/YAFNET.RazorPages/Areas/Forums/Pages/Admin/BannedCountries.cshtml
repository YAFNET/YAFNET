@page "{p:int=1}/{handler?}"

@model BannedCountriesModel
@using YAF.Core.Extensions
@using YAF.Core.Helpers
@using YAF.Core.Utilities
@using YAF.Types.Extensions
@using YAF.Types.Interfaces
@using YAF.Types.Models
@using YAF.Types.Objects
@using YAF.Web.HtmlHelpers

@section StyleSheets {
	@await Html.PartialAsync("_FlagIconsStylesSheetsPartial")
}

<div class="admin-spam">

@Html.SpamProtectionNav()

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h2 class="h4 mb-0">
        @Html.Icon("globe")@Html.LocalizedText("ADMIN_BANNED_COUNTRIES", "TITLE")
        <span class="badge text-bg-secondary align-middle ms-1 spam-count">@Model.TotalRows</span>
    </h2>
    <div class="d-flex flex-wrap gap-2 spam-actions">
        <button Icon="plus-square"
                button-style="Primary"
                button-size="Small"
                bs-toggle="ajax-modal"
                bs-target-url="@Url.Page("BannedCountries", "Add")"
                text-localized-tag="ADD_COUNTRY" text-localized-page="ADMIN_BANNED_COUNTRIES"></button>
    </div>
</div>

<form method="post" id="SpamList">
    <div class="d-flex flex-wrap align-items-center justify-content-end gap-2 mb-3 spam-search">
        <div class="input-group input-group-sm w-auto">
            <span class="input-group-text">@Html.LocalizedText("SHOW"):</span>
            <select asp-for="@Model.Size"
                    asp-items="Model.PageSizeList"
                    title="@Html.LocalizedText("COMMON", "SHOW_TITLE")"
                    aria-label="@Html.LocalizedText("COMMON", "SHOW_TITLE")"
                    class="form-select"
                    onchange="this.form.submit();"></select>
        </div>
    </div>

    @if (!Model.List.NullOrEmpty())
    {
        <ul class="list-group mb-3 spam-list">
            @foreach (var item in Model.List)
            {
                var country = Model.GetText("COUNTRY", item.Country);

                <li class="list-group-item list-group-item-menu spam-row">
                    <input type="hidden" id="fID" value="@item.ID" />
                    <div class="spam-row-main">
                        <span class="@($"fi fi-{item.Country.ToLower()} me-2")" aria-hidden="true"></span>@country
                        <code class="small text-body-secondary ms-1">@item.Country</code>
                    </div>
                    <div class="btn-group btn-group-sm spam-row-actions">
                        <button button-style="Danger"
                                button-size="Small"
                                asp-page-handler="Delete"
                                asp-route-id="@item.ID"
                                text-localized-tag="DELETE"
                                return-confirm-tag="MSG_DELETE"
                                title-localized-tag="DELETE"
                                Icon="trash"></button>
                    </div>
                    <div class="dropdown-menu context-menu" aria-labelledby="context menu">
                        <button button-style="None"
                                class="dropdown-item"
                                asp-page-handler="Delete"
                                asp-route-id="@item.ID"
                                text-localized-tag="DELETE"
                                return-confirm-tag="MSG_DELETE"
                                title-localized-tag="DELETE"
                                Icon="trash"></button>
                        <div class="dropdown-divider"></div>
                        <button Icon="plus-square"
                                button-style="None"
                                class="dropdown-item"
                                text-localized-tag="ADD_COUNTRY" text-localized-page="ADMIN_BANNED_COUNTRIES"
                                bs-toggle="ajax-modal"
                                bs-target-url="@(Url.Page("BannedCountries", "Add"))"></button>
                    </div>
                </li>
            }
        </ul>

        @await Html.PartialAsync("_Pagination", new Pagination { TotalRows = Model.TotalRows, Size = Model.Size })
    }
    else
    {
        <div class="card mb-3">
            <div class="card-body">
                <empty icon="globe"
                       header-text-page="ADMIN_BANNED_COUNTRIES" header-text-tag="EMPTY_HEADER"
                       message-text-page="ADMIN_BANNED_COUNTRIES" message-text-tag="EMPTY_MESSAGE">
                </empty>
            </div>
        </div>
    }
</form>

</div>

@section Scripts {
	@await Html.PartialAsync("_ChoicesScriptsPartial")

	<script>
		@Html.Raw(JsAndCssHelper.CompressJavaScript(JavaScriptBlocks.ModalNotifyJs()));

        @Html.Raw(JsAndCssHelper.CompressJavaScript(JavaScriptBlocks.DialogFunctionsJs($"loadSelectMenus();{JavaScriptBlocks.ToolTipJs}")))
	</script>
}
