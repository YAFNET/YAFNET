@page "{handler?}"
@using YAF.Types.Extensions
@using YAF.Types.Objects
@using YAF.Web.HtmlHelpers
@model RunSqlModel

<form method="post" class="needs-validation admin-run-sql" novalidate>
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h2 class="h4 mb-0">
            @Html.Icon("database")@Html.LocalizedText("ADMIN_RUNSQL", "TITLE")
        </h2>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            @Html.Icon("code")@Html.LocalizedText("ADMIN_RUNSQL", "SQL_COMMAND")
        </div>
        <div class="card-body">
            <textarea asp-for="Editor"
                      class="form-control"
                      rows="15"
                      cols="100"
                      maxlength="@int.MaxValue"
                      max-characters="@int.MaxValue"
                      editor-mode="Sql"
                      aria-label="@Html.LocalizedText("ADMIN_RUNSQL", "SQL_COMMAND")"></textarea>
        </div>
        <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="small text-body-secondary run-sql-hint">
                @Html.Icon("keyboard")@Html.LocalizedText("ADMIN_RUNSQL", "RUN_HINT")
            </span>
            <button button-style="Primary"
                    asp-page-handler="RunQuery"
                    data-run-query="true"
                    Icon="rocket"
                    text-localized-tag="RUN_QUERY"
                    text-localized-page="ADMIN_RUNSQL">
            </button>
        </div>
    </div>

    @if (Model.Result is not null)
    {
        var result = Model.Result;

        <div class="row">
            <div class="col-xl-12">
                <div class="card mb-3" id="RunSqlResult">
                    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <span>@Html.Icon("table")@Html.LocalizedText("ADMIN_RUNSQL", "RESULT")</span>
                        @if (result.ResultSets.Count > 0)
                        {
                            <span class="badge text-bg-secondary run-sql-rows">
                                @Model.GetTextFormatted("ROW_COUNT", result.ResultSets.Sum(r => r.Rows.Count))
                            </span>
                        }
                    </div>
                    <div class="card-body">
                        @if (result.Error is not null)
                        {
                            <div class="alert alert-danger" role="alert">
                                <pre class="mb-0 text-wrap">@result.Error</pre>
                            </div>
                        }

                        @if (result.RecordsAffected > 0)
                        {
                            <div class="alert alert-info" role="alert">
                                @Model.GetTextFormatted("RECORDS_AFFECTED", result.RecordsAffected)
                            </div>
                        }
                        else if (result.ResultSets.Count == 0 && result.Error is null)
                        {
                            <div class="alert alert-info" role="alert">
                                @Model.GetText("ADMIN_RUNSQL", "NO_RESULTS")
                            </div>
                        }

                        @if (result.ResultSets.Count > 0)
                        {
                            <ul class="nav nav-tabs mb-3" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link active" type="button" role="tab"
                                            data-bs-toggle="tab" data-bs-target="#RunSqlTable"
                                            aria-controls="RunSqlTable" aria-selected="true">
                                        @Html.LocalizedText("ADMIN_RUNSQL", "TABLE")
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link" type="button" role="tab"
                                            data-bs-toggle="tab" data-bs-target="#RunSqlCsv"
                                            aria-controls="RunSqlCsv" aria-selected="false">
                                        CSV
                                    </button>
                                </li>
                            </ul>
                            <div class="tab-content">
                                <div class="tab-pane fade show active" id="RunSqlTable" role="tabpanel">
                                    @foreach (var resultSet in result.ResultSets)
                                    {
                                        @if (resultSet.Truncated)
                                        {
                                            <div class="alert alert-warning" role="alert">
                                                @Model.GetTextFormatted("ROWS_TRUNCATED", RunSqlResult.MaxRows)
                                            </div>
                                        }

                                        <div class="table-responsive mb-3 run-sql-table">
                                            <table class="table table-sm table-striped table-hover table-bordered mb-0 small">
                                                <thead class="sticky-top">
                                                    <tr>
                                                        <th scope="col">#</th>
                                                        @foreach (var column in resultSet.Columns)
                                                        {
                                                            <th scope="col" class="text-nowrap">@column</th>
                                                        }
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @for (var i = 0; i < resultSet.Rows.Count; i++)
                                                    {
                                                        <tr>
                                                            <th scope="row" class="text-body-secondary">@(i + 1)</th>
                                                            @foreach (var value in resultSet.Rows[i])
                                                            {
                                                                <td>
                                                                    @if (value is null)
                                                                    {
                                                                        <span class="text-body-secondary fst-italic">NULL</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        @value
                                                                    }
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                                <div class="tab-pane fade" id="RunSqlCsv" role="tabpanel">
                                    <textarea class="form-control font-monospace run-sql-csv" rows="15" wrap="off" readonly
                                              aria-label="CSV">@result.ToString()</textarea>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptPartial")
    @await Html.PartialAsync("_CodeMirrorScriptsPartial")
}