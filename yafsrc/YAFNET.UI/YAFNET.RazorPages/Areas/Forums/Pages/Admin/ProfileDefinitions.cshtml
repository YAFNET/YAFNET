@page "{handler?}"

@model ProfileDefinitionsModel

@using YAF.Core.Helpers
@using YAF.Core.Utilities
@using YAF.Types.Extensions
@using YAF.Web.HtmlHelpers

<form method="post" class="admin-profile-definitions">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h2 class="h4 mb-0">
            @Html.Icon("id-card")@Html.LocalizedText("ADMIN_PROFILEDEFINITIONS", "TITLE")
            <span class="badge text-bg-secondary align-middle ms-1">@(Model.List?.Count ?? 0)</span>
        </h2>
        <button id="NewProfileDefinition"
                bs-toggle="ajax-modal"
                bs-target-url="@(Url.Page("ProfileDefinitions", "Add"))"
                button-style="Primary"
                Icon="plus-square"
                text-localized-tag="NEW_DEF"></button>
    </div>

    @if (!Model.List.NullOrEmpty())
    {
        <div class="card mb-3">
            <ul class="list-group list-group-flush">
                @foreach (var item in Model.List)
                {
                    var usages = Model.UsageCounts.GetValueOrDefault(item.ID);

                    <li class="list-group-item profile-definition-row list-group-item-menu" data-definition-id="@item.ID">
                        <span class="profile-definition-icon bg-primary-subtle text-primary-emphasis" aria-hidden="true">
                            @Html.Icon(ProfileDefinitionsModel.GetTypeIcon(item.DataType), marginEnd: false)
                        </span>
                        <div class="profile-definition-main">
                            <div class="fw-semibold text-break profile-definition-name">@item.Name</div>
                            <div class="profile-definition-meta">
                                <span class="badge bg-body-tertiary text-body-secondary border">@item.DataType</span>
                                @if (item.Length > 0)
                                {
                                    <span class="badge bg-body-tertiary text-body-secondary border"
                                          title="@Model.GetText("ADMIN_EDIT_PROFILEDEFINITION", "LENGTH")">
                                        @Html.Icon("ruler-horizontal")@item.Length
                                    </span>
                                }
                                @if (item.Required)
                                {
                                    <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle">
                                        @Html.LocalizedText("ADMIN_EDIT_PROFILEDEFINITION", "REQUIRED")
                                    </span>
                                }
                                @if (item.ShowInUserInfo)
                                {
                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                        @Html.LocalizedText("ADMIN_EDIT_PROFILEDEFINITION", "SHOW_USERINFO")
                                    </span>
                                }
                                @if (item.ShowOnRegisterPage)
                                {
                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                        @Html.LocalizedText("ADMIN_EDIT_PROFILEDEFINITION", "SHOW_REGISTER")
                                    </span>
                                }
                                <span class="small text-body-secondary profile-definition-usages">
                                    @Html.Icon("users")@Model.GetTextFormatted("USED_BY", usages)
                                </span>
                            </div>
                        </div>
                        <div class="profile-definition-actions btn-group btn-group-sm">
                            <button button-style="OutlineSecondary"
                                    button-size="Small"
                                    bs-toggle="ajax-modal"
                                    bs-target-url="@(Url.Page("ProfileDefinitions", "Edit", new { id = item.ID }))"
                                    title-localized-tag="EDIT"
                                    Icon="edit"
                                    text-localized-tag="EDIT">
                            </button>
                            <button button-style="None"
                                    class="btn btn-sm btn-outline-danger"
                                    asp-page-handler="Delete"
                                    asp-route-id="@item.ID"
                                    bs-toggle="confirm"
                                    data-title="@Model.GetDeleteText(item, usages)"
                                    data-yes="@Html.LocalizedText("YES")"
                                    data-no="@Html.LocalizedText("NO")"
                                    title-localized-tag="DELETE"
                                    Icon="trash">
                            </button>
                        </div>
                        <div class="dropdown-menu context-menu" aria-labelledby="context menu">
                            <button button-style="None"
                                    class="dropdown-item"
                                    bs-toggle="ajax-modal"
                                    bs-target-url="@(Url.Page("ProfileDefinitions", "Edit", new { id = item.ID }))"
                                    Icon="edit"
                                    text-localized-tag="EDIT">
                            </button>
                            <button button-style="None"
                                    class="dropdown-item"
                                    asp-page-handler="Delete"
                                    asp-route-id="@item.ID"
                                    bs-toggle="confirm"
                                    data-title="@Model.GetDeleteText(item, usages)"
                                    data-yes="@Html.LocalizedText("YES")"
                                    data-no="@Html.LocalizedText("NO")"
                                    Icon="trash"
                                    text-localized-tag="DELETE">
                            </button>
                            <div class="dropdown-divider"></div>
                            <button bs-toggle="ajax-modal"
                                    bs-target-url="@(Url.Page("ProfileDefinitions", "Add"))"
                                    button-style="None"
                                    class="dropdown-item"
                                    Icon="plus-square"
                                    text-localized-tag="NEW_DEF"></button>
                        </div>
                    </li>
                }
            </ul>
        </div>
    }
    else
    {
        <div class="card mb-3">
            <div class="card-body">
                <empty icon="id-card"
                       header-text-page="ADMIN_PROFILEDEFINITIONS" header-text-tag="EMPTY_HEADER"
                       message-text-page="ADMIN_PROFILEDEFINITIONS" message-text-tag="EMPTY_MESSAGE">
                </empty>
            </div>
        </div>
    }
</form>

@section Scripts {
    <script>
        @Html.Raw(JsAndCssHelper.CompressJavaScript(JavaScriptBlocks.ModalNotifyJs()));

        @Html.Raw(JsAndCssHelper.CompressJavaScript(
        JavaScriptBlocks.DialogFunctionsJs(JavaScriptBlocks.ToolTipJs)))

    </script>
}
