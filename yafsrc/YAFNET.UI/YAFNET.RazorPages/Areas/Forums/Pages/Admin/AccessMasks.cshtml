@page "{handler?}"
@model AccessMasksModel
@using YAF.Types.Constants
@using YAF.Types.Extensions
@using YAF.Types.Flags
@using YAF.Web.HtmlHelpers

@{
    // the rights of an access mask (column title, icon, flag)
    var rights = new (string Tag, string Icon, Func<AccessFlags, bool> Flag)[]
    {
        ("READ", "eye", f => f.ReadAccess),
        ("POST", "pen", f => f.PostAccess),
        ("REPLY", "reply", f => f.ReplyAccess),
        ("PRIORITY", "thumbtack", f => f.PriorityAccess),
        ("POLL", "poll", f => f.PollAccess),
        ("VOTE", "check-square", f => f.VoteAccess),
        ("MODERATOR", "gavel", f => f.ModeratorAccess),
        ("EDIT", "edit", f => f.EditAccess),
        ("DELETE", "trash", f => f.DeleteAccess)
    };
}

<form method="post" class="admin-access-masks">

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h2 class="h4 mb-0">
        @Html.IconHeader("universal-access", "ADMIN_ACCESSMASKS", "TITLE")
        <span class="badge rounded-pill text-bg-secondary align-middle">@(Model.List?.Count ?? 0)</span>
    </h2>
    <a asp-page="@ForumPages.Admin_EditAccessMask.GetPageName()"
       button-style="Primary"
       Icon="plus-square"
       text-localized-tag="NEW_MASK">
    </a>
</div>

@if (!Model.List.NullOrEmpty())
{
    <div class="card mb-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 access-mask-table">
                <thead>
                    <tr>
                        <th scope="col">@Html.LocalizedText("ADMIN_ACCESSMASKS", "NAME")</th>
                        @foreach (var right in rights)
                        {
                            <th scope="col" class="text-center access-mask-right">
                                @Html.Icon(right.Icon, "d-block mx-auto mb-1", marginEnd: false)
                                <span class="small">@Html.LocalizedText("ADMIN_ACCESSMASKS", right.Tag)</span>
                            </th>
                        }
                        <th scope="col">@Html.LocalizedText("ADMIN_ACCESSMASKS", "USED_BY")</th>
                        <th scope="col"><span class="visually-hidden">@Html.LocalizedText("ADMIN_ACCESSMASKS", "EDIT")</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var accessMask in Model.List)
                    {
                        var flags = accessMask.AccessFlags;
                        var usage = Model.Usage.GetValueOrDefault(accessMask.ID);
                        var inUse = usage.Roles > 0 || usage.Users > 0;

                        <tr class="row-menu" data-mask-id="@accessMask.ID">
                            <th scope="row" class="access-mask-name">
                                <a asp-page="@ForumPages.Admin_EditAccessMask.GetPageName()"
                                   asp-route-i="@accessMask.ID">@accessMask.Name</a>
                                <div class="small text-body-secondary fw-normal">@Html.LocalizedText("SORT_ORDER") @accessMask.SortOrder</div>
                            </th>
                            @foreach (var right in rights)
                            {
                                var allowed = right.Flag(flags);

                                <td class="text-center">
                                    @if (allowed)
                                    {
                                        @Html.Icon("check", "text-success", marginEnd: false)
                                    }
                                    else
                                    {
                                        @Html.Icon("times", "text-body-tertiary", marginEnd: false)
                                    }
                                    <span class="visually-hidden">@Model.GetItemName(allowed)</span>
                                </td>
                            }
                            <td class="small text-nowrap">
                                @if (inUse)
                                {
                                    @Html.LocalizedTextFormatted("USED_BY_COUNT", usage.Roles, usage.Users)
                                }
                                else
                                {
                                    <span class="text-body-secondary">@Html.LocalizedText("ADMIN_ACCESSMASKS", "NOT_USED")</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <div class="btn-group btn-group-sm">
                                    <button button-style="Info"
                                            button-size="Small"
                                            asp-page-handler="Edit"
                                            asp-route-maskId="@accessMask.ID"
                                            title-localized-tag="EDIT"
                                            Icon="edit"
                                            text-localized-tag="EDIT">
                                    </button>
                                    @if (inUse)
                                    {
                                        @* a used mask can't be deleted (the server checks it as well) *@
                                        <span class="d-inline-block" tabindex="0"
                                              title="@Html.LocalizedText("ADMIN_ACCESSMASKS", "MSG_NOT_DELETE")">
                                            <button button-style="Danger"
                                                    button-size="Small"
                                                    asp-page-handler="Delete"
                                                    asp-route-maskId="@accessMask.ID"
                                                    disabled="disabled"
                                                    Icon="trash"
                                                    text-localized-tag="DELETE"
                                                    return-confirm-tag="CONFIRM_DELETE">
                                            </button>
                                        </span>
                                    }
                                    else
                                    {
                                        <button button-style="Danger"
                                                button-size="Small"
                                                asp-page-handler="Delete"
                                                asp-route-maskId="@accessMask.ID"
                                                title-localized-tag="DELETE"
                                                Icon="trash"
                                                text-localized-tag="DELETE"
                                                return-confirm-tag="CONFIRM_DELETE">
                                        </button>
                                    }
                                </div>
                                <div class="dropdown-menu context-menu" aria-labelledby="context menu">
                                    <button button-style="None"
                                            class="dropdown-item"
                                            asp-page-handler="Edit"
                                            asp-route-maskId="@accessMask.ID"
                                            title-localized-tag="EDIT"
                                            Icon="edit"
                                            text-localized-tag="EDIT">
                                    </button>
                                    @if (!inUse)
                                    {
                                        <button button-style="None"
                                                class="dropdown-item"
                                                asp-page-handler="Delete"
                                                asp-route-maskId="@accessMask.ID"
                                                title-localized-tag="DELETE"
                                                Icon="trash"
                                                text-localized-tag="DELETE"
                                                return-confirm-tag="CONFIRM_DELETE">
                                        </button>
                                    }
                                    <div class="dropdown-divider"></div>
                                    <button asp-page-handler="New"
                                            button-style="None"
                                            class="dropdown-item"
                                            Icon="plus-square"
                                            text-localized-tag="NEW_MASK"></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

</form>
