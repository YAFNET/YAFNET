@page "{handler?}"
@using YAF.Types.Constants
@using YAF.Types.Extensions
@using YAF.Web.HtmlHelpers
@model DigestModel

@{
    var enabled = Model.PageBoardContext.BoardSettings.AllowDigestEmail;
}

<form method="post" class="admin-digest">
    @if (enabled)
    {
        @* the default button of the form (Enter in the email field): the test, not the digest to all users *@
        <button type="submit" asp-page-handler="TestSend" class="visually-hidden" tabindex="-1" aria-hidden="true"></button>
    }
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h2 class="h4 mb-0">
            @Html.Icon("envelope")@Html.LocalizedText("ADMIN_DIGEST", "TITLE")
        </h2>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-6">
            <div class="card h-100" id="DigestStatus">
                <div class="card-body d-flex gap-3">
                    <div class="digest-status-icon @(enabled ? "bg-success-subtle text-success-emphasis" : "bg-body-tertiary text-body-secondary")">
                        @Html.Icon(enabled ? "paper-plane" : "pause", marginEnd: false)
                    </div>
                    <div class="flex-grow-1">
                        <div class="fw-semibold digest-status">
                            @Html.LocalizedText("ADMIN_DIGEST", enabled ? "STATUS_ON" : "STATUS_OFF")
                        </div>
                        @if (!enabled)
                        {
                            <a asp-page="@ForumPages.Admin_Settings.GetPageName()" class="small">
                                @Html.LocalizedText("ADMIN_DIGEST", "TURN_ON")
                            </a>
                        }
                        <dl class="row small mb-0 mt-2">
                            <dt class="col-sm-5 fw-normal text-body-secondary">
                                @Html.LocalizedText("ADMIN_DIGEST", "DIGEST_LAST")
                            </dt>
                            <dd class="col-sm-7 mb-0" id="LastSend">
                                @if (Model.LastSendDate.HasValue)
                                {
                                    @Html.DisplayDateTime(DateTimeFormat.Both, Model.LastSendDate.Value)
                                }
                                else
                                {
                                    @Html.LocalizedText("ADMIN_DIGEST", "DIGEST_NEVER")
                                }
                            </dd>
                        </dl>
                    </div>
                </div>
                @if (enabled)
                {
                    <div class="card-footer d-flex justify-content-end">
                        <button asp-page-handler="ForceSend"
                                button-style="Primary"
                                button-size="Small"
                                Icon="paper-plane"
                                text-localized-tag="FORCE_SEND"
                                return-confirm-tag="CONFIRM_FORCE"></button>
                    </div>
                }
            </div>
        </div>

        @if (enabled)
        {
            <div class="col-lg-6">
                <div class="card h-100" id="DigestTest">
                    <div class="card-header">
                        @Html.Icon("vial")@Html.LocalizedText("ADMIN_DIGEST", "HEADER3")
                    </div>
                    <div class="card-body">
                        <label class="form-label" info-button="true"
                               asp-for="TextSendEmail"
                               localized-tag="DIGEST_EMAIL" localized-page="ADMIN_DIGEST"></label>
                        <input type="email" asp-for="TextSendEmail" class="form-control" maxlength="100" />
                    </div>
                    <div class="card-footer d-flex justify-content-end">
                        <button asp-page-handler="TestSend"
                                button-style="OutlineSecondary"
                                button-size="Small"
                                Icon="paper-plane"
                                text-localized-tag="SEND_TEST"></button>
                    </div>
                </div>
            </div>
        }
    </div>
</form>
