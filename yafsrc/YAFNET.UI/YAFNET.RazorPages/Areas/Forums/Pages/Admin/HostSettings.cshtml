					       localized-tag="MAX_SEARCH_RESULTS"></label>
					<input type="number" class="form-control" asp-for="Input.ReturnSearchMax"/>
				</div>
				<div class="mb-3 col-md-6">
					<label asp-for="Input.SearchStringMinLength" class="form-label" info-button="true"
					       localized-tag="SEARCH_MINLENGTH"></label>
					<input type="number" class="form-control" asp-for="Input.SearchStringMinLength"/>
				</div>
			</div>
			<div class="mb-3">
				<label asp-for="Input.SearchPermissions" class="form-label" info-button="true"
				       localized-tag="SEARCH_PERMISS"></label>
				<select class="form-select" asp-for="Input.SearchPermissions" asp-items="Model.SearchPermissionsList" title="@Model.GetText("SEARCH_PERMISS")">
				</select>
			</div>
			<div class="mb-3">
				<label asp-for="Input.ShowQuickSearch" class="form-label" info-button="true"
				       localized-tag="QUICK_SEARCH"></label>
				<div class="form-check form-switch">
					<input type="checkbox" class="form-check-input" asp-for="Input.ShowQuickSearch"/>
				</div>
			</div>
		</div>
	</div>
	<div class="card mb-3" id="SearchIndex">
		<div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
			<span>@Html.Icon("arrows-rotate")@Html.LocalizedText("ADMIN_HOSTSETTINGS", "INDEX_SEARCH")</span>
			@if (Model.SearchIndexPending)
			{
				<span class="badge text-bg-info search-index-pending">@Html.LocalizedText("ADMIN_HOSTSETTINGS", "SEARCH_INDEX_PENDING")</span>
			}
		</div>
		<div class="card-body">
			<p class="card-text text-body-secondary mb-0">@Html.LocalizedText("ADMIN_HOSTSETTINGS", "INDEX_SEARCH_HELP")</p>
		</div>
		<div class="card-footer d-flex justify-content-end">
			<button text-localized-tag="INDEX_SEARCH"
			        Icon="arrows-rotate"
			        button-style="OutlineSecondary"
			        button-size="Small"
			        return-confirm-tag="CONFIRM_INDEX_SEARCH"
			        asp-page-handler="IndexSearch"></button>
		</div>
	</div>
</div>
<div class="tab-pane fade" id="Log" role="tabpanel">
	<div class="card mb-3">
		<div class="card-header">
			@Html.Icon("book")@Html.LocalizedText("ADMIN_HOSTSETTINGS", "HEADER_LOG")
		</div>
		<div class="card-body">
			<div class="row">
				<div class="mb-3 col-md-6">
					<label asp-for="Input.EventLogMaxMessages" class="form-label" info-button="true"
					       localized-tag="EVENTLOG_MAX_MESSAGES"></label>
					<input type="number" class="form-control" asp-for="Input.EventLogMaxMessages"/>
				</div>
				<div class="mb-3 col-md-6">
					<label asp-for="Input.EventLogMaxDays" class="form-label" info-button="true"
					       localized-tag="EVENTLOG_MAX_DAYS"></label>
					<input type="number" class="form-control" asp-for="Input.EventLogMaxDays"/>
				</div>
				<div class="mb-3 col-md-6">
					<label asp-for="Input.MessageHistoryDaysToLog" class="form-label" info-button="true"
					       localized-tag="MESSAGE_CHANGE_HISTORY"></label>
					<input type="number" class="form-control" asp-for="Input.MessageHistoryDaysToLog"/>
				</div>
			</div>
			<h3 class="h6 border-top pt-3 mb-3">
				@Html.LocalizedText("ADMIN_HOSTSETTINGS", "HEADER_LOGSCOPE")
			</h3>
			<div class="row">
				<div class="mb-3 col-md-6">
									<label asp-for="Input.LogError" class="form-label" info-button="true"
					       localized-tag="LOG_ERROR"></label>
					<div class="form-check form-switch">
						<input type="checkbox" class="form-check-input" asp-for="Input.LogError"/>
					</div>
				</div>
				<div class="mb-3 col-md-6">
					<label asp-for="Input.LogWarning" class="form-label" info-button="true"
					       localized-tag="LOG_WARNING"></label>
					<div class="form-check form-switch">
						<input type="checkbox" class="form-check-input" asp-for="Input.LogWarning"/>
					</div>
				</div>
				<div class="mb-3 col-md-6">
					<label asp-for="Input.LogInformation" class="form-label" info-button="true"
					       localized-tag="LOG_INFORMATION"></label>
					<div class="form-check form-switch">
						<input type="checkbox" class="form-check-input" asp-for="Input.LogInformation"/>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="mb-3 col-md-6">
					<label asp-for="Input.LogBannedIP" class="form-label" info-button="true"
					       localized-tag="LOG_BANNEDIP"></label>
					<div class="form-check form-switch">
						<input type="checkbox" class="form-check-input" asp-for="Input.LogBannedIP"/>
					</div>
				</div>
				<div class="mb-3 col-md-6">
					<label asp-for="Input.LogUserDeleted" class="form-label" info-button="true"
					       localized-tag="LOG_USERDELETED"></label>
					<div class="form-check form-switch">
						<input type="checkbox" class="form-check-input" asp-for="Input.LogUserDeleted"/>
					</div>
				</div>
				<div class="mb-3 col-md-6">
					<label asp-for="Input.LogUserSuspendedUnsuspended" class="form-label" info-button="true"
					       localized-tag="LOG_SUSPENDEDANDCONTRA"></label>
					<div class="form-check form-switch">
						<input type="checkbox" class="form-check-input" asp-for="Input.LogUserSuspendedUnsuspended"/>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
</div>
		</div>
	</div>

	<input type="hidden" asp-for="Input.LastTabId" Value="@Model.Input.LastTabId"/>

</form>

@section Scripts {
    <script src="~/js/admin-edit-form.min.js" asp-append-version="true"></script>
    <script>
		@Html.Raw(JsAndCssHelper.CompressJavaScript(JavaScriptBlocks.BootstrapTabsLoadJs("v-pills-tab", "Input_LastTabId")));
	</script>
}