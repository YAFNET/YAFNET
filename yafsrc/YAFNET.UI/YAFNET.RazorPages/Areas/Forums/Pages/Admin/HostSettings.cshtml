@page "{tab=Setup}/{handler?}"
@using YAF.Core.Helpers
@using YAF.Core.Utilities
@using YAF.Types.Interfaces
@using YAF.Web.HtmlHelpers

@model HostSettingsModel

<form method="post" class="admin-edit-form admin-host-settings">

	<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
		<h2 class="h4 mb-0">
			@Html.Icon("cogs")@Html.LocalizedText("ADMIN_HOSTSETTINGS", "TITLE")
		</h2>
	</div>

	<div class="row g-3">
		<div class="col-md-auto">
			<select class="form-select d-md-none host-section-select" data-tab-select="#v-pills-tab"
			        aria-label="@Html.LocalizedText("ADMIN_HOSTSETTINGS", "SECTIONS")">
				<option value="#ServerInfo">@Html.LocalizedText("ADMIN_HOSTSETTINGS", "HEADER_SERVER_INFO")</option>
				<option value="#Setup">@Html.LocalizedText("ADMIN_HOSTSETTINGS", "HEADER_SETUP")</option>
				<option value="#Features">@Html.LocalizedText("ADMIN_HOSTSETTINGS", "HOST_FEATURES")</option>
				<option value="#Display">@Html.LocalizedText("ADMIN_HOSTSETTINGS", "HOST_DISPLAY")</option>
				<option value="#Adverts">@Html.LocalizedText("ADMIN_HOSTSETTINGS", "HOST_ADVERTS")</option>
				<option value="#Permission">@Html.LocalizedText("ADMIN_HOSTSETTINGS", "HOST_PERMISSION")</option>
				<option value="#Avatars">@Html.LocalizedText("ADMIN_HOSTSETTINGS", "HOST_AVATARS")</option>
				<option value="#Cache">@Html.LocalizedText("ADMIN_HOSTSETTINGS", "HOST_CACHE")</option>
				<option value="#Search">@Html.LocalizedText("ADMIN_HOSTSETTINGS", "HOST_SEARCH")</option>
				<option value="#Log">@Html.LocalizedText("ADMIN_HOSTSETTINGS", "HOST_LOG")</option>
			</select>
			<div class="card host-settings-nav d-none d-md-block">
				<div class="nav nav-pills flex-column p-2" id="v-pills-tab" role="tablist" data-tab-input="#Input_LastTabId">
					<button data-bs-target="#ServerInfo" data-tab="ServerInfo" class="nav-link" data-bs-toggle="pill" role="tab" icon="server"
					        text-localized-page="ADMIN_HOSTSETTINGS" text-localized-tag="HEADER_SERVER_INFO"
							title-localized-page="ADMIN_HOSTSETTINGS" title-localized-tag="HEADER_SERVER_INFO">
					</button>
					<button data-bs-target="#Setup" data-tab="Setup" class="nav-link" data-bs-toggle="pill" role="tab" icon="gears"
					        text-localized-page="ADMIN_HOSTSETTINGS" text-localized-tag="HEADER_SETUP"
							title-localized-page="ADMIN_HOSTSETTINGS" title-localized-tag="HEADER_SETUP">
					</button>
					<button data-bs-target="#Features" data-tab="Features" class="nav-link" data-bs-toggle="pill" role="tab" icon="wand-sparkles"
					        text-localized-page="ADMIN_HOSTSETTINGS" text-localized-tag="HOST_FEATURES"
							title-localized-page="ADMIN_HOSTSETTINGS" title-localized-tag="HOST_FEATURES">
					</button>
					<button data-bs-target="#Display" data-tab="Display" class="nav-link" data-bs-toggle="pill" role="tab" icon="display"
					        text-localized-page="ADMIN_HOSTSETTINGS" text-localized-tag="HOST_DISPLAY"
							title-localized-page="ADMIN_HOSTSETTINGS" title-localized-tag="HOST_DISPLAY">
					</button>
					<button data-bs-target="#Adverts" data-tab="Adverts" class="nav-link" data-bs-toggle="pill" role="tab" icon="rectangle-ad"
					        text-localized-page="ADMIN_HOSTSETTINGS" text-localized-tag="HOST_ADVERTS"
							title-localized-page="ADMIN_HOSTSETTINGS" title-localized-tag="HOST_ADVERTS">
					</button>
					<button data-bs-target="#Permission" data-tab="Permission" class="nav-link" data-bs-toggle="pill" role="tab" icon="user-lock"
					        text-localized-page="ADMIN_HOSTSETTINGS" text-localized-tag="HOST_PERMISSION"
							title-localized-page="ADMIN_HOSTSETTINGS" title-localized-tag="HOST_PERMISSION">
					</button>
					<button data-bs-target="#Avatars" data-tab="Avatars" class="nav-link" data-bs-toggle="pill" role="tab" icon="user-tie"
					        text-localized-page="ADMIN_HOSTSETTINGS" text-localized-tag="HOST_AVATARS"
							title-localized-page="ADMIN_HOSTSETTINGS" title-localized-tag="HOST_AVATARS">
					</button>
					<button data-bs-target="#Cache" data-tab="Cache" class="nav-link" data-bs-toggle="pill" role="tab" icon="memory"
					        text-localized-page="ADMIN_HOSTSETTINGS" text-localized-tag="HOST_CACHE"
							title-localized-page="ADMIN_HOSTSETTINGS" title-localized-tag="HOST_CACHE">
					</button>
					<button data-bs-target="#Search" data-tab="Search" class="nav-link" data-bs-toggle="pill" role="tab" icon="magnifying-glass"
					        text-localized-page="ADMIN_HOSTSETTINGS" text-localized-tag="HOST_SEARCH"
							title-localized-page="ADMIN_HOSTSETTINGS" title-localized-tag="HOST_SEARCH">
					</button>
					<button data-bs-target="#Log" data-tab="Log" class="nav-link" data-bs-toggle="pill" role="tab" icon="book"
					        text-localized-page="ADMIN_HOSTSETTINGS" text-localized-tag="HOST_LOG"
							title-localized-page="ADMIN_HOSTSETTINGS" title-localized-tag="HOST_LOG">
					</button>
				</div>
			</div>
		</div>
		<div class="col host-settings-main">
			@* the save bar is the first submit button of the form (Enter in a field saves), it is shown at the bottom *@
			<div class="admin-edit-actions host-settings-actions">
				<button button-style="Primary" asp-page-handler="Save"
				        Icon="save" text-localized-tag="SAVE_SETTINGS" text-localized-page="ADMIN_HOSTSETTINGS">
				</button>
			</div>
<div id="HostSettingsTabs" class="tab-content">

<div class="tab-pane fade" id="ServerInfo" role="tabpanel">
	<div class="card mb-3">
		<div class="card-header">
			@Html.Icon("server")@Html.LocalizedText("ADMIN_HOSTSETTINGS", "HEADER_SERVER_INFO")
		</div>
		<div class="card-body">
			<div class="mb-3">
				<label class="form-label" info-button="true"
				       asp-for="Input.SQLVersion"
				       localized-tag="SERVER_VERSION"></label>
				<textarea asp-for="Input.SQLVersion" class="form-control"
                                 rows="5" disabled="disabled"></textarea>
			</div>
			<div class="mb-3">
				<label class="form-label" info-button="true"
				       asp-for="Input.AppOsName"
				       localized-tag="APP_OS_NAME"></label>
				<input type="text" asp-for="Input.AppOsName"
				       class="form-control" disabled="disabled" />
			</div>
			<div class="mb-3">
				<label class="form-label" info-button="true"
				       asp-for="Input.AppRuntime"
				       localized-tag="APP_RUNTIME"></label>
				<input type="text" asp-for="Input.AppRuntime"
				       class="form-control" disabled="disabled" />
			</div>
			<div class="mb-3">
				<label class="form-label" info-button="true"
				       asp-for="Input.AppCores"
				       localized-tag="APP_CORES"></label>
				<input type="text" asp-for="Input.AppCores"
				       class="form-control" disabled="disabled" />
			</div>
			<div class="mb-3">
				<label class="form-label" info-button="true"
				       asp-for="Input.AppMemory"
				       localized-tag="APP_MEMORY"></label>
				<input type="text" asp-for="Input.AppMemory"
				       class="form-control" disabled="disabled" />
			</div>
			<div class="mb-3">
				<label class="form-label" info-button="true"
				       asp-for="Input.DatabaseBackup"
				       localized-tag="DATABASE_BACKUP"></label>
				<textarea asp-for="Input.DatabaseBackup" class="form-control"
				          rows="2" disabled="disabled"></textarea>
			</div>
		</div>
	</div>
</div>
