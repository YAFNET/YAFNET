@page "{p:int=1}/{handler?}"
@model AttachmentsModel
@using YAF.Types.Interfaces
@using YAF.Types.Constants
@using YAF.Types.Extensions
@using YAF.Types.Interfaces.Services
@using YAF.Types.Objects
@using YAF.Web.HtmlHelpers

<form method="post" class="admin-attachments">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h2 class="h4 mb-0">
            @Html.Icon("paperclip")@Html.LocalizedText("ADMIN_ATTACHMENTS", "TITLE")
            <span class="badge text-bg-secondary align-middle ms-1">@Model.Count</span>
        </h2>
        <div class="input-group input-group-sm w-auto" role="group">
            <div class="input-group-text">
                @Html.LocalizedText("SHOW"):
            </div>
            <select asp-for="@Model.Size"
                    asp-items="Model.PageSizeList"
                    title="@Html.LocalizedText("COMMON", "SHOW_TITLE")"
                    aria-label="@Html.LocalizedText("COMMON", "SHOW_TITLE")"
                    class="form-select"
                    onchange="this.form.submit();"></select>
        </div>
    </div>

    @if (!Model.List.NullOrEmpty())
    {
        <ul class="list-group mb-3">
            @foreach (var (user, attachment) in Model.List)
            {
                // the posts that show the attachment
                var posts = Model.Usages.GetValueOrDefault(attachment.ID) ?? [];
                var usages = posts.Count;

                <li class="list-group-item list-group-item-menu attachment-row">
                    <div class="attachment-preview">@Html.Raw(Model.GetPreviewImage(attachment))</div>
                    <div class="attachment-main">
                        <div class="attachment-name text-break">@attachment.FileName</div>
                        <div class="attachment-meta small text-body-secondary">
                            <span>@Html.Icon("user")@Html.UserLink(user)</span>
                            <span title="@Html.LocalizedText("ATTACHMENTS", "SIZE")">@Html.Icon("weight-hanging")@AttachmentsModel.FormatSize(attachment.Bytes)</span>
                            <span title="@Html.LocalizedText("ADMIN_ATTACHMENTS", "DOWNLOADS")">@Html.Icon("download")@attachment.Downloads</span>
                            <span class="badge @(usages > 0 ? "text-bg-secondary" : "bg-body-tertiary text-body-secondary border")"
                                  title="@Html.LocalizedText("ADMIN_ATTACHMENTS", "USAGES")">@Html.Icon("link")@usages</span>
                        </div>
                    </div>
                    <div class="btn-group btn-group-sm attachment-actions">
                        @if (posts.Count == 1)
                        {
                            <a href="@Model.GetPostLink(posts[0].MessageId, posts[0].TopicName)"
                               class="btn btn-sm btn-outline-secondary attachment-posts"
                               title="@posts[0].TopicName">
                                @Html.Icon("comment")@Html.LocalizedText("ADMIN_ATTACHMENTS", "SHOW_POSTS")
                            </a>
                        }
                        else if (posts.Count > 1)
                        {
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle attachment-posts"
                                        data-bs-toggle="dropdown" aria-expanded="false">
                                    @Html.Icon("comments")@Html.LocalizedText("ADMIN_ATTACHMENTS", "SHOW_POSTS")
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    @foreach (var post in posts)
                                    {
                                        <li>
                                            <a class="dropdown-item text-break" href="@Model.GetPostLink(post.MessageId, post.TopicName)">
                                                @Html.Icon("comment")@post.TopicName
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                        <button button-style="Danger"
                                button-size="Small"
                                asp-page-handler="Delete"
                                asp-route-id="@attachment.ID"
                                return-confirm-tag="CONFIRM_DELETE"
                                title-localized-tag="DELETE"
                                Icon="trash"
                                text-localized-tag="DELETE"></button>
                    </div>
                    <div class="dropdown-menu context-menu" aria-labelledby="context menu">
                        @foreach (var post in posts)
                        {
                            <a class="dropdown-item text-break" href="@Model.GetPostLink(post.MessageId, post.TopicName)">
                                @Html.Icon("comment")@post.TopicName
                            </a>
                        }
                        @if (posts.Count > 0)
                        {
                            <div class="dropdown-divider"></div>
                        }
                        <button class="dropdown-item"
                                button-style="None"
                                asp-page-handler="Delete"
                                asp-route-id="@attachment.ID"
                                return-confirm-tag="CONFIRM_DELETE"
                                Icon="trash"
                                text-localized-tag="DELETE"></button>
                    </div>
                </li>
            }
        </ul>

        @await Html.PartialAsync("_Pagination", new Pagination { TotalRows = Model.Count, Size = Model.Size })
    }
    else
    {
        <div class="card mb-3">
            <div class="card-body">
                <empty icon="paperclip"
                       header-text-page="ADMIN_ATTACHMENTS" header-text-tag="EMPTY_HEADER"
                       message-text-page="ADMIN_ATTACHMENTS" message-text-tag="EMPTY_MESSAGE">
                </empty>
            </div>
        </div>
    }
</form>

@section Scripts {
    @await Html.PartialAsync("_PostScriptsPartial")
}
