@page "{handler?}"

@using System.Globalization
@using YAF.Core.Helpers
@using YAF.Core.Utilities
@using YAF.Types.Interfaces
@using YAF.Types.Interfaces.Services
@using YAF.Types.Extensions
@using YAF.Types.Objects.Model
@using YAF.Web.HtmlHelpers
@model MessageHistoryModel

<form method="post" class="post-action-page">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h2 class="h4 mb-0">
            @Html.Icon("history")@Html.LocalizedText("MESSAGEHISTORY", "TITLE")
            <span class="badge text-bg-secondary align-middle ms-1" id="VersionCount">@(Model.RevisionsList?.Count ?? 0)</span>
        </h2>
        <div class="d-flex flex-wrap gap-2">
            <button type="submit"
                    asp-page-handler="Return"
                    asp-route-f="@Request.Query["f"]"
                    asp-route-m="@Request.Query["m"]"
                    text-localized-tag="TOMESSAGE"
                    button-style="OutlineSecondary"
                    icon="external-link-square-alt">
            </button>
            @if (Request.Query.ContainsKey("f"))
            {
                <button type="submit"
                        asp-page-handler="ReturnForum"
                        asp-route-f="@Request.Query["f"]"
                        asp-route-m="@Request.Query["m"]"
                        text-localized-tag="GOMODERATE"
                        button-style="OutlineSecondary"
                        icon="tasks">
                </button>
            }
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
            <span>@Html.Icon("list")@Html.LocalizedText("MESSAGEHISTORY", "SELECT_INFO")</span>
            <button type="submit"
                    text-localized-tag="COMPARE_VERSIONS"
                    icon="equals"
                    asp-page-handler="ShowDiff"
                    asp-route-f="@Request.Query["f"]"
                    asp-route-m="@Request.Query["m"]"
                    button-style="Primary"
                    button-size="Small"
                    id="CompareVersions">
            </button>
        </div>
        @if (!Model.RevisionsList.NullOrEmpty())
        {
            <ul class="list-group list-group-flush">
                @for (var i = 0; i < Model.RevisionsList.Count; i++)
                {
                    var message = Model.RevisionsList[i];
                    var isCurrent = i.Equals(Model.RevisionsList.Count - 1);

                    <li class="list-group-item history-version @(message.Selected ? "is-selected" : string.Empty)">
                        <div class="form-check mt-1">
                            <input asp-for="@Model.RevisionsList[i].Selected" class="form-check-input" onclick="toggleSelection(this);" />
                            <label class="form-check-label visually-hidden" asp-for="@Model.RevisionsList[i].Selected">@Model.GetEditReason(message)</label>
                        </div>
                        <div class="history-version-main">
                            <div class="fw-semibold text-break">
                                @Model.GetEditReason(message)
                                @if (isCurrent)
                                {
                                    <span class="badge text-bg-primary ms-1">@Html.LocalizedText("MESSAGEHISTORY", "CURRENTMESSAGE")</span>
                                }
                                @if (message.IsModeratorChanged == true)
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle ms-1">@Html.LocalizedText("POSTMESSAGE", "EDITEDBY_MOD")</span>
                                }
                            </div>
                            <div class="history-version-meta">
                                <span>@Html.Icon("clock")@Html.Raw(Model.Get<IDateTimeService>().FormatDateTimeTopic(message.Edited))</span>
                                <span>
                                    @Html.Icon("user")@Html.UserLink(message.EditedBy,
                                        Model.PageBoardContext.BoardSettings.EnableDisplayName ? message.DisplayName : message.Name,
                                        message.Suspended,
                                        message.UserStyle)
                                </span>
                                @if (Model.PageBoardContext.IsAdmin || Model.PageBoardContext.BoardSettings.AllowModeratorsViewIPs && Model.PageBoardContext.ForumModeratorAccess)
                                {
                                    <span>
                                        @Html.Icon("network-wired")<a href="@(string.Format(Model.PageBoardContext.BoardSettings.IPInfoPageURL, Model.GetIpAddress(message)))"
                                           title="@(Model.GetText("COMMON", "TT_IPDETAILS"))"
                                           target="_blank" rel="noopener">@(Model.GetIpAddress(message))</a>
                                    </span>
                                }
                            </div>
                        </div>
                        @if ((Model.PageBoardContext.IsAdmin || Model.PageBoardContext.ForumModeratorAccess) && !isCurrent)
                        {
                            <button type="submit"
                                    asp-page-handler="Restore"
                                    asp-route-f="@Request.Query["f"]"
                                    asp-route-m="@Request.Query["m"]"
                                    asp-route-edited="@message.Edited.ToString("yyyy-MM-dd HH:mm:ss.fff", CultureInfo.InvariantCulture)"
                                    title-localized-tag="RESTORE_MESSAGE"
                                    text-localized-tag="RESTORE_MESSAGE"
                                    return-confirm-tag="CONFIRM_RESTORE"
                                    button-style="OutlineSecondary"
                                    button-size="Small"
                                    icon="undo">
                            </button>
                        }
                    </li>
                }
            </ul>
        }
    </div>

    @if (Model.DiffText.IsSet())
    {
        <div class="card mb-3">
            <div class="card-header">
                @Html.Icon("equals")@Html.LocalizedText("MESSAGEHISTORY", "TEXT_CHANGES")
            </div>
            <div class="card-body" id="diffContent">
                @Html.Raw(Model.DiffText)
            </div>
        </div>
    }
</form>

@section Scripts {
    <script>
        @Html.Raw(JsAndCssHelper.CompressJavaScript(JavaScriptBlocks.ToggleDiffSelectionJs(Model.GetText("SELECT_TWO"))))
    </script>
}
