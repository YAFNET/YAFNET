@page "{handler?}"
@using YAF.Web.HtmlHelpers
@using YAF.Types.Extensions

@model NotificationModel

<form method="post">
    <div class="row">
        <div class="col-12 col-lg-auto mb-3 mb-lg-0">
            <profileMenu></profileMenu>
        </div>
        <div class="col notifications">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <h2 class="h4 mb-0">
                    @Html.Icon("bell")@Html.LocalizedText("ACCOUNT", "YOUR_NOTIFIY")
                    <span class="badge @(Model.UnreadCount > 0 ? "text-bg-danger" : "text-bg-secondary") align-middle ms-1"
                          id="UnreadCount"
                          title="@Model.GetText("NOTIFICATION", "UNREAD")">@Model.UnreadCount</span>
                </h2>
                @if (Model.UnreadCount > 0)
                {
                    <button asp-page-handler="MarkAll"
                            text-localized-tag="MARK_ALL_ASREAD" text-localized-page="DEFAULT"
                            button-style="OutlineSecondary"
                            button-size="Small"
                            Icon="glasses"></button>
                }
            </div>
            <div class="row">
                <div class="col">
                    <div class="card mb-3" id="activity">
                        <div class="card-body border-bottom py-2" id="notificationFilters">
	                        <div class="d-flex flex-wrap align-items-center gap-2">
		                        <span class="text-muted">@Html.LocalizedText("FILTER_DROPDOWN"):</span>
                                <div class="d-flex flex-wrap gap-2" role="group" aria-label="Filters">
                                    <input asp-for="WasMentioned" class="btn-check" autocomplete="off" />
                                    <label asp-for="WasMentioned" class="btn btn-sm btn-outline-secondary rounded-pill filter-chip">
                                        @Html.Icon("at")@Html.LocalizedText("NOTIFICATION", "WAS_MENTIONED")
                                    </label>
                                    <input asp-for="ReceivedThanks" class="btn-check" autocomplete="off" />
                                    <label asp-for="ReceivedThanks" class="btn btn-sm btn-outline-secondary rounded-pill filter-chip">
                                        @Html.Icon("heart")@Html.LocalizedText("NOTIFICATION", "RECEIVED_THANKS")
                                    </label>
                                    <input asp-for="WasQuoted" class="btn-check" autocomplete="off" />
                                    <label asp-for="WasQuoted" class="btn btn-sm btn-outline-secondary rounded-pill filter-chip">
                                        @Html.Icon("quote-left")@Html.LocalizedText("NOTIFICATION", "WAS_QUOTED")
                                    </label>
                                    <input asp-for="WatchForumReply" class="btn-check" autocomplete="off" />
                                    <label asp-for="WatchForumReply" class="btn btn-sm btn-outline-secondary rounded-pill filter-chip">
                                        @Html.Icon("comments")@Html.LocalizedText("NOTIFICATION", "WATCH_FORUM_REPLY")
                                    </label>
                                    <input asp-for="WatchTopicReply" class="btn-check" autocomplete="off" />
                                    <label asp-for="WatchTopicReply" class="btn btn-sm btn-outline-secondary rounded-pill filter-chip">
                                        @Html.Icon("comment")@Html.LocalizedText("NOTIFICATION", "WATCH_TOPIC_REPLY")
                                    </label>
                                    <input asp-for="BecomeFriends" class="btn-check" autocomplete="off" />
                                    <label asp-for="BecomeFriends" class="btn btn-sm btn-outline-secondary rounded-pill filter-chip">
                                        @Html.Icon("user-group")@Html.LocalizedText("ACCOUNT", "BECOME_FRIENDS")
                                    </label>
                                    @if (Model.PageBoardContext.BoardSettings.EnableAchievements)
                                    {
                                        <input asp-for="UnlockedAchievement" class="btn-check" autocomplete="off" />
                                        <label asp-for="UnlockedAchievement" class="btn btn-sm btn-outline-secondary rounded-pill filter-chip">
                                            @Html.Icon("trophy")@Html.LocalizedText("ACHIEVEMENTS", "ACHIEVEMENTS")
                                        </label>
                                    }
                                </div>
                                <button type="submit"
                                        asp-page-handler="Reset"
                                        text-localized-page="NOTIFICATION"
                                        text-localized-tag="SHOW_ALL"
                                        button-style="Link"
                                        button-size="Small"
                                        Icon="eye">
                                </button>
                            </div>
                        </div>
                        <ul class="list-group list-group-flush @(Model.Notifications.NullOrEmpty() ? "d-none" : string.Empty)"
                            id="notificationsContainer"
                            data-load-more-url="@Url.Page("Notification", "LoadMoreNotifications")"
                            data-page-size="@Model.Size"
                            data-loaded-count="@Model.Notifications.Count">
                            @if (!Model.Notifications.NullOrEmpty())
                            {
                                @await Html.PartialAsync("_NotificationListItems", Model.Notifications)
                            }
                            <li id="notificationsLoadMoreSentinel" class="list-group-item border-0 text-center py-3 d-none">
                                <div class="spinner-border spinner-border-sm text-secondary d-none" role="status">
                                    <span class="visually-hidden">@Html.LocalizedText("COMMON", "LOADING")</span>
                                </div>
                            </li>
                        </ul>
                        <div class="card-body text-center @(Model.Notifications.NullOrEmpty() ? string.Empty : "d-none")" id="notificationsEmpty">
                            <empty icon="bell"
                                   header-text-page="NOTIFICATION" header-text-tag="EMPTY_HEADER"
                                   message-text-page="NOTIFICATION" message-text-tag="EMPTY_MESSAGE">
                            </empty>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/notification.min.js" asp-append-version="true" defer></script>
}
