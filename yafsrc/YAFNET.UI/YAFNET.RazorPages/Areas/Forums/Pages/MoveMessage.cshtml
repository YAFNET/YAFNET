@page "{m:int}/{handler?}"
@using YAF.Core.Helpers
@using YAF.Core.Utilities
@using YAF.Types.Constants
@using YAF.Types.Interfaces
@using YAF.Web.HtmlHelpers
@model MoveMessageModel

<form method="post" class="post-action-page">
    @* Enter in the name of the new topic creates the topic (the first submit button of the form, it was "move") *@
    <button type="submit" asp-page-handler="CreateAndMove" asp-route-m="@Model.PageBoardContext.PageMessage.ID" class="visually-hidden" tabindex="-1" aria-hidden="true"></button>

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h2 class="h4 mb-0">@Html.Icon("arrows-alt")@Html.LocalizedText("MOVEMESSAGE", "MOVE_MESSAGE")</h2>
    </div>

    <div class="card mb-3 post-action-preview">
        <div class="card-header">
            <div class="fw-semibold text-break">@Model.PageBoardContext.PageTopic.TopicName</div>
            <div class="post-action-meta">
                @if (Model.MessageAuthor is not null)
                {
                    <span>@Html.Icon("user")@Html.UserLink(Model.MessageAuthor)</span>
                }
                <span>@Html.Icon("clock")@Html.DisplayDateTime(DateTimeFormat.Both, Model.PageBoardContext.PageMessage.Posted)</span>
            </div>
        </div>
        <div class="card-body post-action-body">
            <messagePostData show-attachments="false" show-signature="false" current-message="@Model.PageBoardContext.PageMessage"></messagePostData>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <label for="ForumList" class="form-label" localized-tag="select_forum_moveto"></label>
            <select id="ForumList" name="forumList"></select>
            <input type="hidden" asp-for="Input.ForumListSelected" Value="@Model.Input.ForumListSelected" />
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="card move-way" id="MoveToTopic">
                <div class="card-header">
                    @Html.Icon("arrows-alt")@Html.LocalizedText("MOVEMESSAGE", "MOVE_TITLE")
                </div>
                <div class="card-body">
                    <label for="TopicList" class="form-label" localized-tag="select_topic_moveto"></label>
                    <select id="TopicList"></select>
                    <input type="hidden" asp-for="Input.TopicListSelected" Value="@Model.Input.TopicListSelected" />
                    <div class="move-way-action d-grid">
                        <button type="submit"
                                asp-page-handler="Move"
                                asp-route-m="@Model.PageBoardContext.PageMessage.ID"
                                button-style="Primary"
                                text-localized-tag="MOVE_MESSAGE"
                                title-localized-tag="MOVE_TITLE"
                                icon="arrows-alt"></button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card move-way" id="SplitToTopic">
                <div class="card-header">
                    @Html.Icon("cut")@Html.LocalizedText("MOVEMESSAGE", "SPLIT_TITLE")
                </div>
                <div class="card-body">
                    <label asp-for="Input.TopicSubject" class="form-label" localized-tag="new_topic"></label>
                    <input type="text" asp-for="Input.TopicSubject" maxlength="100" class="form-control" />
                    <div class="move-way-action d-grid">
                        <button type="submit"
                                asp-page-handler="CreateAndMove"
                                asp-route-m="@Model.PageBoardContext.PageMessage.ID"
                                text-localized-tag="CREATE_TOPIC"
                                title-localized-tag="SPLIT_TITLE"
                                button-style="Primary"
                                Icon="cut"></button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="post-action-bar">
        <a role="button"
           href="@Html.Raw(Model.Get<ILinkBuilder>().GetMessageLink(Model.PageBoardContext.PageTopic, Model.PageBoardContext.PageMessage.ID))"
           button-style="Secondary"
           icon="reply"
           text-localized-page="COMMON"
           text-localized-tag="CANCEL"></a>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ChoicesScriptsPartial")
    <script>
        @Html.Raw(JsAndCssHelper.CompressJavaScript(JavaScriptBlocks.SelectForumsLoadJs(
            "ForumList",
            Model.GetText("select_forum_moveto"),
            false,
            false,
            "Input_ForumListSelected",
            JavaScriptBlocks.LoadTopicsByForumJs())))

        @Html.Raw(JsAndCssHelper.CompressJavaScript(JavaScriptBlocks.SelectTopicsLoadJs(
            "TopicList",
            "Input_TopicListSelected",
            "Input_ForumListSelected",
            Model.GetText("select_topic_moveto"))))
    </script>
}
