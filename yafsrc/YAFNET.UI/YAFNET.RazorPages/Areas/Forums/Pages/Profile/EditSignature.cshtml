@page "{handler?}"
@using YAF.Web.HtmlHelpers
@using YAF.Types.Constants
@using YAF.Types.Extensions

@model YAF.Pages.Profile.EditSignatureModel

<div class="row">
    <div class="col-12 col-lg-auto mb-3 mb-lg-0">
        <profileMenu></profileMenu>
    </div>
    <div class="col profile-page">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
            <h2 class="h4 mb-0">@Html.Icon("signature")@Html.LocalizedText("EDIT_SIGNATURE", "TITLE")</h2>
        </div>

        <form method="post">
            @* Enter (in the editor a new line) never previews: the first submit button saves *@
            <button type="submit" asp-page-handler="Save" class="visually-hidden" tabindex="-1" aria-hidden="true"></button>

            <div class="card mb-3">
                <div class="card-header">
                    @Html.Icon("pen")@Html.LocalizedText("EDIT_SIGNATURE", "TITLE")
                </div>
                <div class="card-body">
                    <textarea asp-for="Signature"
                              class="form-control"
                              rows="10"
                              cols="100"
                              title="editor"
                              editor-mode="Basic"
                              users-can-upload="false"
                              maxlength="@Model.AllowedNumberOfCharacters"
                              max-characters="@Model.AllowedNumberOfCharacters"></textarea>
                    <div class="form-text" id="SignatureRules">
                        @Html.Icon("info-circle")@Model.GetTextFormatted(
                            "SIGNATURE_RULES",
                            Model.AllowedNumberOfCharacters,
                            Model.AllowedBbcodes.IsSet() ? Model.AllowedBbcodes.Replace(",", ", ") : Model.GetText("COMMON", "NONE"))
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    @Html.Icon("eye")@Html.LocalizedText("EDIT_SIGNATURE", "SIGNATURE_PREVIEW")
                </div>
                <div class="card-body signature-preview">
                    <signature display-user-id="@Model.PageBoardContext.PageUserID"
                               signature="@Model.Signature"></signature>
                </div>
            </div>

            <div class="profile-edit-actions">
                <a role="button"
                   asp-page="@ForumPages.MyAccount.GetPageName()"
                   button-style="Secondary"
                   icon="reply"
                   text-localized-page="COMMON"
                   text-localized-tag="CANCEL"></a>
                <div class="d-flex flex-wrap gap-2">
                    <button type="submit"
                            asp-page-handler="Preview"
                            button-style="OutlineSecondary"
                            icon="eye"
                            text-localized-page="COMMON"
                            text-localized-tag="PREVIEW"></button>
                    <button type="submit"
                            asp-page-handler="Save"
                            button-style="Primary"
                            icon="save"
                            text-localized-page="COMMON"
                            text-localized-tag="SAVE"></button>
                </div>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @await Html.PartialAsync("_EditorScriptsPartial")
}
