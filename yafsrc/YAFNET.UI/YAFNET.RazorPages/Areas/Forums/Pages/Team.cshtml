@page "{handler?}"
@using YAF.Core.Extensions
@using YAF.Core.Model
@using YAF.Web.HtmlHelpers
@using YAF.Types.Constants
@using YAF.Types.Extensions
@using YAF.Types.Interfaces
@using YAF.Types.Interfaces.Services
@using YAF.Types.Objects.Model
@model TeamModel

@{
    // the buttons to contact a member of the team (the same rules as on the profile)
    async Task<(bool Pm, bool Email)> GetContactAsync(int userId, bool blockPms, bool blockEmails)
    {
        if (userId == Model.PageBoardContext.PageUserID || Model.PageBoardContext.IsGuest)
        {
            return (false, false);
        }

        // the user has the current user in the friend list (not just a request)
        var isFriend = await Model.GetRepository<YAF.Types.Models.Buddy>().ExistsAsync(
                           b => b.FromUserID == userId && b.ToUserID == Model.PageBoardContext.PageUserID && b.Approved);

        var pm = Model.PageBoardContext.BoardSettings.AllowPrivateMessages
                 && (!blockPms || Model.PageBoardContext.IsAdmin || isFriend);

        var email = Model.PageBoardContext.BoardSettings.AllowEmailSending
                    && (!blockEmails || Model.PageBoardContext.IsAdmin || isFriend);

        return (pm, email);
    }

    async Task RenderActionsAsync(int userId, string name, bool blockPms, bool blockEmails)
    {
        var contact = await GetContactAsync(userId, blockPms, blockEmails);

        if (!contact.Pm && !contact.Email && !Model.PageBoardContext.IsAdmin)
        {
            return;
        }

        <div class="card-footer bg-transparent d-flex flex-wrap gap-1">
            @if (contact.Pm)
            {
                <a role="button"
                   button-style="OutlineSecondary"
                   button-size="Small"
                   icon="envelope"
                   text-localized-page="POSTS"
                   text-localized-tag="PM"
                   title-localized-page="POSTS"
                   title-localized-tag="PM_TITLE"
                   title-param0="@name"
                   href="@Html.Raw(Model.Get<ILinkBuilder>().GetLink(ForumPages.MyMessages, new { u = userId }))">
                </a>
            }
            @if (contact.Email)
            {
                <a role="button"
                   button-style="OutlineSecondary"
                   button-size="Small"
                   icon="at"
                   text-localized-page="POSTS"
                   text-localized-tag="EMAIL"
                   title-localized-page="POSTS"
                   title-localized-tag="EMAIL_TITLE"
                   title-param0="@name"
                   href="@Html.Raw(Model.Get<ILinkBuilder>().GetLink(ForumPages.Email, new { u = userId }))">
                </a>
            }
            @if (Model.PageBoardContext.IsAdmin)
            {
                <a role="button"
                   button-style="None"
                   class="btn btn-sm btn-outline-danger ms-auto"
                   icon="user-cog"
                   text-localized-page="PROFILE"
                   text-localized-tag="ADMIN_USER"
                   title-localized-page="PROFILE"
                   title-localized-tag="ADMIN_USER"
                   href="@Html.Raw(Model.Get<ILinkBuilder>().GetLink(ForumPages.Admin_EditUser, new { u = userId }))"></a>
            }
        </div>
    }
}

<div class="info-page team-page">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h2 class="h4 mb-0">@Html.Icon("users")@Html.LocalizedText("TEAM", "TITLE")</h2>
    </div>

    <section class="mb-4" id="TeamAdmins">
        <h3 class="h5 mb-3">
            @Html.Icon("user-shield")@Html.LocalizedText("TEAM", "ADMINS")
            <span class="badge text-bg-secondary align-middle ms-1">@Model.Admins.Count</span>
        </h3>
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
            @foreach (var user in Model.Admins)
            {
                <div class="col">
                    <div class="card h-100 team-member">
                        <div class="card-body d-flex gap-3 align-items-center">
                            <img class="team-avatar rounded" alt="" aria-hidden="true"
                                 src="@Html.Raw(Model.Get<IAvatars>().GetAvatarUrlForUser(user))" />
                            <div class="flex-grow-1 min-w-0">
                                <div class="fw-semibold text-break">@Html.UserLink(user)</div>
                                <div class="small text-body-secondary">
                                    @Html.Icon("folder")@Html.LocalizedText("TEAM", "FORUMS_ALL")
                                </div>
                            </div>
                        </div>
                        @{ await RenderActionsAsync(user.ID, user.DisplayOrUserName(), user.Block.BlockPMs, user.Block.BlockEmails); }
                    </div>
                </div>
            }
        </div>
    </section>

    @if (!Model.CompleteMods.NullOrEmpty())
    {
        <section class="mb-4" id="TeamModerators">
            <h3 class="h5 mb-3">
                @Html.Icon("user-secret")@Html.LocalizedText("TEAM", "MODS")
                <span class="badge text-bg-secondary align-middle ms-1">@Model.CompleteMods.Count</span>
            </h3>
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
                @for (var index = 0; index < Model.CompleteMods.Count; index++)
                {
                    var mod = Model.CompleteMods[index];

                    var forums = mod.ForumIDs.Select(forumsItem => forumsItem);

                    var sortedForums = Model.GetRepository<Types.Models.Forum>().SortModeratorList(forums);

                    var modForums = new SelectList(sortedForums, nameof(ForumSorted.ForumID), nameof(ForumSorted.Forum), null, nameof(ForumSorted.Category))
                        .ToList();

                    var placeHolder = Model.Get<ILocalization>().GetTextFormatted("VIEW_FORUMS", forums.Count());

                    modForums.Insert(0, new SelectListItem(placeHolder, null));

                    var modName = Model.PageBoardContext.BoardSettings.EnableDisplayName ? mod.DisplayName : mod.Name;

                    <div class="col">
                        <div class="card h-100 team-member">
                            <div class="card-body">
                                <div class="d-flex gap-3 align-items-center mb-3">
                                    <img class="team-avatar rounded" alt="" aria-hidden="true"
                                         src="@Html.Raw(Model.Get<IAvatars>().GetAvatarUrlForUser(mod.ModeratorID, mod.Avatar, mod.AvatarImage != null))" />
                                    <div class="flex-grow-1 min-w-0">
                                        <div class="fw-semibold text-break">@Html.UserLink(mod.ModeratorID, modName, mod.Suspended, mod.Style)</div>
                                    </div>
                                </div>
                                <form method="post">
                                    <label class="visually-hidden" for="CompleteMods_@(index)__SelectedForumId">@Html.LocalizedText("FORUMS")</label>
                                    <select asp-for="@Model.CompleteMods[index].SelectedForumId" class="select2-image-select" asp-list="@modForums"
                                            icon-item="comments"
                                            onchange="this.form.submit();"
                                            placeholder="@placeHolder">
                                    </select>
                                </form>
                            </div>
                            @{ await RenderActionsAsync(mod.ModeratorID, modName, mod.UserBlockFlags.BlockPMs, mod.UserBlockFlags.BlockEmails); }
                        </div>
                    </div>
                }
            </div>
        </section>
    }
</div>

@section Scripts {
    @await Html.PartialAsync("_ChoicesScriptsPartial")
}
