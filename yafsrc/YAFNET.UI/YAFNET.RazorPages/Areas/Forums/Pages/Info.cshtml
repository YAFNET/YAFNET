@page "{info:int}/{message?}"
@using YAF.Types.Extensions
@using YAF.Types.Constants
@using YAF.Web.HtmlHelpers
@model InfoModel

@{
    Model.PageBoardContext.CurrentForumPage.PageTitle = Model.Title;
}

<div class="account-page">
    <div class="card account-card">
        <div class="card-body text-center" id="InfoMessage">
            <span class="account-icon @(Model.IsWarning ? "account-icon-warning" : string.Empty)">@Html.Icon(Model.Icon)</span>
            <h1 class="account-title">@Model.Title</h1>
            <p class="account-subtitle mb-4">
                @if (Model.InfoIsHtml)
                {
                    @Html.Raw(Model.InfoLabel)
                }
                else
                {
                    @Model.InfoLabel
                }
            </p>
            <div class="d-grid">
                <a asp-page="@ForumPages.Index.GetPageName()" button-style="Primary"
                   icon="home"
                   text-localized-page="INFO" text-localized-tag="CONTINUE">
                </a>
            </div>
        </div>
    </div>
</div>
