@using YAF.Core.Context
@using YAF.Core.Extensions
@using YAF.Core.Helpers
@using YAF.Core.Model
@using YAF.Web.HtmlHelpers
@using YAF.Types.Constants
@using YAF.Types.Extensions
@using YAF.Types.Interfaces
@using YAF.Types.Interfaces.Services
@using YAF.Types.Models
@using YAF.Types.Objects.Model

@inject BoardContext Current

@{
    // Latest forum posts
    // Shows the latest n number of posts on the main forum list page
    const string cacheKey = Constants.Cache.ActiveDiscussions;

    List<LatestTopic> LoadActiveTopics() => Current.GetRepository<Topic>().Latest(
        Current.PageBoardID,
        Current.PageCategoryID,
        Current.BoardSettings.ActiveDiscussionsCount,
        Current.PageUserID,
        Current.BoardSettings.NoCountForumsInActiveDiscussions,
        Current.BoardSettings.UseReadTrackingByDatabase);

    List<LatestTopic> activeTopics;

    if (Current.IsGuest)
    {
        // allow caching since this is a guest, one list per category (the index of a category shows only its topics),
        // all in one cache entry, so clearing the entry clears all categories
        var guestLists = Current.Get<IDataCache>().GetOrSet(
            cacheKey,
            () => new System.Collections.Concurrent.ConcurrentDictionary<int, List<LatestTopic>>(),
            TimeSpan.FromMinutes(Current.BoardSettings.ActiveDiscussionsCacheTimeout));

        activeTopics = guestLists.GetOrAdd(Current.PageCategoryID, _ => LoadActiveTopics());
    }
    else
    {
        activeTopics = LoadActiveTopics();
    }
}

@{
    // only topics with a last post, the avatars of the last posters with one query
    var shownTopics = activeTopics?.Where(topic => topic.LastPosted.HasValue && topic.LastUserID.HasValue).ToList() ?? [];

    var lastPosterAvatars = Current.Get<IAvatars>().GetAvatarUrlsForUsers(shownTopics.Select(topic => topic.LastUserID.Value));

    var showFeed = Current.Get<IPermissions>().Check(Current.BoardSettings.PostLatestFeedAccess) && Current.BoardSettings.ShowAtomLink;
}

<div class="card mb-3 active-discussions">
    <div class="card-header d-flex align-items-center justify-content-between gap-2">
        <span class="d-flex align-items-center">
            @Html.IconHeader("comments", "DEFAULT", "ACTIVE_DISCUSSIONS", "fa-2x")
        </span>
        @if (showFeed)
        {
            @Html.RssFeedLink(RssFeeds.LatestPosts, true)
        }
    </div>
    @if (shownTopics.Count == 0)
    {
        <div class="card-body active-discussions-empty">
            @Html.LocalizedText("DEFAULT", "NO_POSTS")
        </div>
    }
    else
    {
        <ul class="list-group list-group-flush">
            @foreach (var topic in shownTopics)
            {
                var lastRead = Current.Get<IReadTrackCurrentUser>().GetForumTopicRead(
                    topic.ForumID,
                    topic.TopicID,
                    topic.LastForumAccess ?? DateTimeHelper.SqlDbMinTime(),
                    topic.LastTopicAccess ?? DateTimeHelper.SqlDbMinTime());

                lastPosterAvatars.TryGetValue(topic.LastUserID.Value, out var avatarUrl);

                <li class="list-group-item active-discussion" data-topic-id="@topic.TopicID">
                    @Html.LastPost(new LastPostItem
                    {
                        TopicID = topic.TopicID,
                        TopicName = topic.Topic,
                        TopicStyles = topic.Styles,
                        IsNew = topic.LastPosted > lastRead,
                        MessageID = topic.LastMessageID,
                        ForumID = topic.ForumID,
                        ForumName = topic.Forum,
                        UserID = topic.LastUserID.Value,
                        UserName = topic.LastUserName,
                        UserDisplayName = topic.LastUserDisplayName,
                        UserStyle = topic.LastUserStyle,
                        UserSuspended = topic.LastUserSuspended,
                        AvatarUrl = avatarUrl,
                        Posted = topic.LastPosted.Value
                    })
                </li>
            }
        </ul>
    }
</div>
