@using Microsoft.AspNetCore.Http
@using YAF.Core.Context
@using YAF.Core.Extensions
@using YAF.Core.Helpers
@using YAF.Core.Model
@using YAF.Core.Utilities
@using YAF.Web.HtmlHelpers
@using YAF.Types.Constants
@using YAF.Types.Extensions
@using YAF.Types.Flags
@using YAF.Types.Interfaces
@using YAF.Types.Interfaces.Services
@using YAF.Types.Models
@using YAF.Types.Objects.Model

@model PagedMessage

@inject BoardContext Current

@{
    var postData = new PostDataHelperWrapper(Model);
    List<Tuple<ProfileCustom, ProfileDefinition>> customProfile = null;
    var markAsAnswer = false;
    var reportVisible = false;
    var addReputationVisible = false;
    var removeReputationVisible = false;

    var isIgnored = !Current.IsGuest && await Current.Get<IUserIgnored>().IsIgnoredAsync(postData.UserId);

    // the post of an ignored user is collapsed, the bar above it shows it
    var messageRowCssClass = isIgnored ? "collapse" : "collapse show";

    var avatarUrl = Current.Get<IAvatars>().GetAvatarUrlForUser(postData.UserId, Model.Avatar, Model.HasAvatarImage);

    var displayName = Current.BoardSettings.EnableDisplayName ? Model.DisplayName : Model.UserName;

    var editVisible = !postData.PostDeleted && postData.CanEditPost && !postData.IsLocked;

    var moveVisible = Current.ForumModeratorAccess && !postData.IsLocked;

    var deleteVisible = !postData.PostDeleted && postData.CanDeletePost && !postData.IsLocked;

    var unDeleteVisible = postData.CanUnDeletePost && !postData.IsLocked;

    var quoteVisible = !postData.PostDeleted && postData.CanReply && !postData.IsLocked;

    var replyVisible = !postData.PostDeleted && postData.CanReply && !postData.IsLocked;

    var multiQuoteVisible = !postData.PostDeleted && postData.CanReply && !postData.IsLocked;

    var thankVisible = postData.CanThankPost && !Current.IsGuest;

    // the posts selected for the multi quote are kept in the session (also when changing the page of the topic)
    var multiQuoteSelected = multiQuoteVisible
                             && Current.Get<ISessionService>().MultiQuoteIds?.Exists(m => m.MessageID == postData.MessageId) == true;

    if (multiQuoteVisible)
    {
        Current.InlineElements.InsertJsBlock(nameof(JavaScriptBlocks.MultiQuoteButtonJs), JavaScriptBlocks.MultiQuoteButtonJs);
    }

    // Add Reputation Controls to the User PopMenu
    if (Current.BoardSettings.EnableUserReputation && Current.PageUserID != postData.UserId && !postData.IsGuest && !Current.IsGuest && Current.Get<IReputation>().CheckIfAllowReputationVoting(Model.ReputationVoteDate))
    {
	    // Check if the User matches minimal requirements for voting up
	    if (Current.PageUser.Points >= Current.BoardSettings.ReputationMinUpVoting)
	    {
		    addReputationVisible = true;
	    }

	    // Check if the User matches minimal requirements for voting down
	    if (Current.PageUser.Points >= Current.BoardSettings.ReputationMinDownVoting && Model.Points > 0 && Current.BoardSettings.ReputationAllowNegative)
	    {
		    removeReputationVisible = true;
	    }
    }

    // the reactions can't be changed in deleted posts and locked topics
    var reactVisible = thankVisible && !postData.PostDeleted && !postData.IsLocked;

    if (reactVisible)
    {
        Current.InlineElements.InsertJsBlock(nameof(JavaScriptBlocks.SetReactionJs), JavaScriptBlocks.SetReactionJs());
    }

    // report post
    if (Current.Get<IPermissions>().Check(Current.BoardSettings.ReportPostPermissions) && !postData.PostDeleted)
    {
        reportVisible = !Current.IsGuest && Current.MembershipUser != null;
    }

    // mark post as answer
    if (!postData.PostDeleted && !Current.IsGuest && Current.MembershipUser != null && Current.PageUserID.Equals(Model.TopicOwnerID) && !postData.UserId.Equals(Current.PageUserID))
    {
        markAsAnswer = true;
    }

    if (!postData.IsGuest)
    {
        customProfile = [.. Current.Get<IDataCache>().GetOrSet(string.Format(Constants.Cache.UserCustomProfileData, postData.UserId), () => Current.GetRepository<ProfileCustom>().ListByUser(postData.UserId)).Where(x => x.Item2.ShowInUserInfo && x.Item1.Value.IsSet())];
    }

    // the author of a deleted post can undelete it (the edit, delete and move items are hidden then)
    var manageVisible = editVisible || deleteVisible || moveVisible || unDeleteVisible;

    // the items about the author: their posts, edit user, ignore and friend
    var searchUserVisible = !postData.IsGuest && Current.Get<IPermissions>().Check(Current.BoardSettings.SearchPermissions);
    var ignoreVisible = !postData.IsGuest && !Current.IsGuest && Current.PageUserID != postData.UserId;
    var buddyVisible = ignoreVisible && Current.BoardSettings.EnableBuddyList && !new UserBlockFlags(Model.BlockFlags).BlockFriendRequests;
    var editUserVisible = Current.IsAdmin && !postData.IsGuest;
    var userItemsVisible = searchUserVisible || ignoreVisible || editUserVisible;

    var toolsVisible = reportVisible || markAsAnswer || manageVisible || userItemsVisible;

    var ipVisible = Current.IsAdmin || (Current.BoardSettings.AllowModeratorsViewIPs && Current.ForumModeratorAccess);

    var reputationVisible = Current.BoardSettings.EnableUserReputation && !Model.IsGuest;

    var isTopicStarter = Model.TopicOwnerID.Equals(postData.UserId);

    var postNumber = Current.PageIndex * Current.BoardSettings.PostsPerPage + ViewData["index"].ToType<int>() + 1;

    var postCssClass = "card post-card mb-3";

    if (postData.PostIsAnswer)
    {
        postCssClass += " post-answer";
    }

    if (postData.PostDeleted)
    {
        postCssClass += " post-deleted";
    }

    var topicQuery = Current.CurrentForumPage.Request.Query["t"].ToString();
    var pageQuery = Current.CurrentForumPage.Request.GetQueryOrRouteValue<string>("p");

    var quickReplyUrl = Url.Page("Posts", "QuickReply", new { name = Current.CurrentForumPage.Request.GetQueryOrRouteValue<string>("name"), t = Current.PageTopicID, p = pageQuery, m = Current.CurrentForumPage.Request.Query["m"] });

    // the items of the tools menu, the context menu (right click) has the same items and the reply and quote items
    async Task RenderMenuItemsAsync(bool contextMenu)
    {
        if (contextMenu && (quoteVisible || replyVisible))
        {
            if (quoteVisible)
            {
                <a button-style="None"
                   icon="reply"
                   icon-bade="quote-left"
                   text-localized-tag="BUTTON_QUOTE_TT"
                   class="dropdown-item"
                   href="@(Current.Get<ILinkBuilder>().GetLink(ForumPages.PostMessage, new { t = Current.PageTopicID, f = Current.PageForumID, q = postData.MessageId }))"></a>
            }

            if (replyVisible)
            {
                if (Current.BoardSettings.ShowQuickAnswer)
                {
                    <button button-style="None"
                            text-localized-tag="QUICKREPLY"
                            type="button"
                            Icon="reply"
                            icon-bade="window-maximize"
                            bs-toggle="ajax-modal"
                            bs-target="QuickReplyDialog"
                            bs-target-url="@quickReplyUrl"
                            class="dropdown-item"></button>
                }

                <a button-style="None"
                   text-localized-tag="REPLY"
                   icon="reply"
                   class="dropdown-item"
                   href="@(Current.Get<ILinkBuilder>().GetLink(ForumPages.PostMessage, new { t = Current.PageTopicID, f = Current.PageForumID }))"></a>
            }

            <div class="dropdown-divider"></div>
        }

        if (markAsAnswer)
        {
            if (postData.PostIsAnswer)
            {
                <button button-style="None"
                        text-localized-page="POSTS"
                        text-localized-tag="MARK_ANSWER_REMOVE"
                        Icon="minus-square"
                        icon-color="text-danger"
                        asp-controller="Posts"
                        asp-action="MarkAsAnswer"
                        asp-route-t="@topicQuery"
                        asp-route-p="@pageQuery"
                        asp-route-m="@postData.MessageId"
                        class="dropdown-item"></button>
            }
            else
            {
                <button button-style="None"
                        text-localized-page="POSTS"
                        text-localized-tag="MARK_ANSWER"
                        Icon="check-square"
                        icon-color="text-success"
                        asp-controller="Posts"
                        asp-action="MarkAsAnswer"
                        asp-route-t="@topicQuery"
                        asp-route-p="@pageQuery"
                        asp-route-m="@postData.MessageId"
                        class="dropdown-item"></button>
            }

            <div class="dropdown-divider"></div>
        }

        if (manageVisible)
        {
            if (editVisible)
            {
                <a button-style="None"
                   Icon="edit"
                   text-localized-tag="BUTTON_EDIT"
                   class="dropdown-item"
                   href="@(Current.Get<ILinkBuilder>().GetLink(ForumPages.EditMessage, new { m = postData.MessageId }))"></a>
            }

            if (moveVisible)
            {
                <a button-style="None"
                   Icon="arrows-alt"
                   text-localized-tag="BUTTON_MOVE"
                   class="dropdown-item"
                   href="@(Current.Get<ILinkBuilder>().GetLink(ForumPages.MoveMessage, new { m = postData.MessageId }))"></a>
            }

            if (deleteVisible)
            {
                <a button-style="None"
                   Icon="trash"
                   icon-color="text-danger"
                   text-localized-tag="BUTTON_DELETE"
                   class="dropdown-item"
                   href="@(Current.Get<ILinkBuilder>().GetLink(ForumPages.DeleteMessage, new { m = postData.MessageId }))"></a>
            }

            if (unDeleteVisible)
            {
                <a button-style="None"
                   Icon="trash-restore"
                   text-localized-tag="BUTTON_UNDELETE"
                   class="dropdown-item"
                   href="@(Current.Get<ILinkBuilder>().GetLink(ForumPages.DeleteMessage, new { m = postData.MessageId }))"></a>
            }

            <div class="dropdown-divider"></div>
        }

        if (userItemsVisible)
        {
            <h6 class="dropdown-header">@displayName</h6>

            if (searchUserVisible)
            {
                <a button-style="None" icon="th-list"
                   text-localized-page="POSTS" text-localized-tag="SEARCHUSER"
                   class="dropdown-item"
                   href="@(Current.Get<ILinkBuilder>().GetLink(ForumPages.Search, new { postedby = displayName }))"></a>
            }

            if (editUserVisible)
            {
                <a button-style="None" icon="cogs"
                   text-localized-page="POSTS" text-localized-tag="EDITUSER"
                   class="dropdown-item"
                   href="@(Current.Get<ILinkBuilder>().GetLink(ForumPages.Admin_EditUser, new { u = postData.UserId }))"></a>
            }

            if (ignoreVisible)
            {
                if (isIgnored)
                {
                    <button button-style="None" icon="eye"
                            text-localized-page="POSTS" text-localized-tag="TOGGLEUSERPOSTS_SHOW"
                            class="dropdown-item"
                            asp-controller="IgnoredUser"
                            asp-action="RemoveIgnoredUser"
                            asp-route-t="@topicQuery"
                            asp-route-p="@pageQuery"
                            asp-route-m="@postData.MessageId"></button>
                }
                else
                {
                    <button button-style="None" icon="eye-slash"
                            text-localized-page="POSTS" text-localized-tag="TOGGLEUSERPOSTS_HIDE"
                            class="dropdown-item"
                            asp-controller="IgnoredUser"
                            asp-action="AddIgnoredUser"
                            asp-route-t="@topicQuery"
                            asp-route-p="@pageQuery"
                            asp-route-m="@postData.MessageId"></button>
                }
            }

            if (buddyVisible)
            {
                if (Current.Get<IFriends>().IsBuddy(postData.UserId))
                {
                    <button button-style="None" icon="user-times"
                            text-localized-page="BUDDY" text-localized-tag="REMOVEBUDDY"
                            class="dropdown-item"
                            asp-controller="Friends"
                            asp-action="RemoveFriend"
                            asp-route-t="@topicQuery"
                            asp-route-p="@pageQuery"
                            asp-route-m="@postData.MessageId"></button>
                }
                else
                {
                    <button button-style="None" icon="user-plus"
                            text-localized-page="BUDDY" text-localized-tag="ADDBUDDY"
                            class="dropdown-item"
                            asp-controller="Friends"
                            asp-action="AddFriend"
                            asp-route-t="@topicQuery"
                            asp-route-p="@pageQuery"
                            asp-route-m="@postData.MessageId"></button>
                }
            }

            <div class="dropdown-divider"></div>
        }

        if (reportVisible)
        {
            <a button-style="None"
               text-localized-page="POSTS"
               text-localized-tag="REPORTPOST"
               Icon="exclamation-triangle"
               icon-color="text-warning"
               class="dropdown-item"
               href="@(Current.Get<ILinkBuilder>().GetLink(ForumPages.ReportPost, new { m = postData.MessageId }))"></a>
        }
    }
}

@if (isIgnored)
{
    @* the post of an ignored user is hidden, the button shows it *@
    <div class="post-ignored">
        <span class="post-ignored-text">
            @Html.Icon("eye-slash", "text-secondary")
            @Html.Raw(Current.Get<ILocalization>().GetTextFormatted("IGNORED_POST", Html.HtmlEncode(displayName)))
        </span>
        <button type="button"
                class="btn btn-sm btn-outline-secondary"
                data-bs-toggle="collapse"
                data-bs-target="@($"#MessageRow{Model.MessageID}")"
                aria-controls="@($"MessageRow{Model.MessageID}")"
                aria-expanded="false">
            @Html.Icon("eye")@Html.LocalizedText("POSTS", "TOGGLEPOST")
        </button>
    </div>
}

<form method="post">
    <div id="@($"MessageRow{Model.MessageID}")" class="@(messageRowCssClass)">
        <article class="@postCssClass" data-post-id="@Model.MessageID">
            <header class="card-header post-header">
                @if (avatarUrl.IsSet())
                {
                    <img alt="@displayName" title="@displayName" src="@avatarUrl"
                         class="post-avatar" />
                }

                <div class="post-author">
                    <div class="post-author-name">
                        @Html.UserLink(postData.UserId, displayName, Model.Suspended, Model.Style)

                        @if (isTopicStarter)
                        {
                            <span class="badge post-badge post-badge-starter"
                                  title="@(Current.Get<ILocalization>().GetText("POSTS", "TOPIC_STARTER_HELP"))">
                                @Html.LocalizedText("POSTS", "TOPIC_STARTER")
                            </span>
                        }

                        @if (postData.PostIsAnswer)
                        {
                            <span class="badge post-badge post-badge-answer"
                                  title="@(Current.Get<ILocalization>().GetText("POSTS", "MESSAGE_ANSWER_HELP"))">
                                @Html.Icon("check")@Html.LocalizedText("POSTS", "MESSAGE_ANSWER")
                            </span>
                        }
                    </div>

                    <div class="post-author-details">
                        @if (Model.RankName.IsSet())
                        {
                            <span class="post-rank">@Model.RankName</span>
                        }

                        @if (Current.BoardSettings.EnableAchievements && !Model.IsGuest)
                        {
                            @* the achievements the author shows with the posts *@
                            var featured = Current.Get<IAchievementService>().GetFeatured(Model.UserID);

                            if (featured.Count > 0)
                            {
                                <span class="achievement-showcase">
                                    @foreach (var achievement in featured)
                                    {
                                        <span title="@achievement.Name" data-bs-toggle="tooltip">@Html.AchievementTrophy(achievement, "achievement-trophy-sm")</span>
                                    }
                                </span>
                            }
                        }

                        @if (!customProfile.NullOrEmpty())
                        {
                            @foreach (var item in customProfile)
                            {
                                <span class="post-profile-field">
                                    <span class="post-profile-field-name">@(item.Item2.Name):</span>
                                    @item.Item1.Value
                                </span>
                            }
                        }

                        @if (reputationVisible)
                        {
                            <span class="post-reputation d-none d-md-inline-flex">
                                @{
                                    var reputation = Current.Get<IReputation>();
                                    var percentage = reputation.ConvertPointsToPercentage(Model.Points);
                                    var percentageText = percentage.ToString(System.Globalization.CultureInfo.InvariantCulture);
                                    var reputationText = reputation.GetReputationBarText(percentage);
                                }
                                <span class="progress" role="progressbar" aria-label="@reputationText"
                                      aria-valuenow="@percentageText" aria-valuemin="0" aria-valuemax="100">
                                    <span class="@($"progress-bar{reputation.GetReputationBarColor(percentage)}")" style="@($"width: {percentageText}%")"></span>
                                </span>
                                <span class="post-reputation-text">@reputationText</span>

                                @if (addReputationVisible)
                                {
                                    <button class='@($"AddReputation_{Model.UserID}_{Model.MessageID} post-vote")'
                                            button-size="Small"
                                            Icon="thumbs-up"
                                            icon-color="text-success"
                                            button-style="Link"
                                            title-localized-tag="VOTE_UP_TITLE"
                                            asp-controller="Reputation"
                                            asp-action="AddReputation"
                                            asp-route-t="@topicQuery"
                                            asp-route-p="@pageQuery"
                                            asp-route-m="@postData.MessageId">
                                    </button>
                                }

                                @if (removeReputationVisible)
                                {
                                    <button class='@($"RemoveReputation_{Model.UserID}_{Model.MessageID} post-vote")'
                                            button-style="Link"
                                            button-size="Small"
                                            icon-color="text-danger"
                                            Icon="thumbs-down"
                                            title-localized-tag="VOTE_DOWN_TITLE"
                                            asp-controller="Reputation"
                                            asp-action="RemoveReputation"
                                            asp-route-t="@topicQuery"
                                            asp-route-p="@pageQuery"
                                            asp-route-m="@postData.MessageId">
                                    </button>
                                }
                            </span>
                        }

                        @if (ipVisible)
                        {
                            var ip = IPHelper.GetIpAddressAsString(postData.DataRow.IP);

                            <a href="@(string.Format(Current.BoardSettings.IPInfoPageURL, ip))" target="_blank" rel="noopener"
                               class="post-ip d-none d-md-inline"
                               title="@(Current.Get<ILocalization>().GetText("COMMON", "TT_IPDETAILS"))">
                                @Html.LocalizedText("IP"): @ip
                            </a>
                        }
                    </div>
                </div>

                <div class="post-meta">
                    <span class="post-date">
                        @Html.Icon("clock", "", "far")
                        @Html.DisplayDateTime(DateTimeFormat.Both, Model.Posted)
                    </span>
                    <a id="@($"post{Model.MessageID}")"
                       class="post-number"
                       title="@(Current.Get<ILocalization>().GetText("POSTS", "POST_LINK"))"
                       href="@Html.Raw(Current.Get<ILinkBuilder>().GetMessageLink(Current.PageTopic, Model.MessageID))">#@postNumber</a>

                    @if (toolsVisible)
                    {
                        <div class="dropdown">
                            <button button-style="Link" bs-toggle="dropdown" title-localized-tag="TOOLS" Icon="ellipsis-h" class="post-tools"></button>
                            <div class="dropdown-menu dropdown-menu-end">
                                @{ await RenderMenuItemsAsync(false); }
                            </div>
                        </div>
                    }
                </div>
            </header>

            <div class="card-body post-body">
                <div class="message">
                    <messagePostData show-attachments="true"
                                     show-edit-message="true"
                                     show-signature="true"
                                     show-answer-message-link="true"
                                     paged-message="@Model">
                    </messagePostData>

                    @if (Current.BoardSettings.UseCustomContextMenu)
                    {
                        <div class="dropdown-menu context-menu" aria-labelledby="context menu"
                             data-search="@(Current.Get<ILocalization>().GetText("COMMON", "SELECTED_SEARCH"))"
                             data-copy="@(Current.Get<ILocalization>().GetText("COMMON", "SELECTED_COPY"))"
                             data-url="@(quoteVisible ? Current.Get<ILinkBuilder>().GetLink(ForumPages.PostMessage, new { t = Current.PageTopicID, f = Current.PageForumID }) : null)"
                             data-quote="@(quoteVisible ? Current.Get<ILocalization>().GetText("COMMON", "SELECTED_QUOTE") : null)">
                            @{ await RenderMenuItemsAsync(true); }
                        </div>
                    }
                </div>
            </div>

            @if (Model.ThanksNumber > 0 || reactVisible || quoteVisible || multiQuoteVisible)
            {
                <footer class="card-footer post-footer">
                    <div class="post-reactions">
                        @if (Model.ThanksNumber > 0 || reactVisible)
                        {
                            @Html.Raw(Current.Get<IReactions>().ReactionsHtml(postData.MessageId, reactVisible))
                        }
                    </div>
                    <div class="post-actions" role="toolbar">
                        @if (replyVisible)
                        {
                            @if (Current.BoardSettings.ShowQuickAnswer)
                            {
                                <a button-style="Link"
                                   button-size="Small"
                                   title-localized-tag="BUTTON_POSTREPLY_TT"
                                   Icon="reply"
                                   icon-bade="window-maximize"
                                   icon-mobile-only="true"
                                   text-localized-tag="QUICKREPLY"
                                   bs-toggle="ajax-modal"
                                   bs-target="QuickReplyDialog"
                                   bs-target-url="@quickReplyUrl"
                                   class="post-action">
                                </a>
                            }

                            <a button-style="Link"
                               button-size="Small"
                               title-localized-tag="BUTTON_POSTREPLY_TT"
                               Icon="reply"
                               icon-mobile-only="true"
                               text="@(Current.Get<ILocalization>().GetText("REPLY"))"
                               bs-toggle="tooltip"
                               class="post-action"
                               href="@(Current.Get<ILinkBuilder>().GetLink(ForumPages.PostMessage, new { t = Current.PageTopicID, f = Current.PageForumID }))"></a>
                        }

                        @if (quoteVisible)
                        {
                            <a button-style="Link"
                               button-size="Small"
                               icon="reply"
                               icon-bade="quote-left"
                               icon-mobile-only="true"
                               bs-toggle="tooltip"
                               text="@(Current.Get<ILocalization>().GetText("BUTTON_QUOTE_TT"))"
                               title-localized-tag="BUTTON_QUOTE_TT"
                               class="post-action"
                               href="@(Current.Get<ILinkBuilder>().GetLink(ForumPages.PostMessage, new { t = Current.PageTopicID, f = Current.PageForumID, q = postData.MessageId }))"></a>
                        }

                        @if (multiQuoteVisible)
                        {
                            <input type="checkbox"
                                   id="@($"multiQuote{postData.MessageId}")"
                                   aria-label="@(Current.Get<ILocalization>().GetText("BUTTON_MULTI_QUOTE_TT"))"
                                   autocomplete="off"
                                   checked="@multiQuoteSelected"
                                   onclick="@($"handleMultiQuoteButton(this, '{postData.MessageId}', '{postData.TopicId}')")"
                                   class="btn-check" />
                            <label for="@($"multiQuote{postData.MessageId}")"
                                   title="@(Current.Get<ILocalization>().GetText("BUTTON_MULTI_QUOTE_TT"))"
                                   class="btn btn-sm btn-link post-action btn-multiquote">
                                @Html.IconBadge("quote-left", "plus")<span class="ms-1 d-none d-lg-inline-block">@Html.LocalizedText("BUTTON_MULTI_QUOTE")</span>
                            </label>
                        }
                    </div>
                </footer>
            }
        </article>
    </div>
</form>
