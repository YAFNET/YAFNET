@page "{f:int}/{handler?}"
@using YAF.Core.Extensions
@using YAF.Core.Helpers
@using YAF.Core.Model
@using YAF.Web.HtmlHelpers
@using YAF.Types.Constants
@using YAF.Types.Extensions
@using YAF.Types.Flags
@using YAF.Types.Interfaces
@using YAF.Types.Interfaces.Services
@using YAF.Types.Models

@model YAF.Pages.Moderate.ReportedPostsModel

<div class="moderate-posts">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h2 class="h4 mb-0 text-break">
            @Html.Icon("flag")@Html.LocalizedText("MODERATE_DEFAULT", "REPORTED"):
            @Model.PageBoardContext.PageForum.Name
            <span class="badge text-bg-secondary align-middle ms-1">@Model.Reported.Count</span>
        </h2>
        <a asp-page="@ForumPages.Moderate_Moderate.GetPageName()"
           button-style="OutlineSecondary"
           button-size="Small"
           Icon="gavel"
           text-localized-page="MODERATE_DEFAULT"
           text-localized-tag="TITLE"></a>
    </div>

    <form method="post">
        @foreach (var report in Model.Reported)
        {
            var changed = report.OriginalMessage != report.Message;
            var authorName = Model.PageBoardContext.BoardSettings.EnableDisplayName ? report.UserDisplayName : report.UserName;

            <div class="card mb-3 moderate-post" data-message-id="@report.MessageID">
                <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <span class="text-break">
                        @Html.Icon("comment")
                        <a asp-page="@ForumPages.Posts.GetPageName()"
                           asp-route-t="@report.TopicID"
                           asp-route-name="@(UrlRewriteHelper.CleanStringForUrl(report.TopicName))">@report.TopicName</a>
                    </span>
                    <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle moderate-report-count">
                        @Html.Icon("flag")@Model.GetTextFormatted("REPORTED_TIMES", report.NumberOfReports)
                    </span>
                </div>
                <div class="card-body">
                    <div class="moderate-post-author">
                        <img class="moderate-post-avatar" alt=""
                             src="@(Model.Get<IAvatars>().GetAvatarUrlForUser(report.UserID, null, false))" />
                        <div>
                            @Html.UserLink(report.UserID, authorName, report.Suspended, report.UserStyle)
                            <div class="small text-body-secondary">
                                @Html.Icon("clock")@Html.Raw(Model.Get<IDateTimeService>().FormatDateTimeTopic(report.Posted))
                            </div>
                        </div>
                        @if (Model.PageBoardContext.IsAdmin)
                        {
                            <a class="btn btn-sm btn-outline-secondary ms-auto"
                               asp-page="@ForumPages.Admin_EditUser.GetPageName()"
                               asp-route-u="@report.UserID"
                               title="@Model.GetText("PROFILE", "ADMIN_USER")">
                                @Html.Icon("user-cog")<span class="d-none d-md-inline">@Html.LocalizedText("PROFILE", "ADMIN_USER")</span>
                            </a>
                        }
                    </div>

                    <div class="small text-body-secondary mb-1">@Html.LocalizedText("ORIGINALMESSAGE")</div>
                    <div class="moderate-post-message">
                        <message show-attachments="false"
                                 show-edit-message="false"
                                 show-signature="false"
                                 show-answer-message-link="false"
                                 current-message="new Message { MessageFlags = new MessageFlags(report.Flags), ID = report.MessageID, MessageText = report.OriginalMessage }"
                                 service-locator="Model.ServiceLocator">
                        </message>
                    </div>
                    @if (changed)
                    {
                        <div class="alert alert-warning py-2 mt-2 mb-0 moderate-post-changed" role="alert">
                            @Html.Icon("pen")@Html.LocalizedText("MODERATE_FORUM", "MODIFIED")
                        </div>
                    }

                    @* the reporters with their reports (date and text) *@
                    <div class="moderate-reporters mt-3">
                        <div class="small fw-semibold mb-2">@Html.LocalizedText("REPORTEDBY")</div>
                        <ul class="list-group">
                            @foreach (var reporter in await Model.GetRepository<User>().MessageReportersAsync(report.MessageID))
                            {
                                var reporterName = reporter.Item2.DisplayOrUserName();

                                <li class="list-group-item moderate-reporter">
                                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                        <a class="fw-semibold" href="@(Model.Get<ILinkBuilder>().GetUserProfileLink(reporter.Item2.ID, reporterName))">@reporterName</a>
                                        @if (reporter.Item1.ReportedNumber > 1)
                                        {
                                            <span class="badge bg-body-tertiary text-body-secondary border">
                                                @Model.GetTextFormatted("REPORTED_TIMES", reporter.Item1.ReportedNumber)
                                            </span>
                                        }
                                        <a class="btn btn-sm btn-link ms-auto p-0"
                                           href="@(Model.Get<ILinkBuilder>().GetLink(ForumPages.MyMessages, new { u = reporter.Item2.ID, r = report.MessageID }))">
                                            @Html.Icon("envelope")@Html.LocalizedText("REPLYTO") @reporterName
                                        </a>
                                    </div>
                                    @foreach (var item in ReportTextHelper.Parse(reporter.Item1.ReportText))
                                    {
                                        // the text is user input (encoded)
                                        <div class="moderate-report-text">
                                            @if (item.Date.HasValue)
                                            {
                                                <span class="small text-body-secondary me-2">@Html.Raw(Model.Get<IDateTimeService>().FormatDateTimeTopic(item.Date.Value))</span>
                                            }
                                            <span class="text-break">@item.Text</span>
                                        </div>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                </div>
                <div class="card-footer d-flex flex-wrap justify-content-end gap-2">
                    <button type="submit"
                            button-style="None"
                            class="btn btn-sm btn-outline-danger me-auto"
                            asp-page-handler="Delete"
                            asp-route-messageId="@report.MessageID"
                            asp-route-topicId="@report.TopicID"
                            asp-route-f="@Model.PageBoardContext.PageForumID"
                            bs-toggle="confirm"
                            data-title="@Model.GetTextFormatted("CONFIRM_DELETE_POST", Model.HtmlEncode(report.TopicName))"
                            data-yes="@Html.LocalizedText("YES")"
                            data-no="@Html.LocalizedText("NO")"
                            text-localized-page="MODERATE_FORUM"
                            text-localized-tag="DELETE"
                            icon="trash"></button>
                    @if (changed)
                    {
                        <button type="submit"
                                asp-page-handler="ViewHistory"
                                asp-route-messageId="@report.MessageID"
                                asp-route-f="@Model.PageBoardContext.PageForumID"
                                button-style="OutlineSecondary"
                                button-size="Small"
                                text-localized-page="MODERATE_FORUM"
                                text-localized-tag="HISTORY"
                                icon="history"></button>
                        <button type="submit"
                                asp-page-handler="CopyOver"
                                asp-route-messageId="@report.MessageID"
                                asp-route-f="@Model.PageBoardContext.PageForumID"
                                button-style="OutlineSecondary"
                                button-size="Small"
                                text-localized-page="MODERATE_FORUM"
                                text-localized-tag="COPYOVER"
                                icon="copy"></button>
                    }
                    <button type="submit"
                            asp-page-handler="View"
                            asp-route-messageId="@report.MessageID"
                            asp-route-f="@Model.PageBoardContext.PageForumID"
                            button-style="OutlineSecondary"
                            button-size="Small"
                            text-localized-page="MODERATE_FORUM"
                            text-localized-tag="VIEW"
                            icon="eye"></button>
                    <button type="submit"
                            asp-page-handler="Resolved"
                            asp-route-messageId="@report.MessageID"
                            asp-route-f="@Model.PageBoardContext.PageForumID"
                            button-style="Success"
                            button-size="Small"
                            text-localized-page="MODERATE_FORUM"
                            text-localized-tag="RESOLVED"
                            icon="check"></button>
                </div>
            </div>
        }
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_PostScriptsPartial")
}
