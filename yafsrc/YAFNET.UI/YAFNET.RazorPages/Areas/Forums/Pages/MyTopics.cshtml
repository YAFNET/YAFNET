@page "{handler?}"
@using YAF.Core.Helpers
@using YAF.Types.Constants
@using YAF.Types.Extensions
@using YAF.Types.Interfaces
@using YAF.Web.HtmlHelpers
@model MyTopicsModel


<form method="post">
    <div class="row">
        <div class="col">
            <div class="card my-3">
                <div class="card-header">
                    <div class="row justify-content-between align-items-center">
                        <div class="col-auto">

                            @switch (Model.Input.TopicModeValue.ToEnum<TopicListMode>())
                            {
                                case TopicListMode.Active:
                                    @Html.IconHeader("comments", "MYTOPICS", "ActiveTopics")
                                    break;
                                case TopicListMode.Unanswered:
                                    @Html.IconHeader("comments", "MYTOPICS", "UnansweredTopics")
                                    break;
                                case TopicListMode.Watch:
                                    @Html.IconHeader("comments", "MYTOPICS", "WatchTopics")
                                    break;
                                case TopicListMode.User:
                                    @Html.IconHeader("comments", "MYTOPICS", "MyTopics")
                                    break;
                            }

                        </div>
                        <div class="col-auto">
                            <div class="btn-toolbar" role="toolbar">
                                <div class="input-group input-group-sm me-2 mb-1" role="group">
                                    <div class="input-group-text">
                                        @Html.LocalizedText("SHOW"):
                                    </div>
                                    <select asp-for="@Model.Size"
                                            asp-items="Model.PageSizeList"
                                            title="@Html.LocalizedText("COMMON", "SHOW_TITLE")"
                                            aria-label="@Html.LocalizedText("COMMON", "SHOW_TITLE")"
                                            class="form-select"
                                            onchange="this.form.submit();"></select>
                                </div>
                                <div class="btn-group me-2 mb-1" role="group" aria-label="Filters">
                                    <button 
                                        class="dropdown-toggle"
                                        bs-toggle="dropdown"
                                        button-size="Small"
                                        button-style="Secondary"
                                        Icon="filter"
                                        text-localized-tag="FILTER_DROPDOWN"
                                        text-localized-page="ADMIN_USERS"></button>

                                    <div class="dropdown-menu dropdown-menu-end dropdown-menu-lg-start">
                                        <div class="px-3 py-1">
                                            <div class="mb-3">
                                                <label asp-for="Input.TopicModeValue" class="form-label" localized-tag="SELECT"></label>
                                                <select asp-items="Model.TopicMode" asp-for="Input.TopicModeValue" class="form-select"
                                                        onchange="this.form.submit();"></select>
                                            </div>
                                            <div class="mb-3">
                                                <label asp-for="Input.SinceValue" class="form-label" localized-tag="SINCE"></label>
                                                <select asp-items="Model.Since" asp-for="Input.SinceValue" class="form-select"
                                                        onchange="this.form.submit();"></select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                @{
                    var totalTopics = Model.TopicList.NullOrEmpty() ? 0 : Model.TopicList.FirstOrDefault().TotalRows;
                }
                <div class="card-body topic-list"
                     id="topicsContainer"
                     data-load-more-url="@Url.Page("MyTopics", "LoadMoreTopics")"
                     data-next-page="@(Model.PageBoardContext.PageIndex + 1)"
                     data-page-size="@Model.Size"
                     data-show="@Model.Input.SinceValue"
                     data-mode="@Model.Input.TopicModeValue"
                     data-total="@totalTopics"
                     data-loaded-count="@(Model.TopicList?.Count ?? 0)"
                     data-icon-legend-content="@((await Html.PartialAsync("_TopicIconLegend")).RenderToString())"
                     data-topic-starter-title="@(Model.Get<ILocalization>().GetText("TOPIC_STARTER"))"
                     data-last-post-title="@($"{Model.Get<ILocalization>().GetText("LASTPOST")} {Model.Get<ILocalization>().GetText("SEARCH", "BY")} ...")">
                    @if (!Model.TopicList.NullOrEmpty())
                    {
                        @foreach (var topic in Model.TopicList)
                        {
                            @Html.TopicContainer(topic, false)
                        }
                    }
                    else
                    {
                        <alert type="info" icon="info-circle" localized-tag="NO_POSTS">
                        </alert>
                    }

                    <div id="topicsLoadMoreSentinel" class="text-center py-3">
                        <div class="spinner-border spinner-border-sm text-secondary d-none" role="status">
                            <span class="visually-hidden">@Html.LocalizedText("COMMON", "LOADING")</span>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="row justify-content-end">
                        <div class="col-auto">
                            <button asp-page-handler="MarkAll"
                                    text-localized-tag="MARK_ALL_ASREAD" text-localized-page="DEFAULT"
                                    button-style="Secondary"
                                    button-size="Small"
                                    Icon="glasses"></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/topics.min.js" asp-append-version="true" defer></script>
}