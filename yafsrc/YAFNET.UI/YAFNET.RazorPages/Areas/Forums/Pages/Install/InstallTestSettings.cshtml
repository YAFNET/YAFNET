@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Localization
@using Microsoft.Extensions.Configuration
@using YAF.Core.Context
@using YAF.Core.Helpers
@using YAF.Types.Extensions
@using YAF.Types.Interfaces
@using YAF.Types.Objects

@inject ILocalization Localization;

@model YAF.Types.Modals.InstallModal

@{
    Layout = "_LayoutInstall";

    var requestCultureFeature = BoardContext.Current.Get<IHttpContextAccessor>().HttpContext.Features.Get<IRequestCultureFeature>();
    var requestCulture = requestCultureFeature.RequestCulture;

    Localization.TransPage = "INSTALL";
}

<form method="post">
    <div class="modal-body">
        <partial name="_WizardSteps" model="1" />

        <h4>
            @Localization.GetText("TestSettings")
        </h4>
        <p class="text-body-secondary">
            @Localization.GetText("TestSettingsText")
        </p>

        @* the database: the connection is needed for the next steps *@
        <div class="install-check @(Model.ConnectionSuccess ? "is-success" : "is-failed")">
            <div class="install-check-icon">
                <i class="fa @(Model.ConnectionSuccess ? "fa-circle-check" : "fa-circle-xmark")" aria-hidden="true"></i>
            </div>
            <div class="install-check-content">
                <h5 class="mb-1">
                    @Localization.GetText("ConnectionTest")
                    <span class="badge bg-secondary-subtle text-secondary-emphasis align-middle ms-1">@(BoardContext.Current.Get<BoardConfiguration>().ConnectionProviderName)</span>
                </h5>
                @* the password of the database is not shown (the wizard is shown to every visitor) *@
                <div class="install-check-detail">@(InstallHelper.MaskConnectionString(BoardContext.Current.Get<IConfiguration>().GetConnectionString("DefaultConnection")))</div>
                <div class="install-check-result">
                    @if (Model.ConnectionSuccess)
                    {
                        @Localization.GetText("ConnectionSuccess")
                    }
                    else
                    {
                        @Localization.GetText("ConnectionFailed") @Model.ConnectionInfo
                    }
                </div>
            </div>
        </div>

        @* the mail sending (optional) *@
        <div class="card install-mail-test">
            <div class="card-header">
                <i class="fa fa-envelope me-1 text-secondary" aria-hidden="true"></i>@Localization.GetText("MailTest")
            </div>
            <div class="card-body">
                <p class="text-body-secondary">
                    @Localization.GetText("MailTestDesc")
                </p>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="fromEmail" class="form-label">@Localization.GetText("FromEmail")</label>
                        <input id="fromEmail" name="fromEmail"
                               placeholder="@Localization.GetText("FromEmail")"
                               value="@Model.FromEmail"
                               type="email"
                               autocomplete="email"
                               class="form-control"/>
                    </div>
                    <div class="col-md-6">
                        <label for="toEmail" class="form-label">@Localization.GetText("ToEmail")</label>
                        <input id="toEmail" name="toEmail"
                               placeholder="@Localization.GetText("ToEmail")"
                               value="@Model.ToEmail"
                               type="email"
                               autocomplete="email"
                               class="form-control"/>
                    </div>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                    <button Text="@Localization.GetText("TestEmail")"
                            Icon="paper-plane"
                            button-style="OutlineSecondary"
                            asp-page-handler="TestSmtp"
                            asp-route-culture="@requestCulture.Culture.Name"></button>

                    @if (Model.TestEmailInfo.IsSet())
                    {
                        <span class="install-mail-result @(Model.TestEmailSuccess ? "text-success-emphasis" : "text-danger-emphasis")">
                            <i class="fa @(Model.TestEmailSuccess ? "fa-circle-check" : "fa-circle-xmark") me-1" aria-hidden="true"></i>
                            @if (Model.TestEmailSuccess)
                            {
                                @Localization.GetText("SmtpTestSuccess")
                            }
                            else
                            {
                                @Model.TestEmailInfo
                            }
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        @* without a database connection the next steps fail *@
        <button button-style="Primary"
                Icon="arrow-alt-circle-right"
                asp-page-handler="InstallInitDatabase"
                asp-route-culture="@requestCulture.Culture.Name"
                disabled="@(!Model.ConnectionSuccess)"
                Text="@Localization.GetText("Next")"></button>
    </div>
</form>
