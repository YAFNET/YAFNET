@page "{handler?}"
@using YAF.Web.HtmlHelpers
@model YAF.Pages.Account.ForgotPasswordModel

<div class="row mb-3">
    <div class="col">
        <div class="card mx-auto rounded-4 shadow" style="max-width:450px">
            <div class="card-body p-4 m-4">
                <section>
                    <h1 class="fw-bold mb-4 fs-2">@Html.IconHeader("key", "LOGIN", "LOSTPASSWORD")</h1>
                    <form method="post" class="needs-validation" novalidate>
                        <p class="text-body-secondary">
                            @Html.LocalizedText("LOGIN", "PAGE1_INSTRUCTIONS")
                        </p>
                        <div class="mb-3">
                            <label asp-for="Input.UserName" localized-page="LOGIN" localized-tag="USERNAME" class="form-label">
                            </label>
                            <input asp-for="Input.UserName" class="form-control" required />
                            <div class="invalid-feedback">
                                @Html.LocalizedText("LOGIN", "NEED_USERNAME")
                            </div>
                        </div>
                        <div class="mb-3 d-grid gap-2">
                            <button type="submit" button-style="Primary"
                                    text-localized-page="COMMON" text-localized-tag="SUBMIT"
                                    icon="check">
                            </button>
                        </div>
                    </form>
                </section>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptPartial")
}