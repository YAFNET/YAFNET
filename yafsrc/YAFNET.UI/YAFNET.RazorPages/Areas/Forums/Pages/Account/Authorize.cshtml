@page
@using YAF.Types.Constants
@using YAF.Types.Extensions
@using YAF.Web.HtmlHelpers
@model AuthorizeModel

<div class="account-page">
    <div class="card account-card">
        <div class="card-body">
            <div class="account-head">
                <span class="account-icon">@Html.Icon("shield-alt")</span>
                <h1 class="account-title">@Html.LocalizedText("LOGIN", "TWO_FA_VALIDATION")</h1>
                <p class="account-subtitle">@Html.LocalizedText("LOGIN", "TWO_FA_INFO")</p>
            </div>
            <form method="post" class="needs-validation" novalidate>
                <div class="mb-4">
                    <label asp-for="ValidationCode" class="form-label" localized-page="EDIT_SETTINGS" localized-tag="SETUP_CODE"></label>
                    <input type="text" class="form-control account-code" asp-for="ValidationCode"
                           placeholder="### ###"
                           inputmode="numeric"
                           autocomplete="one-time-code"
                           autofocus
                           required>
                </div>
                <div class="d-grid">
                    <button type="submit" button-style="Primary"
                            text-localized-tag="VALIDATE"
                            text-localized-page="APPROVE"
                            icon="check-circle">
                    </button>
                </div>
            </form>
            <div class="account-footer">
                <a asp-page="@ForumPages.Account_Login.GetPageName()" id="BackToLogin">
                    @Html.Icon("arrow-left")@Html.LocalizedText("LOGIN", "BACK_TO_LOGIN")
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptPartial")
}
