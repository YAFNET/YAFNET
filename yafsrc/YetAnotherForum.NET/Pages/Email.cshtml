@page "{u:int}/{handler?}"

@using YAF.Core.Extensions
@using YAF.Types.Constants
@using YAF.Types.Extensions
@using YAF.Types.Interfaces
@using YAF.Web.HtmlHelpers
@model EmailModel

<form method="post" class="needs-validation post-action-page" novalidate>
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h2 class="h4 mb-0">@Html.Icon("envelope-open")@Html.LocalizedText("IM_EMAIL", "TITLE")</h2>
    </div>

    <div class="card mb-3">
        <div class="card-header d-flex align-items-center gap-2">
            @Html.Icon("user")
            <span>@Html.UserLink(Model.EmailUser)</span>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label asp-for="Input.Subject" class="form-label"
                       localized-page="IM_EMAIL"
                       localized-tag="SUBJECT">
                </label>
                <input asp-for="Input.Subject" class="form-control" autofocus required />
                <div class="invalid-feedback">
                    @Html.LocalizedText("EMAILTOPIC", "NEED_SUBJECT")
                </div>
            </div>
            <div>
                <label asp-for="Input.Body" class="form-label"
                       localized-page="IM_EMAIL"
                       localized-tag="BODY">
                </label>
                <textarea asp-for="Input.Body" class="form-control" required rows="10"></textarea>
                <div class="invalid-feedback">
                    @Html.LocalizedText("EMAILTOPIC", "NEED_MESSAGE")
                </div>
            </div>
        </div>
    </div>

    <div class="post-action-bar">
        <a asp-page="@ForumPages.UserProfile.GetPageName()"
           asp-route-u="@Model.EmailUser.ID"
           asp-route-name="@Model.EmailUser.DisplayOrUserName()"
           button-style="Secondary"
           icon="reply"
           text-localized-page="COMMON"
           text-localized-tag="CANCEL"></a>
        <button type="submit" button-style="Primary"
                icon="paper-plane"
                text-localized-tag="SEND"></button>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptPartial")
}
