@using YAF.Core.Context
@using YAF.Web.HtmlHelpers
@model YAF.Types.Modals.QuickReplyModal

@inject BoardContext Current

@* the quick reply of a post in a dialog: wide on large screens, the whole screen on phones *@
<div class="modal fade needs-validation quick-reply-dialog" id="QuickReplyDialog" tabindex="-1" role="dialog" aria-labelledby="quickReplyLabel" aria-hidden="true" novalidate>
    <div class="modal-dialog modal-lg modal-dialog-centered modal-fullscreen-sm-down" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="quickReplyLabel">
                    @Html.Icon("reply")@Html.LocalizedText("QUICKREPLY")
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form asp-controller="PostsModal" asp-action="Reply" asp-route-t="@Current.PageTopicID" asp-route-f="@Current.PageForumID">
                    <input name="IsValid" type="hidden" value="@ViewData.ModelState.IsValid.ToString()" />
                    <textarea asp-for="QuickReplyEditor"
                              class="form-control"
                              rows="8"
                              cols="100"
                              editor-mode="QuickReply"
                              users-can-upload="false"
                              title="@Html.LocalizedText("QUICKREPLY")"
                              maxlength="@Current.BoardSettings.MaxPostSize"
                              max-characters="@Current.BoardSettings.MaxPostSize" required></textarea>
                    @if (!Current.IsGuest)
                    {
                        <div class="form-check form-switch mt-3 mb-0">
                            <input class="form-check-input" type="checkbox" role="switch" switch asp-for="TopicWatch">
                            <label class="form-check-label" asp-for="TopicWatch" localized-tag="TOPICWATCH"></label>
                        </div>
                    }
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    @Html.Icon("xmark")@Html.LocalizedText("COMMON", "CANCEL")
                </button>
                <button button-style="Primary" data-bs-save="editModal" type="button"
                        text-localized-tag="SAVE" text-localized-page="POSTMESSAGE"
                        Icon="reply">
                </button>
            </div>
        </div>
    </div>
</div>
