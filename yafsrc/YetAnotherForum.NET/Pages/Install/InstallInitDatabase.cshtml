@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Localization
@using YAF.Core.Context
@using YAF.Types.Interfaces

@inject ILocalization Localization;

@model YAF.Types.Modals.InstallModal

@{
    Layout = "_LayoutInstall";

    var requestCultureFeature = BoardContext.Current.Get<IHttpContextAccessor>().HttpContext.Features.Get<IRequestCultureFeature>();
    var requestCulture = requestCultureFeature.RequestCulture;

    Localization.TransPage = "INSTALL";
}

<form method="post">
    <div class="modal-body">
        <partial name="_WizardSteps" model="2" />

        <div class="install-step">
            <div class="install-step-icon text-primary bg-primary-subtle">
                <i class="fa fa-database" aria-hidden="true"></i>
            </div>
            <div class="install-step-content">
                <h4>
                    @Localization.GetText("Initialize") @Localization.GetText("Database")
                </h4>
                <p class="text-body-secondary mb-0">
                    @Localization.GetText("NextInitDb")
                </p>
            </div>
        </div>
    </div>
    <div class="modal-footer justify-content-between">
        <button button-style="Secondary"
                Icon="arrow-alt-circle-left"
                asp-page-handler="InstallTestSettings"
                asp-route-culture="@requestCulture.Culture.Name"
                Text="@Localization.GetText("Previous")"></button>
        <button button-style="Primary"
                Icon="arrow-alt-circle-right"
                asp-page-handler="InstallCreateForum"
                asp-route-culture="@requestCulture.Culture.Name"
                Text="@Localization.GetText("Next")"></button>
    </div>
</form>
