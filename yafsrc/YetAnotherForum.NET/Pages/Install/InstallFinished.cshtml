@using YAF.Types.Interfaces

@inject ILocalization Localization;

@model YAF.Types.Modals.InstallModal

@{
    Layout = "_LayoutInstall";

    Localization.TransPage = "INSTALL";
}

<form method="post">
    <div class="modal-body">
        <partial name="_WizardSteps" model="4" />

        <div class="install-step">
            <div class="install-step-icon text-success bg-success-subtle">
                <i class="fa fa-circle-check" aria-hidden="true"></i>
            </div>
            <div class="install-step-content">
                <h4>
                    @Localization.GetText("Setup") @Localization.GetText("Finished")
                </h4>
                <p class="mb-1">@Localization.GetText("InitFinish")</p>
                <p class="text-body-secondary mb-0">
                    @Localization.GetText("FinishDesc")
                </p>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button icon="check-circle"
                button-style="Success"
                asp-page-handler="Complete"
                Text="@Localization.GetText("Finish")"></button>
    </div>
</form>
