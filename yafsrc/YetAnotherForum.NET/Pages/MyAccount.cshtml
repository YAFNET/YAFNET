@page "{handler?}"

@using YAF.Core.Extensions
@using YAF.Web.HtmlHelpers
@using YAF.Types.Interfaces.Services

@model MyAccountModel

<div class="row">
    <div class="col-sm-auto">
        <profileMenu></profileMenu>
    </div>
    <div class="col">
        <div class="row">
            <div class="col">
                <div class="card mb-3">
                    <div class="card-header">
                        @Html.IconHeader("address-card", "TOOLBAR", "MYPROFILE")
                    </div>
                    <div class="card-body">
                        <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-3 mb-3">
                            <div class="profile-avatar-frame flex-shrink-0 bg-body rounded-3">
                                <img src="@Html.Raw(Model.Get<IAvatars>().GetAvatarUrlForCurrentUser())"
                                     class="profile-avatar d-block w-100 h-100 mw-100 mh-100 object-fit-cover"
                                     alt="avatar" />
                            </div>
                            <div class="flex-grow-1">
                                <h5 class="mb-1">@Model.PageBoardContext.PageUser.Name</h5>
                                @if (Model.PageBoardContext.BoardSettings.EnableDisplayName)
                                {
                                    <div class="text-body-secondary mb-2">
                                        @Html.HtmlEncode(Model.PageBoardContext.PageUser.DisplayOrUserName())
                                    </div>
                                }
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var group in Model.Groups)
                                    {
                                        <span class="profile-pill" style="@group.Style">
                                            @group.Name
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-2 g-md-3 account-detail-grid">
                            <div class="col">
                                <div class="detail-tile bg-body-tertiary h-100">
                                    <div class="detail-tile-label">@Html.LocalizedText("YOUR_USERNAME")</div>
                                    <div class="detail-tile-value">@Model.PageBoardContext.PageUser.Name</div>
                                </div>
                            </div>
                            <div class="col">
                                <div class="detail-tile bg-body-tertiary h-100">
                                    <div class="detail-tile-label">@Html.LocalizedText("YOUR_EMAIL")</div>
                                    <div class="detail-tile-value">@Model.PageBoardContext.PageUser.Email</div>
                                </div>
                            </div>
                            <div class="col">
                                <div class="detail-tile bg-body-tertiary h-100">
                                    <div class="detail-tile-label">@Html.LocalizedText("NUMPOSTS")</div>
                                    <div class="detail-tile-value">@Html.Raw($"{Model.PageBoardContext.PageUser.NumPosts:N0}")</div>
                                </div>
                            </div>
                            <div class="col">
                                <div class="detail-tile bg-body-tertiary h-100">
                                    <div class="detail-tile-label">@Html.LocalizedText("JOINED")</div>
                                    <div class="detail-tile-value">@Html.Raw(Model.Get<IDateTimeService>().FormatDateTime(Model.PageBoardContext.PageUser.Joined))</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        @if (Model.PageBoardContext.PageUser.Activity)
        {
            <div class="row">
                <div class="col">
                    <div class="card mb-3" id="activity">
                        <div class="card-header">
                            @Html.IconHeader("stream", "ACCOUNT", "ACTIVITY")
                        </div>
                        <form method="post">
                            <div class="card-body border-bottom py-2" id="activityFilters">
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <span class="text-muted">@Html.LocalizedText("FILTER_DROPDOWN"):</span>
                                    <div class="btn-group flex-wrap" role="group" aria-label="Filters">
                                        <input asp-for="CreatedTopic" class="btn-check" autocomplete="off" />
                                        <label asp-for="CreatedTopic" class="btn btn-outline-primary btn-sm">
                                            @Html.Icon("comment")@Html.LocalizedText("ACCOUNT", "CREATED_TOPIC")
                                        </label>
                                        <input asp-for="CreatedReply" class="btn-check" autocomplete="off" />
                                        <label asp-for="CreatedReply" class="btn btn-outline-primary btn-sm">
                                            @Html.Icon("comment")@Html.LocalizedText("ACCOUNT", "CREATED_REPLY")
                                        </label>
                                        <input asp-for="GivenThanks" class="btn-check" autocomplete="off" />
                                        <label asp-for="GivenThanks" class="btn btn-outline-primary btn-sm">
                                            @Html.Icon("heart")@Html.LocalizedText("ACCOUNT", "GIVEN_THANKS")
                                        </label>
                                        <input asp-for="BecomeFriends" class="btn-check" autocomplete="off" />
                                        <label asp-for="BecomeFriends" class="btn btn-outline-primary btn-sm">
                                            @Html.Icon("user-group")@Html.LocalizedText("ACCOUNT", "BECOME_FRIENDS")
                                        </label>
                                    </div>
                                    <button type="submit"
                                            asp-page-handler="Reset"
                                            text-localized-page="COMMON"
                                            text-localized-tag="CLEAR"
                                            button-style="Secondary"
                                            button-size="Small"
                                            Icon="trash">
                                    </button>
                                </div>
                            </div>
                        </form>
                        <div class="card-body"
                             id="activityContainer"
                             data-load-more-url="@Url.Page("MyAccount", "LoadMoreActivity")"
                             data-page-size="@Model.Size"
                             data-loaded-count="@Model.Stream.Count">
                            @await Html.PartialAsync("_MyAccountActivityListItems", Model.Stream)
                            <div id="activityLoadMoreSentinel" class="text-center py-3 d-none">
                                <div class="spinner-border spinner-border-sm text-secondary d-none" role="status">
                                    <span class="visually-hidden">@Html.LocalizedText("COMMON", "LOADING")</span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/myaccount.min.js" asp-append-version="true" defer></script>
}