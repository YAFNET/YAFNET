@page "{u:int}/{p:int=1}/{handler?}"

@using YAF.Core.Extensions
@using YAF.Core.Model
@using YAF.Web.HtmlHelpers
@using YAF.Types.Constants
@using YAF.Types.Extensions
@using YAF.Types.Interfaces
@using YAF.Types.Models
@model AlbumsModel

@{
    var albumsCount = !Model.Albums.NullOrEmpty() ? Model.GetRepository<UserAlbum>().ListByUser(Model.AlbumUser.ID).Count.ToType<int>() : 0;
    var isOwn = Model.AlbumUser.ID == Model.PageBoardContext.PageUserID;
}

<div class="albums-page">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h2 class="h4 mb-0 text-break">
            @Html.Icon("images")@Model.GetTextFormatted("ALBUMS_HEADER_TEXT", Model.AlbumUser.DisplayOrUserName())
            <span class="badge text-bg-secondary align-middle ms-1" id="AlbumCount">@albumsCount</span>
        </h2>
        @* without albums the button is in the empty list *@
        @if (Model.ShowAddAlbumButton && !Model.Albums.NullOrEmpty())
        {
            <a role="button"
               button-style="Primary"
               icon="plus"
               text-localized-page="BUTTON"
               text-localized-tag="BUTTON_ADDALBUM"
               href="@Html.Raw(Model.Get<ILinkBuilder>().GetLink(ForumPages.EditAlbumImages, new { a = "new" }))"></a>
        }
    </div>

    @if (isOwn)
    {
        @* the albums the user can have *@
        <div class="albums-quota mb-3" id="AlbumsQuota">
            @if (Model.AlbumsAllowed > 0)
            {
                var percent = Math.Min(100, Model.AlbumsUsed * 100 / Model.AlbumsAllowed);

                <div class="d-flex justify-content-between small mb-1">
                    <span>@Model.GetTextFormatted("ALBUMS_QUOTA", Model.AlbumsUsed, Model.AlbumsAllowed)</span>
                </div>
                <div class="progress" role="progressbar"
                     aria-label="@Model.GetTextFormatted("ALBUMS_QUOTA", Model.AlbumsUsed, Model.AlbumsAllowed)"
                     aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar @(percent >= 100 ? "bg-warning" : string.Empty)" style="width: @percent%"></div>
                </div>
            }
            else
            {
                <div class="small text-body-secondary">@Html.LocalizedText("ALBUM", "ALBUMS_NOTALLOWED")</div>
            }
        </div>
    }

    @if (!Model.Albums.NullOrEmpty())
    {
        <div class="album-grid mb-3">
            @foreach (var album in Model.Albums)
            {
                var albumLink = Model.Get<ILinkBuilder>().GetLink(ForumPages.Album, new { u = album.UserID, a = album.ID });
                var images = Model.ImageCounts.GetValueOrDefault(album.ID);

                <div class="card album-card @(isOwn ? "list-group-item-menu" : string.Empty)" data-album-id="@album.ID">
                    <a href="@albumLink" class="album-cover-link" title="@Html.StoredText(album.Title)">
                        <img alt="@Html.StoredText(album.Title)" class="album-cover"
                             src="@(Model.Get<IUrlHelper>().Action("GetAlbumCover", "Albums", new { albumId = album.ID, coverId = album.CoverImageID ?? 0 }))" />
                    </a>
                    <div class="card-body">
                        @if (isOwn)
                        {
                            var caption = album.Title.IsNotSet() ? Model.Get<ILocalization>().GetText("ALBUM_CHANGE_TITLE") : Html.StoredText(album.Title);

                            <div class="album-title text-break">
                                @Html.Icon("pen", "text-secondary")
                                <a class="album-caption" data-type="text"
                                   id="@album.ID"
                                   data-id="@album.ID"
                                   data-url="/api/Album/ChangeAlbumTitle"
                                   data-title="@Html.LocalizedText("ALBUM_CHANGE_TITLE")">@caption</a>
                            </div>
                        }
                        else
                        {
                            <a class="album-title fw-semibold text-break" href="@albumLink">@Html.StoredText(album.Title)</a>
                        }
                        <div class="album-footer">
                            <span class="badge bg-body-tertiary text-body-secondary border album-images">
                                @Html.Icon("image")@Model.GetTextFormatted("IMAGES_COUNT", images)
                            </span>
                            @if (isOwn)
                            {
                                <a role="button"
                                   button-style="OutlineSecondary"
                                   button-size="Small"
                                   icon="edit"
                                   title-localized-page="BUTTON"
                                   title-localized-tag="BUTTON_EDITALBUMIMAGES"
                                   href="@(Model.Get<ILinkBuilder>().GetLink(ForumPages.EditAlbumImages, new { a = album.ID }))"></a>
                            }
                        </div>
                    </div>
                    @if (isOwn)
                    {
                        <div class="dropdown-menu context-menu" aria-labelledby="context menu">
                            <a class="dropdown-item" href="@albumLink">
                                @Html.Icon("images")@Html.LocalizedText("VIEW")
                            </a>
                            <a class="dropdown-item" href="@(Model.Get<ILinkBuilder>().GetLink(ForumPages.EditAlbumImages, new { a = album.ID }))">
                                @Html.Icon("edit")@Html.LocalizedText("BUTTON", "BUTTON_EDITALBUMIMAGES")
                            </a>
                        </div>
                    }
                </div>
            }
        </div>

        @if (albumsCount > Model.PageBoardContext.BoardSettings.AlbumsPerPage)
        {
            <div class="d-flex justify-content-end mb-3">
                <pager page-size="@Model.PageBoardContext.BoardSettings.AlbumsPerPage" use-submit="false"
                       count="@albumsCount">
                </pager>
            </div>
        }
    }
    else
    {
        <div class="card mb-3">
            <div class="card-body text-center">
                <empty icon="images"
                       header-text-page="ALBUM" header-text-tag="EMPTY_HEADER"
                       message-text-page="ALBUM" message-text-tag="EMPTY_MESSAGE">
                </empty>
                @if (Model.ShowAddAlbumButton)
                {
                    <a role="button"
                       button-style="Primary"
                       icon="plus"
                       text-localized-page="BUTTON"
                       text-localized-tag="BUTTON_ADDALBUM"
                       href="@Html.Raw(Model.Get<ILinkBuilder>().GetLink(ForumPages.EditAlbumImages, new { a = "new" }))"></a>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/albums.min.js" asp-append-version="true" defer></script>
}
