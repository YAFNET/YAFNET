@page "{handler?}"

@using YAF.Core.Context
@using YAF.Core.Extensions
@using YAF.Core.Model
@using YAF.Types.Constants
@using YAF.Types.Extensions
@using YAF.Types.Interfaces
@using YAF.Types.Interfaces.Services
@using YAF.Types.Models
@using YAF.Web.HtmlHelpers
@model MyMessagesModel

@{
    var activeUsers = Model.Get<IDataCache>().GetOrSet(
        Constants.Cache.UsersOnlineStatus,
        () => Model.GetRepository<Active>().List(
            Model.PageBoardContext.BoardSettings.ShowCrawlersInActiveList,
            Model.PageBoardContext.BoardSettings.ActiveListTime),
        TimeSpan.FromMilliseconds(BoardContext.Current.BoardSettings.OnlineStatusCacheTimeout));

    var showStatus = Model.PageBoardContext.BoardSettings.ShowUserOnlineStatus;
}

@Html.AntiForgeryToken()

<div class="row">
    <div class="col-12 col-xl-3">
        <div class="card mb-3">

            <div class="card-header d-flex justify-content-between align-items-center">
                @Html.LocalizedText("CONVERSATION_TITLE")
                <button type="button" class="btn btn-sm btn-primary"
                        data-bs-toggle="collapse" data-bs-target="#NewConversation"
                        aria-expanded="false" aria-controls="NewConversation"
                        title="@Model.GetText("PM", "NEW_CONVERSATION")">
                    <i class="fas fa-plus"></i>
                    <span class="visually-hidden">@Html.LocalizedText("PM", "NEW_CONVERSATION")</span>
                </button>
            </div>

            <input id="UserId" type="hidden" value="@BoardContext.Current.PageUserID" />
            <input id="Avatar" type="hidden" value="@BoardContext.Current.PageUserID" />

            <div id="NewConversation" class="collapse border-bottom">
                <div class="p-2">
                    <label for="FindUser" class="visually-hidden">@Html.LocalizedText("PM", "FIND_USER")</label>
                    <input id="FindUser" type="search" class="form-control form-control-sm" autocomplete="off"
                           placeholder="@Model.GetText("PM", "FIND_USER")"
                           data-url="@(Model.Get<ILinkBuilder>().GetLink(ForumPages.MyMessages, new { u = "__USERID__" }))"
                           data-none="@Model.GetText("PM", "NO_USERS_FOUND")" />
                    <div id="FindUserResults" class="list-group list-group-flush mt-1"></div>
                </div>
            </div>

            <div class="card-body">

                @if (!Model.Users.NullOrEmpty())
                {
                    if (Model.Users.Count > 5)
                    {
                        <label for="FilterConversations" class="visually-hidden">@Html.LocalizedText("PM", "FILTER")</label>
                        <input id="FilterConversations" type="search" class="form-control form-control-sm mb-2" autocomplete="off"
                               placeholder="@Model.GetText("PM", "FILTER")" />
                    }

                    <ul class="list-group list-group-flush chat-list mb-0">

                        @foreach (var user in Model.Users)
                        {
                            var unread = user.Selected ? 0 : Model.UnreadCounts.GetValueOrDefault(user.ID);
                            var isOnline = showStatus && activeUsers.Exists(x => x.UserID == user.ID && !x.IsActiveExcluded);
                            Model.LastMessages.TryGetValue(user.ID, out var lastMessage);
                            var preview = Model.GetLastMessagePreview(user.ID);

                            <li id="@(user.ID)" class="chat-list-user list-group-item list-group-item-action d-flex align-items-center@(user.Selected ? " active" : "")@(unread > 0 ? " unread" : "")"
                                data-name="@user.DisplayOrUserName()">
                                <img class="img-thumbnail rounded chat-avatar me-2 flex-shrink-0 object-fit-cover@(isOnline ? " chat-avatar-online" : "")" loading="lazy"
                                     src="@(Model.Get<IAvatars>().GetAvatarUrlForUser(user))"
                                     alt="@(user.DisplayOrUserName())"
                                     title="@(showStatus ? Model.GetText("POSTS", isOnline ? "USERONLINESTATUS" : "USEROFFLINESTATUS") : null)">
                                <div class="chat-user-info flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-baseline">
                                        <span class="name text-truncate">@Html.UserLabel(user)</span>
                                        @if (lastMessage is not null)
                                        {
                                            <small class="chat-time text-secondary text-nowrap ms-1">@Html.DisplayDateTime(DateTimeFormat.BothTopic, lastMessage.Created)</small>
                                        }
                                    </div>
                                    @if (preview is not null)
                                    {
                                        <small class="chat-preview d-block text-secondary text-truncate">@(lastMessage.FromUserId == Model.PageBoardContext.PageUserID ? Model.GetText("PM", "YOU") + " " : "")@preview</small>
                                    }
                                </div>
                                @if (unread > 0)
                                {
                                    <span class="chat-unread badge rounded-pill text-bg-danger ms-2 flex-shrink-0" title="@Model.GetText("COMMON", "UNREAD_MSG_TITLE")">@unread</span>
                                }
                            </li>
                        }

                    </ul>
                }
                else
                {
                    <p class="text-secondary mb-0">@Html.LocalizedText("PM", "NO_CONVERSATIONS")</p>
                }

            </div>

        </div>
    </div>

    <div class="col-xl-9">
        <div class="row">
            <div class="col">
                <div id="PriChatDiv"
                     data-placeholder="@Model.GetText("PM", "PLACEHOLDER")"
                     data-send="@Model.GetText("PM", "SEND_TT")"
                     data-you="@Model.GetText("PM", "YOU")"
                     data-delete="@Model.GetText("COMMON", "DELETE")"
                     data-confirm="@Model.GetText("PM", "CONFIRM_DELETE")"
                     data-yes="@Model.GetText("COMMON", "YES")"
                     data-no="@Model.GetText("COMMON", "NO")">
                    @if (!Model.Users.NullOrEmpty())
                    {
                        <div class="card">
                            <div class="card-body text-center">
                                <div class="spinner-border spinner-border" role="status" aria-hidden="true" style="width: 3rem; height: 3rem;">
                                    <span class="visually-hidden">@Html.LocalizedText("COMMON", "LOADING")</span>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="card">
                            <div class="card-body text-center py-5">
                                <i class="fas fa-comments fa-3x text-secondary mb-3"></i>
                                <p class="mb-3">@Html.LocalizedText("PM", "NO_CONVERSATIONS")</p>
                                <button type="button" class="btn btn-primary"
                                        data-bs-toggle="collapse" data-bs-target="#NewConversation"
                                        aria-expanded="false" aria-controls="NewConversation">
                                    <i class="fas fa-plus me-1"></i>@Html.LocalizedText("PM", "NEW_CONVERSATION")
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
	<script src="~/js/messages.min.js" asp-append-version="true" defer></script>

}
