@page "{handler?}"
@using YAF.Web.HtmlHelpers
@using YAF.Types.Constants
@using YAF.Types.Extensions
@using YAF.Types.Objects

@model YAF.Pages.Profile.EditSettingsModel

<div class="row">
	<div class="col-12 col-lg-auto mb-3 mb-lg-0">
		<profileMenu></profileMenu>
	</div>
	<div class="col profile-page">
		<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
			<h2 class="h4 mb-0">@Html.Icon("user-cog")@Html.LocalizedText("EDIT_SETTINGS", "TITLE")</h2>
		</div>

		<form method="post" asp-page="@ForumPages.Profile_EditSettings.GetPageName()">
			<div class="card mb-3">
				<div class="card-header">
					@Html.Icon("sliders-h")@Html.LocalizedText("EDIT_PROFILE", "FORUM_SETTINGS")
				</div>
				<div class="card-body">
					@if (Model.PageBoardContext.BoardSettings.AllowUserHideHimself || Model.PageBoardContext.IsAdmin)
					{
						<div class="mb-3">
							<div class="form-check form-switch">
								<input asp-for="HideMe" class="form-check-input" role="switch" switch/>
								<label asp-for="HideMe" class="form-check-label"
								       localized-page="EDIT_PROFILE"
								       localized-tag="HIDEME">
								</label>
							</div>
						</div>
					}

					<div class="mb-3">
						<div class="form-check form-switch">
							<input asp-for="Activity" class="form-check-input" role="switch" switch/>
							<label asp-for="Activity" class="form-check-label"
							       localized-page="EDIT_PROFILE"
							       localized-tag="ACTIVITY">
							</label>
						</div>
					</div>

					<div class="row">
						<div class="mb-3 col-md-6">
							<label asp-for="TimeZone" localized-page="EDIT_PROFILE" localized-tag="TIMEZONE2" class="form-label">
							</label>
							<select asp-for="TimeZone" class="select2-select">
								@foreach (var item in Model.TimeZones)
								{
									if (item.Selected)
									{
										<option value="@item.Value" selected="selected">@item.Text</option>
									}
									else
									{
										<option value="@item.Value">@item.Text</option>
									}
								}
							</select>
						</div>

						<div class="mb-3 col-md-6">
							<label asp-for="@Model.Size" localized-page="EDIT_PROFILE" localized-tag="SELECT_PAGESIZE" class="form-label">
							</label>
							<select asp-for="@Model.Size" class="select2-select" asp-items="Model.PageSizeList">
							</select>
						</div>

						@if (Model.PageBoardContext.BoardSettings.AllowUserTheme)
						{
							<div class="mb-3 col-md-6">
								<label asp-for="Theme" localized-page="EDIT_PROFILE" localized-tag="SELECT_THEME" class="form-label">
								</label>
								<select asp-for="Theme" class="select2-select">
									@foreach (var item in Model.Themes)
									{
										if (item.Selected)
										{
											<option value="@item.Value" selected="selected">@item.Text</option>
										}
										else
										{
											<option value="@item.Value">@item.Text</option>
										}
									}
								</select>
							</div>
						}

						@if (Model.PageBoardContext.BoardSettings.AllowUserLanguage)
						{
							<div class="mb-3 col-md-6">
								<label asp-for="Language" localized-page="EDIT_PROFILE" localized-tag="SELECT_LANGUAGE" class="form-label">
								</label>
								<select asp-for="Language" class="select2-select">
									@foreach (var item in Model.Languages)
									{
										if (item.Selected)
										{
											<option value="@item.Value" selected="selected">@item.Text</option>
										}
										else
										{
											<option value="@item.Value">@item.Text</option>
										}
									}
								</select>
							</div>
						}
					</div>
				</div>
			</div>

			@if (Model.PageBoardContext.BoardSettings.AllowEmailChange)
			{
				<div class="card mb-3">
					<div class="card-header">
						@Html.Icon("at")@Html.LocalizedText("EDIT_PROFILE", "CHANGE_EMAIL")
					</div>
					<div class="card-body">
						<div class="row">
							<div class="mb-3 col-md-6">
								<label asp-for="Email" localized-page="EDIT_PROFILE" localized-tag="EMAIL" class="form-label">
								</label>
								<input asp-for="Email" class="form-control" autocomplete="off" />
							</div>
							@if (Model.PageBoardContext.MembershipUser.PasswordHash.IsSet())
							{
								<div class="mb-3 col-md-6">
									<label asp-for="CurrentPassword" localized-page="EDIT_PROFILE" localized-tag="CURRENT_PASSWORD" class="form-label">
									</label>
									<input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="current-password" />
								</div>
							}
						</div>
						<div class="form-text">@Html.LocalizedText("EDIT_SETTINGS", "EMAIL_INFO")</div>
					</div>
				</div>
			}

			<div class="profile-edit-actions">
				<a role="button"
				   asp-page="@ForumPages.MyAccount.GetPageName()"
				   button-style="Secondary"
				   icon="reply"
				   text-localized-page="COMMON"
				   text-localized-tag="CANCEL"></a>
				<button type="submit"
				        asp-page="@ForumPages.Profile_EditSettings.GetPageName()"
				        button-style="Primary"
				        icon="save"
				        text-localized-page="COMMON"
				        text-localized-tag="SAVE"></button>
			</div>
		</form>

		@if (Model.Get<BoardConfiguration>().AllowLoginAndLogoff)
		{
			<div class="card mb-3" id="TwoFactor">
				<div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
					<span>
						@Html.Icon("key")@Html.LocalizedText("EDIT_SETTINGS", Model.TwoFactorEnabled ? "DISABLE_TWO_FACTOR_HEADER" : "TWO_FACTOR_HEADER")
					</span>
					<span class="badge @(Model.TwoFactorEnabled ? "text-bg-success" : "text-bg-secondary")" id="TwoFactorStatus">
						@Html.LocalizedText("EDIT_SETTINGS", Model.TwoFactorEnabled ? "TWO_FA_ON" : "TWO_FA_OFF")
					</span>
				</div>
				<div class="card-body">
					<form method="post">
						@if (Model.TwoFactorEnabled)
						{
							<div class="row align-items-end">
								<div class="mb-3 col-md-6">
									<label asp-for="InputCode" class="form-label" localized-page="EDIT_SETTINGS" localized-tag="SETUP_CODE"></label>
									<input type="text" class="form-control" asp-for="InputCode" autocomplete="one-time-code" placeholder="@Html.LocalizedText("TWO_FA_PLACEHOLDER")">
								</div>
								<div class="mb-3 col-md-6">
									<button type="submit"
									        button-style="None"
									        class="btn btn-outline-danger"
									        icon="unlock"
									        asp-page-handler="DisableTwoFa"
									        text-localized-page="EDIT_SETTINGS"
									        text-localized-tag="DISABLE_2FA"></button>
									<input type="hidden" asp-for="TwoFactorKey" />
								</div>
							</div>
						}
						else
						{
							<div class="row">
								<div class="col-md-auto mb-3 text-center">
									<img src="@Model.BarcodeImageUrl" alt="barcode" class="img-fluid two-factor-qr" />
									<div class="small text-body-secondary mt-2 text-break"><code>@Model.SetupCode</code></div>
								</div>
								<div class="col-md">
									<div class="small text-body-secondary mb-3">
										<ul class="mb-0 ps-3">
											@Html.LocalizedText("EDIT_SETTINGS", "INFO")
										</ul>
									</div>
									<div class="mb-3">
										<label asp-for="InputCode" class="form-label" localized-page="EDIT_SETTINGS" localized-tag="SETUP_CODE"></label>
										<input type="text" class="form-control" asp-for="InputCode" autocomplete="one-time-code" placeholder="@Html.LocalizedText("TWO_FA_PLACEHOLDER")">
									</div>
									@if (Model.PageBoardContext.MembershipUser.PasswordHash.IsSet())
									{
										<div class="mb-3">
											<label for="TwoFactorPassword" class="form-label" localized-page="EDIT_PROFILE" localized-tag="CURRENT_PASSWORD"></label>
											<input asp-for="CurrentPassword" id="TwoFactorPassword" type="password" class="form-control" autocomplete="current-password" required />
										</div>
									}
									<button type="submit"
									        button-style="Primary"
									        icon="check"
									        asp-page-handler="EnableTwoFa"
									        text-localized-page="EDIT_SETTINGS"
									        text-localized-tag="ENABLE_2FA"></button>
									<input type="hidden" asp-for="TwoFactorKey" />
								</div>
							</div>
						}
					</form>
				</div>
			</div>
		}
	</div>
</div>

@section Scripts {
	@await Html.PartialAsync("_ChoicesScriptsPartial")
}
