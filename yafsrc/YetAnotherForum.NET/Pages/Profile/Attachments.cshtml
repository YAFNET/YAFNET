@page "{p:int=1}/{handler?}"

@using YAF.Core.Extensions
@using YAF.Web.HtmlHelpers
@using YAF.Types.Extensions
@using YAF.Types.Interfaces
@using YAF.Types.Models
@using YAF.Types.Objects

@model YAF.Pages.Profile.AttachmentsModel

<div class="row">
	<div class="col-12 col-lg-auto mb-3 mb-lg-0">
		<profileMenu></profileMenu>
	</div>
	<div class="col profile-page">
		<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
			<h2 class="h4 mb-0">
				@Html.Icon("paperclip")@Html.LocalizedText("ATTACHMENTS", "TITLE")
				<span class="badge text-bg-secondary align-middle ms-1" id="AttachmentCount">@Model.TotalCount</span>
			</h2>
		</div>
		<form method="post">
			@if (Model.Attachments.NullOrEmpty())
			{
				<div class="card mb-3">
					<div class="card-body text-center">
						<empty icon="paperclip"
						       header-text-page="ATTACHMENTS" header-text-tag="EMPTY_HEADER"
						       message-text-page="ATTACHMENTS" message-text-tag="EMPTY_MESSAGE">
						</empty>
					</div>
				</div>
			}
			else
			{
				<div class="card mb-3">
					<ul class="list-group list-group-flush attachment-list">
						@for (var i = 0; i < Model.Attachments.Count; i++)
						{
							var attachment = Model.Attachments[i];
							var posts = Model.Usages.GetValueOrDefault(attachment.ID) ?? [];

							<li class="list-group-item attachment-row">
								<input type="hidden" asp-for="@Model.Attachments[i].ID" />

								<input asp-for="@Model.Attachments[i].Selected" class="form-check-input flex-shrink-0" title="@Model.GetText("SELECT")" aria-label="@Model.GetText("SELECT")" />

								<span class="attachment-preview">@Model.GetPreviewImage(attachment)</span>

								<label class="attachment-main" asp-for="@Model.Attachments[i].Selected">
									<span class="d-block text-truncate">@attachment.FileName</span>
									<span class="small text-body-secondary">@(Math.Max(1, attachment.Bytes / 1024)) KB</span>
								</label>

								@if (posts.Count > 0)
								{
									var post = posts[0];

									<a class="badge bg-body-tertiary text-body-secondary border text-decoration-none attachment-usage"
									   href="@(Model.Get<ILinkBuilder>().GetLink(ForumPages.Post, new { m = post.MessageId, name = post.TopicName }))"
									   title="@post.TopicName">
										@Html.Icon("comment")@Model.GetTextFormatted("USED_IN", posts.Count)
									</a>
								}
								else
								{
									<span class="badge bg-body-tertiary text-body-secondary border attachment-usage">@Model.GetText("ATTACHMENTS", "NOT_USED")</span>
								}
							</li>
						}
					</ul>
				</div>

				<div class="profile-edit-actions">
					<div class="input-group input-group-sm w-auto">
						<span class="input-group-text">@Html.LocalizedText("SHOW"):</span>
						<select asp-for="@Model.Size"
						        asp-items="Model.PageSizeList"
						        title="@Html.LocalizedText("COMMON", "SHOW_TITLE")"
						        aria-label="@Html.LocalizedText("COMMON", "SHOW_TITLE")"
						        class="form-select"
						        onchange="this.form.submit();"></select>
					</div>
					<button asp-page-handler="DeleteSelected"
					        button-style="Danger"
					        icon="trash"
					        title-localized-page="COMMON"
					        title-localized-tag="BUTTON_DELETEATTACHMENT_TT"
					        text-localized-page="COMMON"
					        text-localized-tag="BUTTON_DELETEATTACHMENT"
					        return-confirm-tag="CONFIRM_DELETE"></button>
				</div>

				@await Html.PartialAsync("_Pagination", new Pagination() { TotalRows = Model.TotalCount, Size = Model.Size })
			}
		</form>
	</div>
</div>

@section Scripts {
	@await Html.PartialAsync("_PostScriptsPartial")
}
