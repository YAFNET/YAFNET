@page "{handler?}"

@using YAF.Web.HtmlHelpers
@using YAF.Types.Extensions

@model YAF.Pages.Profile.BlockOptionsModel

<div class="row">
    <div class="col-12 col-lg-auto mb-3 mb-lg-0">
        <profileMenu></profileMenu>
    </div>
    <div class="col profile-page">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
            <h2 class="h4 mb-0">@Html.Icon("user-lock")@Html.LocalizedText("BLOCK_OPTIONS", "TITLE")</h2>
        </div>

        <form method="post">
            <div class="card mb-3">
                <div class="card-header">
                    @Html.Icon("ban")@Html.LocalizedText("BLOCK_OPTIONS", "BLOCK_OPTIONS")
                </div>
                <div class="card-body">
                    <p class="text-body-secondary small">@Html.LocalizedText("SELECT_OPTIONS")</p>

                    @if (Model.PageBoardContext.BoardSettings.AllowPrivateMessages)
                    {
                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="BlockPMs" class="form-check-input" role="switch" />
                                <label asp-for="BlockPMs" class="form-check-label"
                                       localized-page="BLOCK_OPTIONS"
                                       localized-tag="BLOCK_PMS">
                                </label>
                            </div>
                        </div>
                    }

                    @if (Model.PageBoardContext.BoardSettings.EnableBuddyList)
                    {
                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="BlockFriendRequests" class="form-check-input" role="switch" />
                                <label asp-for="BlockFriendRequests" class="form-check-label"
                                       localized-page="BLOCK_OPTIONS"
                                       localized-tag="BLOCK_BUDDYS">
                                </label>
                            </div>
                        </div>
                    }

                    @if (Model.PageBoardContext.BoardSettings.AllowEmailSending)
                    {
                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="BlockEmails" class="form-check-input" role="switch" />
                                <label asp-for="BlockEmails" class="form-check-label"
                                       localized-page="BLOCK_OPTIONS"
                                       localized-tag="BLOCK_EMAILS">
                                </label>
                            </div>
                        </div>
                    }

                    <div class="form-text">
                        @Html.Icon("info-circle")@Html.LocalizedText("BLOCK_OPTIONS", "NOTE_BLOCK")
                    </div>
                </div>
            </div>

            <div class="profile-edit-actions">
                <a role="button"
                   asp-page="@ForumPages.MyAccount.GetPageName()"
                   button-style="Secondary"
                   icon="reply"
                   text-localized-page="COMMON"
                   text-localized-tag="CANCEL"></a>
                <button type="submit"
                        asp-page="@ForumPages.Profile_BlockOptions.GetPageName()"
                        text-localized-page="COMMON"
                        text-localized-tag="SAVE"
                        button-style="Primary"
                        icon="save"></button>
            </div>
        </form>

        <div class="card mb-3" id="IgnoredUsers">
            <div class="card-header">
                @Html.Icon("eye-slash")@Html.LocalizedText("BLOCK_OPTIONS", "IGNORED_USERS")
                <span class="badge text-bg-secondary ms-1">@(Model.Users?.Count ?? 0)</span>
            </div>
            @if (!Model.Users.NullOrEmpty())
            {
                <ul class="list-group list-group-flush">
                    @foreach (var user in Model.Users)
                    {
                        <li class="list-group-item d-flex flex-wrap align-items-center justify-content-between gap-2">
                            @Html.UserLink(user)
                            <form method="post">
                                <button type="submit"
                                        asp-page-handler="Delete"
                                        asp-route-userId="@user.ID"
                                        button-style="OutlineSecondary"
                                        button-size="Small"
                                        icon="eye"
                                        text-localized-page="POSTS"
                                        text-localized-tag="TOGGLEUSERPOSTS_SHOW">
                                </button>
                            </form>
                        </li>
                    }
                </ul>
                <div class="card-footer small text-body-secondary">
                    @Html.LocalizedText("NOTE_USERS")
                </div>
            }
            else
            {
                <div class="card-body text-center">
                    <empty icon="eye-slash"
                           header-text-page="BLOCK_OPTIONS" header-text-tag="EMPTY_HEADER"
                           message-text-page="BLOCK_OPTIONS" message-text-tag="EMPTY_MESSAGE">
                    </empty>
                </div>
            }
        </div>
    </div>
</div>
