@page "{handler?}"
@using YAF.Types.Extensions
@using YAF.Web.HtmlHelpers
@using YAF.Types.Interfaces

@model YAF.Pages.Profile.EditAvatarModel

<div class="row">
	<div class="col-12 col-lg-auto mb-3 mb-lg-0">
		<profileMenu></profileMenu>
	</div>
	<div class="col profile-page">
		<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
			<h2 class="h4 mb-0">@Html.Icon("user-tie")@Html.LocalizedText("EDIT_AVATAR", "TITLE")</h2>
		</div>
		<div class="row">
			<div class="col-md-4 mb-3">
				<div class="card h-100" id="CurrentAvatar">
					<div class="card-header">
						@Html.Icon("image")@Html.LocalizedText("EDIT_AVATAR", "AvatarModel")
					</div>
					<div class="card-body text-center">
						<img alt="avatar" class="img-thumbnail avatar-current mb-3"
						     style="max-width: @(Model.PageBoardContext.BoardSettings.AvatarWidth)px; max-height: @(Model.PageBoardContext.BoardSettings.AvatarHeight)px;"
						     src="@($"{Model.AvatarUrl}{(Model.AvatarUrl.Contains('?') ? "&" : "?")}v={DateTime.Now.Ticks}")" />
						@if (Model.HasAvatar)
						{
							<form method="post">
								<button button-style="None"
								        class="btn btn-sm btn-outline-danger"
								        icon="trash"
								        type="submit"
								        asp-page-handler="DeleteAvatar"
								        text-localized-page="EDIT_AVATAR"
								        text-localized-tag="AVATARDELETE"
								        return-confirm-tag="AVATARDELETE"></button>
							</form>
						}
						else
						{
							<div class="small text-body-secondary">@Html.LocalizedText("EDIT_AVATAR", "NOAVATAR")</div>
						}
					</div>
				</div>
			</div>
			<div class="col-md-8">
				@if (Model.PageBoardContext.BoardSettings.AvatarUpload)
				{
					<div class="card mb-3" id="AvatarUpload">
						<div class="card-header">
							@Html.Icon("upload")@Html.LocalizedText("EDIT_AVATAR", "AVATARUPLOAD")
						</div>
						<div class="card-body">
							<form method="post" enctype="multipart/form-data">
								<label asp-for="Upload" class="form-label"
								       localized-tag="AVATARUPLOAD"
								       localized-page="EDIT_AVATAR">
								</label>
								<div class="input-group mb-2">
									<input type="file" asp-for="Upload" class="form-control" accept="image/*" />
									<button asp-page-handler="UploadUpdate"
									        type="submit"
									        button-style="Primary"
									        icon="upload"
									        text-localized-page="COMMON"
									        text-localized-tag="SAVE"></button>
								</div>
								<div class="form-text text-break">
									@Html.Icon("info-circle")@Html.Raw(Model.Get<ILocalization>().GetTextFormatted(
										"NOTE_LOCAL",
										Model.PageBoardContext.BoardSettings.AvatarWidth.ToString(),
										Model.PageBoardContext.BoardSettings.AvatarHeight,
										(Model.PageBoardContext.BoardSettings.AvatarSize / 1024).ToString()))
								</div>
							</form>
						</div>
					</div>
				}
				@if (Model.PageBoardContext.BoardSettings.AvatarGallery && Model.Gallery.HasItems())
				{
					<div class="card mb-3" id="AvatarGalleryCard">
						<div class="card-header">
							@Html.Icon("th")@Html.LocalizedText("EDIT_AVATAR", "OURAVATAR")
						</div>
						<div class="card-body">
							<form method="post">
								<div class="mb-3">
									<select asp-for="AvatarGallery" class="select2-image-select" placeholder="@Html.LocalizedText("OURAVATAR")" data-allow-clear="true">
										@foreach (var item in Model.Gallery)
										{
											<option value="@item.Value" item="@item">
												@item.Text
											</option>
										}
									</select>
								</div>
								<button asp-page-handler="Gallery"
								        type="submit"
								        button-style="Primary"
								        icon="save"
								        text-localized-page="COMMON"
								        text-localized-tag="UPDATE"></button>
							</form>
						</div>
					</div>
				}
			</div>
		</div>
	</div>
</div>

@section Scripts {
	@await Html.PartialAsync("_ChoicesScriptsPartial")
}
