@page "{faq=index}/{handler?}"
@using YAF.Web.HtmlHelpers
@using YAF.Types.Interfaces
@model HelpModel

@{
    Model.PageBoardContext.CurrentForumPage.PageTitle = Html.HtmlEncode($"{Model.Get<ILocalization>().GetText("HELP_INDEX", "SUBTITLE")} &#183; {Model.Get<ILocalization>().GetText("HELP_INDEX", HelpModel.TitleTag(Request.RouteValues["faq"]?.ToString()))}").ToString();

    var faq = Request.RouteValues["faq"]?.ToString() ?? "index";
    var isSearch = faq == "search";
    var contents = isSearch
                       ? Model.HelpContents ?? []
                       : (Model.HelpContents ?? []).Where(check => check.HelpPage.ToLower().Equals(faq)).ToList();
}

<div class="container-fluid help-page">
    <div class="row g-0">

        @Html.HelpMenu()

        <div class="col flex-grow-1 ms-lg-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <h2 class="h4 mb-0">@Html.Icon("question-circle")@Html.LocalizedText("HELP_INDEX", "TITLE")</h2>
            </div>

            @if (faq == "index" || isSearch)
            {
                <form method="post" asp-route-faq="search" class="mb-3">
                    <div class="card help-search">
                        <div class="card-body">
                            @if (!isSearch)
                            {
                                <p class="text-body-secondary">
                                    @Html.LocalizedText("HELP_INDEX", "WELCOME")
                                </p>
                            }
                            <label asp-for="Input.Search" class="form-label visually-hidden"
                                   localized-page="HELP_INDEX" localized-tag="SEARCHFOR">
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">@Html.Icon("search", "text-secondary")</span>
                                <input asp-for="Input.Search" class="form-control" type="search"
                                       placeholder="@Model.GetText("HELP_INDEX", "SEARCHFOR").TrimEnd(':')" />
                                <button type="submit" button-style="Primary"
                                        text-localized-page="HELP_INDEX"
                                        text-localized-tag="BTNSEARCH">
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            }

            @foreach (var content in contents)
            {
                <div class="card mb-3 help-topic">
                    <div class="card-header fw-semibold">
                        @Html.Icon("question-circle", "text-primary")
                        @if (isSearch)
                        {
                            @* the title is encoded and the found words are marked *@
                            @Html.Raw(content.Title)
                        }
                        else
                        {
                            @content.Title
                        }
                    </div>
                    <div class="card-body">
                        @Html.Raw(content.Content)
                    </div>
                </div>
            }

            @if (faq == "bbcodes")
            {
                @* the examples are rendered with the BB codes of the board, like in a post *@
                foreach (var group in Model.BBCodeGroups)
                {
                    <div class="card mb-3 help-topic">
                        <div class="card-header fw-semibold">
                            @Html.Icon("code", "text-primary")@group.Title
                        </div>
                        <ul class="list-group list-group-flush">
                            @foreach (var example in group.Examples)
                            {
                                <li class="list-group-item py-3">
                                    <div class="fw-semibold">@example.Title</div>
                                    <div class="text-body-secondary mb-2">@Html.Raw(example.Description)</div>
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <div class="small text-body-secondary mb-1">@Html.LocalizedText("HELP_BBCODES", "YOU_TYPE")</div>
                                            <pre class="bg-body-tertiary border rounded p-2 mb-0 text-break" style="white-space: pre-wrap"><code>@example.Example</code></pre>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="small text-body-secondary mb-1">@Html.LocalizedText("HELP_BBCODES", "RESULT")</div>
                                            <div class="border rounded p-2 message">@Html.Raw(example.Output)</div>
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                }

                if (Model.CustomBBCodes.Count > 0)
                {
                    <div class="card mb-3 help-topic">
                        <div class="card-header fw-semibold">
                            @Html.Icon("puzzle-piece", "text-primary")@Html.LocalizedText("HELP_BBCODES", "GROUP_CUSTOM")
                        </div>
                        <div class="card-body pb-0">
                            <p class="text-body-secondary">@Html.LocalizedText("HELP_BBCODES", "CUSTOM_DESC")</p>
                        </div>
                        <ul class="list-group list-group-flush">
                            @foreach (var code in Model.CustomBBCodes)
                            {
                                <li class="list-group-item">
                                    <div class="fw-semibold">@code.Title</div>
                                    <code class="text-break">@code.Example</code>
                                </li>
                            }
                        </ul>
                    </div>
                }
            }

            @if (faq == "achievements")
            {
                @* the achievements of the board (the ones the user has unlocked are marked) *@
                if (!Model.PageBoardContext.BoardSettings.EnableAchievements)
                {
                    <div class="alert alert-info" role="status">@Html.LocalizedText("ACHIEVEMENTS", "DISABLED")</div>
                }
                else
                {
                    @await Html.PartialAsync(
                        "_AchievementCards",
                        Model.Achievements,
                        new ViewDataDictionary(ViewData) { ["ShowCounts"] = !Model.PageBoardContext.IsGuest })
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    @if (faq == "bbcodes")
    {
        @* code highlighting, spoilers and images like in a post *@
        @await Html.PartialAsync("_PostScriptsPartial")
    }
}
