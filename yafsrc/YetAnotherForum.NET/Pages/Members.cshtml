@page "{handler?}"
@using YAF.Web.HtmlHelpers
@using YAF.Types.Constants
@using YAF.Types.Extensions
@using YAF.Types.Interfaces
@using YAF.Types.Interfaces.Services
@using YAF.Types.Objects
@model MembersModel

@{
    var totalRows = Model.UserList.NullOrEmpty() ? 0 : Model.UserList.FirstOrDefault().TotalRows;

    // the filter stays open while it filters the list
    var isFiltered = Model.Input.Group > 0 || Model.Input.Rank > 0 || Model.Input.NumPosts > 0 || Model.Input.UserSearchName.IsSet();

    // the sort buttons (handler, text and the field of the sort)
    var sorts = new[]
    {
        new[] { ("UserNameAsc", "USERNAME_ASC", Model.Input.SortNameField == 1), ("UserNameDesc", "USERNAME_DESC", Model.Input.SortNameField == 2) },
        new[] { ("RankAsc", "RANK_ASC", Model.Input.SortRankNameField == 1), ("RankDesc", "RANK_DESC", Model.Input.SortRankNameField == 2) },
        new[] { ("JoinedAsc", "JOINED_ASC", Model.Input.SortJoinedField == 1), ("JoinedDesc", "JOINED_DESC", Model.Input.SortJoinedField == 2) },
        new[] { ("PostsAsc", "POSTS_ASC", Model.Input.SortNumPostsField == 1), ("PostsDesc", "POSTS_DESC", Model.Input.SortNumPostsField == 2) },
        new[] { ("LastVisitAsc", "LASTVISIT_ASC", Model.Input.SortLastVisitField == 1), ("LastVisitDesc", "LASTVISIT_DESC", Model.Input.SortLastVisitField == 2) }
    };
}

@* the page size starts at the first page (the form was sent to the current page, a later page was empty) *@
<form method="post" class="members-page" action="@Url.Page("Members", Model.LetterRoute)" asp-antiforgery="true">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h2 class="h4 mb-0">
            @Html.Icon("users")@Html.LocalizedText("MEMBERS", "TITLE")
            <span class="badge rounded-pill bg-secondary-subtle text-secondary-emphasis align-middle ms-1">@totalRows.ToString("N0")</span>
        </h2>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <div class="input-group input-group-sm w-auto" role="group">
                <div class="input-group-text">
                    @Html.LocalizedText("SHOW"):
                </div>
                <select asp-for="@Model.Size"
                        asp-items="Model.PageSizeList"
                        title="@Html.LocalizedText("COMMON", "SHOW_TITLE")"
                        aria-label="@Html.LocalizedText("COMMON", "SHOW_TITLE")"
                        class="form-select"
                        onchange="this.form.submit();"></select>
            </div>

            <button type="button"
                    button-style="@(isFiltered ? ButtonStyle.Primary : ButtonStyle.OutlineSecondary)"
                    button-size="Small"
                    bs-toggle="collapse"
                    bs-target="#MembersFilter"
                    aria-controls="MembersFilter"
                    icon="filter"
                    text-localized-page="ADMIN_USERS"
                    text-localized-tag="FILTER_DROPDOWN"></button>

            <div class="dropdown">
                <button class="dropdown-toggle"
                        button-size="Small"
                        button-style="OutlineSecondary"
                        bs-toggle="dropdown"
                        text-localized-tag="SORT_BY"
                        Icon="sort"></button>
                <div class="dropdown-menu dropdown-menu-end">
                    <input type="hidden" asp-for="Input.SortNameField">
                    <input type="hidden" asp-for="Input.SortRankNameField">
                    <input type="hidden" asp-for="Input.SortJoinedField">
                    <input type="hidden" asp-for="Input.SortNumPostsField">
                    <input type="hidden" asp-for="Input.SortLastVisitField">
                    @for (var group = 0; group < sorts.Length; group++)
                    {
                        if (group > 0)
                        {
                            <div class="dropdown-divider"></div>
                        }

                        foreach (var (handler, text, active) in sorts[group])
                        {
                            <button class="@(active ? "dropdown-item active" : "dropdown-item")"
                                    button-style="None"
                                    asp-page-handler="@handler"
                                    asp-all-route-data="Model.LetterRoute"
                                    icon="@(handler.EndsWith("Asc") ? "sort-alpha-down" : "sort-alpha-down-alt")"
                                    text-localized-page="MEMBERS"
                                    text-localized-tag="@text"></button>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="collapse @(isFiltered ? "show" : "")" id="MembersFilter">
        <div class="card mb-3 members-filter">
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-6 col-lg-3">
                        <label class="form-label" asp-for="Input.UserSearchName" localized-tag="Search_Member">
                        </label>
                        <input asp-for="Input.UserSearchName" type="text" class="form-control" />
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <label class="form-label" asp-for="Input.Group" localized-tag="Search_Role">
                        </label>
                        <select asp-for="Input.Group" class="select2-select" asp-items="Model.GroupsList">
                        </select>
                    </div>
                    <div class="col-md-6 col-lg-2">
                        <label class="form-label" asp-for="Input.Rank" localized-tag="Search_Rank">
                        </label>
                        <select asp-for="Input.Rank" class="select2-select" asp-items="Model.RanksList">
                        </select>
                    </div>
                    <div class="col-md-6 col-lg-2">
                        <label class="form-label" asp-for="Input.NumPostValue" localized-tag="NUMPOSTS">
                        </label>
                        <select asp-for="Input.NumPostValue" class="select2-select" asp-items="Model.NumPostList">
                        </select>
                    </div>
                    <div class="col-md-6 col-lg-2">
                        <input asp-for="Input.NumPosts" class="form-control" type="number" min="0" placeholder="0"
                               aria-label="@Html.LocalizedText("NUMPOSTS")" />
                    </div>
                </div>
                <div class="d-flex flex-wrap justify-content-end gap-2 mt-3">
                    <button asp-page-handler="Reset"
                            text-localized-tag="CLEAR"
                            button-style="Secondary"
                            Icon="xmark">
                    </button>
                    <button asp-page-handler="Search"
                            text-localized-tag="BTNSEARCH"
                            button-style="Primary"
                            Icon="search">
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="members-letters mb-3">
        @Html.AlphaSort(Model.UserList, Model.CurrentLetter)
    </div>

    @if (!Model.UserList.NullOrEmpty())
    {
        <ul class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 list-unstyled mb-3">
            @foreach (var user in Model.UserList)
            {
                var name = Model.PageBoardContext.BoardSettings.EnableDisplayName ? user.DisplayName : user.Name;

                <li class="col member-row">
                    <div class="card h-100">
                        <div class="card-body d-flex gap-3">
                            <img src="@Html.Raw(Model.Get<IAvatars>().GetAvatarUrlForUser(user.UserID, user.Avatar, user.AvatarImage != null))"
                                 alt="@name"
                                 class="rounded member-avatar"/>
                            <div class="member-info">
                                <h5 class="mb-1 text-break">
                                    @Html.UserLink(user.UserID, name, user.Suspended, user.UserStyle)
                                </h5>
                                <div class="member-rank">
                                    @Html.Icon("id-badge", "text-secondary")@user.RankName
                                </div>
                                <dl class="member-stats">
                                    <div>
                                        <dt>@Html.LocalizedText("ADMIN_USERS", "POSTS")</dt>
                                        <dd>@($"{user.NumPosts:N0}")</dd>
                                    </div>
                                    <div>
                                        <dt>@Html.LocalizedText("POSTS", "JOINED")</dt>
                                        <dd>@Html.Raw(Model.Get<IDateTimeService>().FormatDateShort(user.Joined))</dd>
                                    </div>
                                    <div>
                                        <dt>@Html.LocalizedText("ADMIN_USERS", "LAST_VISIT")</dt>
                                        <dd>@Html.Raw(Model.Get<IDateTimeService>().FormatDateShort(user.LastVisit))</dd>
                                    </div>
                                </dl>
                            </div>
                        </div>
                    </div>
                </li>
            }
        </ul>

        @await Html.PartialAsync("_Pagination", new Pagination() { TotalRows = totalRows, Size = Model.Size })
    }
    else
    {
        <div class="card mb-3">
            <div class="card-body">
                @await Html.PartialAsync("_NoEntryInfo")
            </div>
        </div>
    }
</form>

@section Scripts {
    @await Html.PartialAsync("_ChoicesScriptsPartial")
}
