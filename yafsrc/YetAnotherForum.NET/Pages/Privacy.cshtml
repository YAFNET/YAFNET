@page "{handler?}"

@using YAF.Core.Context
@using YAF.Web.HtmlHelpers
@using YAF.Types.Constants
@using YAF.Types.Extensions
@using YAF.Types.Interfaces
@using YAF.Types.Interfaces.Services
@using YAF.Types.Objects
@model PrivacyModel
@{
    ViewBag.Email = Model.Get<BoardConfiguration>().GDPRControllerAddress.IsSet() ?
                        Model.Get<BoardConfiguration>().GDPRControllerAddress :
        Model.PageBoardContext.BoardSettings.ForumEmail;
}

<div class="info-page">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h2 class="h4 mb-0">@Html.Icon("user-secret")@Html.LocalizedText("RULES", "TITLE")</h2>
    </div>
    <div class="card mb-3">
        <div class="card-body info-text">
            @Html.Raw(await Model.Get<IBBCodeService>().MakeHtmlAsync(Model.Get<ILocalization>().GetTextFormatted("RULES_TEXT", (string)ViewBag.Email), true, true))
        </div>
    </div>

    @if (BoardContext.Current.IsGuest)
    {
        <form method="post" class="info-accept-bar">
            <a button-style="Secondary" role="button" asp-page="@ForumPages.Index.GetPageName()"
               icon="hand-paper"
               text-localized-page="RULES"
               text-localized-tag="DECLINE">
            </a>
            <button type="submit" button-style="Success"
                    icon="check"
                    text-localized-page="RULES"
                    text-localized-tag="ACCEPT">
            </button>
        </form>
    }
</div>
