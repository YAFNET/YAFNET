@page "{handler?}"
@using YAF.Core.Helpers
@using YAF.Web.HtmlHelpers
@using YAF.Types.Extensions
@using YAF.Types.Interfaces;
@using YAF.Core.Utilities;
@model IndexModel
@{
    // the buttons of a category page act on the forums of the category, the category is a query value
    var categoryRoute = Model.PageBoardContext.PageCategoryID > 0
                            ? new Dictionary<string, string> { { "c", Model.PageBoardContext.PageCategoryID.ToString() } }
                            : new Dictionary<string, string>();
}

@if (Model.PageBoardContext.PageCategoryID > 0 && Model.PageBoardContext.PageCategory is not null)
{
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h2 class="h4 mb-0">@Html.Icon("folder")@Model.PageBoardContext.PageCategory.Name</h2>
    </div>
}

@* guests only see the clock, it is hidden on small screens *@
<div class="@(Model.PageBoardContext.IsGuest ? "index-toolbar d-none d-md-flex" : "index-toolbar")">
    <div class="index-clock d-none d-md-inline-flex">
        @Html.Icon("clock")
        @Model.TimeNow

        @if (Model.LastVisit.IsSet())
        {
            <span class="mx-1"></span>
            @Html.IconBadge("calendar-day", "clock")
            @Model.LastVisit
        }
    </div>

    @if (!Model.PageBoardContext.IsGuest)
    {
        <form method="post">
            <div class="btn-group btn-group-sm" role="group" aria-label="Tools">
                <button asp-page-handler="WatchAll"
                        asp-all-route-data="categoryRoute"
                        button-style="OutlineSecondary"
                        button-size="Small"
                        icon="eye"
                        bs-toggle="tooltip"
                        text-localized-page="COMMON"
                        text-localized-tag="WATCHFORUM_ALL"
                        title-localized-page="COMMON"
                        title-localized-tag="WATCHFORUM_ALL">
                </button>

                <button asp-page-handler="MarkAll"
                        asp-all-route-data="categoryRoute"
                        button-style="OutlineSecondary"
                        button-size="Small"
                        icon="glasses"
                        bs-toggle="tooltip"
                        text-localized-page="COMMON"
                        text-localized-tag="MARKALL"
                        title-localized-page="COMMON"
                        title-localized-tag="MARKALL">
                </button>
            </div>
        </form>
    }
</div>

<div class="row">

    <div class="@Html.Raw(Model.PageBoardContext.BoardSettings.TwoColumnBoardLayout ? "col-md-8" : "col")">

        <div id="category-list"
             data-load-more-url="@Url.Page("", "ShowMore", Model.PageBoardContext.PageCategoryID > 0 ? new { c = Model.PageBoardContext.PageCategoryID } : null)"
             data-refresh-url="@Url.Page("", "RefreshCategories", Model.PageBoardContext.PageCategoryID > 0 ? new { c = Model.PageBoardContext.PageCategoryID } : null)"
             data-forum-icon-legend-content="@((await Html.PartialAsync("_ForumIconLegend")).RenderToString())">
            @await Html.PartialAsync("_CategoryList", Model.Categories)
        </div>
        <input type="hidden" value="0" id="category-index" />

    </div>

    @if (!this.Model.PageBoardContext.BoardSettings.TwoColumnBoardLayout)
    {
        @Html.Raw("</div><div class=\"row row-discussions\">")
    }

    <div class="@Html.Raw(Model.PageBoardContext.BoardSettings.TwoColumnBoardLayout ? "col-md-4" : "col")">
        <div id="active-discussions" data-refresh-url="@Url.Page("", "ActiveDiscussions", Model.PageBoardContext.PageCategoryID > 0 ? new { c = Model.PageBoardContext.PageCategoryID } : null)">
            @await Html.PartialAsync("_ActiveDiscussions")
        </div>
        @await Html.PartialAsync("_ForumStatsUsers")
    </div>
</div>

@if (Model.PageBoardContext.BoardSettings.ShowForumStatistics)
{
    <div class="row row-stats">
        <div class="col">
            @await Html.PartialAsync("_BoardStatistics")
        </div>
    </div>
}

@section Scripts
{
    <script src="~/js/forum-index.min.js" asp-append-version="true" defer></script>
    <script>
        @Html.Raw(
                 JsAndCssHelper.CompressJavaScript(
                 JavaScriptBlocks.ForumIconLegendPopoverJs((await Html.PartialAsync("_ForumIconLegend")).RenderToString().ToJsString(),
                 "forum-icon-legend-popvover")))
    </script>
}
