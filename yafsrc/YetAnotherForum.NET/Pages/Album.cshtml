@page "{u:int}/{a:int}/{p:int=1}/{handler?}"

@using YAF.Core.Extensions
@using YAF.Core.Model
@using YAF.Web.HtmlHelpers
@using YAF.Types.Constants
@using YAF.Types.Extensions
@using YAF.Types.Interfaces
@using YAF.Types.Models
@model AlbumModel

@{
    var imagesCount = !Model.Images.NullOrEmpty() ? Model.GetRepository<UserAlbumImage>().List(Model.Images[0].AlbumID).Count.ToType<int>() : 0;
    var isOwn = Model.PageBoardContext.PageUserID == Model.AlbumUser.ID;
}

<div class="album-page">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h2 class="h4 mb-0 text-break">
            @Html.Icon("images")@Model.GetTextFormatted("ALBUMS_TITLE", Model.AlbumUser.DisplayOrUserName(), Html.StoredText(Model.Album.Title))
            <span class="badge text-bg-secondary align-middle ms-1" id="ImageCount">@imagesCount</span>
        </h2>
        <div class="d-flex flex-wrap gap-2">
            @if (isOwn)
            {
                <a role="button" button-style="Primary"
                   button-size="Small"
                   icon="edit"
                   text-localized-page="BUTTON"
                   text-localized-tag="BUTTON_EDITALBUMIMAGES"
                   href="@Html.Raw(Model.Get<ILinkBuilder>().GetLink(ForumPages.EditAlbumImages, new { a = Model.Album.ID }))"></a>
            }
            <a role="button" button-style="OutlineSecondary"
               button-size="Small"
               icon="arrow-circle-left"
               text-localized-page="BUTTON"
               text-localized-tag="BACK_ALBUMS"
               href="@Html.Raw(Model.Get<ILinkBuilder>().GetLink(ForumPages.Albums, new { u = Model.AlbumUser.ID }))"></a>
        </div>
    </div>

    <form method="post">
        <div class="album-grid album-image-grid mb-3">
            @foreach (var image in Model.Images)
            {
                var isCover = Model.Album.CoverImageID == image.ID;
                var title = image.Caption.IsSet() ? Html.StoredText(image.Caption) : image.FileName;

                <div class="card album-card @(isCover ? "is-cover" : string.Empty)" data-image-id="@image.ID">
                    <a href="@Html.Raw(Model.Get<IUrlHelper>().Action("GetImage", "Albums", new { imageId = image.ID }))"
                       title="@title"
                       class="album-cover-link"
                       data-toggle="lightbox"
                       data-gallery="@Model.Album.ID"
                       data-caption="@Html.StoredText(image.Caption)">
                        <img src="@Html.Raw(Model.Get<IUrlHelper>().Action("GetImagePreview", "Albums", new { imageId = image.ID }))"
                             class="album-cover"
                             alt="@title" />
                    </a>
                    @if (isCover)
                    {
                        <span class="badge text-bg-primary album-cover-badge">@Html.Icon("tag")@Html.LocalizedText("ALBUM", "COVER")</span>
                    }
                    <div class="card-body">
                        @if (isOwn)
                        {
                            var caption = image.Caption.IsNotSet() ? Model.Get<ILocalization>().GetText("ALBUM_IMAGE_CHANGE_CAPTION") : Html.StoredText(image.Caption);

                            <div class="album-title text-break">
                                @Html.Icon("pen", "text-secondary")
                                <a class="album-image-caption" data-type="text"
                                   id="@image.ID"
                                   data-id="@image.ID"
                                   data-url="/api/Album/ChangeImageCaption"
                                   data-title="@Html.LocalizedText(image.Caption.IsNotSet() ? "ALBUM_IMAGE_CHANGE_CAPTION" : "ALBUM_IMAGE_CHANGE_CAPTION2")">@caption</a>
                            </div>
                        }
                        else if (image.Caption.IsSet())
                        {
                            <div class="album-title text-break">@Html.StoredText(image.Caption)</div>
                        }
                        <div class="album-footer">
                            @if (isOwn)
                            {
                                @if (isCover)
                                {
                                    <button type="submit"
                                            asp-page-handler="RemoveCover"
                                            asp-route-u="@Model.AlbumUser.ID"
                                            asp-route-a="@image.AlbumID"
                                            button-style="OutlineSecondary"
                                            button-size="Small"
                                            text-localized-tag="BUTTON_RESETCOVER"
                                            class="btn-cover"
                                            icon="xmark"></button>
                                }
                                else
                                {
                                    <button type="submit"
                                            asp-page-handler="SetCover"
                                            asp-route-u="@Model.AlbumUser.ID"
                                            asp-route-a="@image.AlbumID"
                                            asp-route-id="@image.ID"
                                            button-style="OutlineSecondary"
                                            button-size="Small"
                                            text-localized-tag="BUTTON_SETCOVER"
                                            class="btn-cover"
                                            icon="tag"></button>
                                }
                            }
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary ms-auto album-copy"
                                    data-copy="@($"[ALBUMIMG]{image.ID}[/ALBUMIMG]")"
                                    data-copied="@Model.GetText("ALBUM", "COPIED")"
                                    title="@Model.GetText("ALBUM", "COPY_BBCODE")"
                                    aria-label="@Model.GetText("ALBUM", "COPY_BBCODE")">
                                @Html.Icon("copy", marginEnd: false)
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </form>

    @if (imagesCount > Model.PageBoardContext.BoardSettings.AlbumImagesPerPage)
    {
        <div class="d-flex justify-content-end mb-3">
            <pager page-size="@Model.PageBoardContext.BoardSettings.AlbumImagesPerPage" use-submit="false"
                   count="@imagesCount">
            </pager>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/albums.min.js" asp-append-version="true" defer></script>
}
