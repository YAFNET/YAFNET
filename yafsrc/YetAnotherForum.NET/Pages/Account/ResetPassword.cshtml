@page
@using YAF.Core.Helpers
@using YAF.Core.Utilities
@using YAF.Types.Interfaces
@using YAF.Web.HtmlHelpers
@model YAF.Pages.Account.ResetPasswordModel

<div class="account-page">
    <div class="card account-card">
        <div class="card-body">
            <div class="account-head">
                <span class="account-icon">@Html.Icon("key")</span>
                <h1 class="account-title">@Html.LocalizedText("ACCOUNT_RESEST_PASSWORD", "TITLE")</h1>
                <p class="account-subtitle">@Html.LocalizedText("ACCOUNT_RESEST_PASSWORD", "INFO")</p>
            </div>
            <form method="post" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label"
                           localized-page="LOGIN" localized-tag="EMAIL">
                    </label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="email" autofocus required />
                    <div class="invalid-feedback">
                        @Html.LocalizedText("REGISTER", "NEED_EMAIL")
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label"
                           localized-page="ACCOUNT_RESEST_PASSWORD" localized-tag="PASSWORD">
                    </label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" required />
                    <div class="invalid-feedback">
                        @Html.LocalizedText("REGISTER", "NEED_PASSWORD")
                    </div>
                    <div class="d-none mt-2" id="passwordStrength">
                        <div class="progress" style="height: .375rem">
                            <div id="progress-password"
                                 class="progress-bar"
                                 role="progressbar"
                                 aria-label="password strength"
                                 aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                            </div>
                        </div>
                        <small class="form-text text-body-secondary" id="passwordHelp"></small>
                    </div>
                </div>
                <div class="mb-4">
                    <label asp-for="Input.ConfirmPassword" class="form-label"
                           localized-page="ACCOUNT_RESEST_PASSWORD" localized-tag="CONFIRM_PASSWORD">
                    </label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" required />
                    <div class="invalid-feedback" id="PasswordInvalid">
                        @Html.LocalizedText("REGISTER", "RETYPE_PASSWORD")
                    </div>
                </div>
                <div class="d-grid">
                    <button type="submit" button-style="Primary"
                            icon="key"
                            text-localized-page="ACCOUNT_RESEST_PASSWORD"
                            text-localized-tag="TITLE">
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        @Html.Raw(JsAndCssHelper.CompressJavaScript(JavaScriptBlocks.PasswordStrengthCheckerJs(
            "Input_Password",
            "Input_ConfirmPassword",
            Model.PageBoardContext.BoardSettings.MinRequiredPasswordLength,
            Model.Get<ILocalization>().GetText("REGISTER", "PASSWORD_NOTMATCH"),
            Model.Get<ILocalization>().GetTextFormatted("REGISTER", "PASSWORD_MIN", Model.PageBoardContext.BoardSettings.MinRequiredPasswordLength),
            Model.Get<ILocalization>().GetText("REGISTER", "PASSWORD_GOOD"),
            Model.Get<ILocalization>().GetText("REGISTER", "PASSWORD_STRONGER"),
            Model.Get<ILocalization>().GetText("REGISTER", "PASSWORD_WEAK"))))
    </script>
}
