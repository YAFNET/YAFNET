@page

@using YAF.Web.HtmlHelpers
@using YAF.Types.Extensions
@model ApproveModel

<div class="row mb-3">
    <div class="col">
        <div class="card mx-auto rounded-4 shadow" style="max-width:450px">
            <div class="card-body p-4 m-4">
                <section>
                    <h1 class="fw-bold mb-4 fs-2">@Html.IconHeader("user-check", "APPROVE", "TITLE")</h1>

                    @if (Model.ErrorMessage.IsSet())
                    {
                        <alert type="danger"
                               icon="info-circle"
                               icon-text-color="text-danger"
                               message="@Model.ErrorMessage">
                        </alert>
                    }
                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="Input.Key" localized-page="APPROVE" localized-tag="ENTER_KEY" class="form-label">
                            </label>
                            <input asp-for="Input.Key" class="form-control" required />
                        </div>
                        <div class="mb-3 d-grid gap-2">
                            <button type="submit"
                                    button-style="Primary"
                                    icon="check"
                                    text-localized-page="APPROVE"
                                    text-localized-tag="VALIDATE">
                            </button>
                        </div>
                    </form>
                </section>
            </div>
        </div>
    </div>
</div>