@page

@using YAF.Web.HtmlHelpers
@using YAF.Types.Extensions
@model ApproveModel

<div class="account-page">
    <div class="card account-card">
        <div class="card-body">
            <div class="account-head">
                <span class="account-icon">@Html.Icon("user-check")</span>
                <h1 class="account-title">@Html.LocalizedText("APPROVE", "TITLE")</h1>
                <p class="account-subtitle">@Html.LocalizedText("APPROVE", "INFO")</p>
            </div>

            @if (Model.ErrorMessage.IsSet())
            {
                <alert type="danger"
                       icon="exclamation-triangle"
                       message="@Model.ErrorMessage">
                </alert>
            }
            <form method="post">
                <div class="mb-4">
                    <label asp-for="Input.Key" localized-page="APPROVE" localized-tag="ENTER_KEY" class="form-label">
                    </label>
                    <input asp-for="Input.Key" class="form-control font-monospace" autocomplete="off" autofocus required />
                </div>
                <div class="d-grid">
                    <button type="submit"
                            button-style="Primary"
                            icon="check"
                            text-localized-page="APPROVE"
                            text-localized-tag="VALIDATE">
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
