@page "{handler?}"
@using YAF.Types.Constants
@using YAF.Types.Extensions
@using YAF.Types.Objects
@using YAF.Web.HtmlHelpers
@model YAF.Pages.Account.ForgotPasswordModel

<div class="account-page">
    <div class="card account-card">
        <div class="card-body">
            <div class="account-head">
                <span class="account-icon">@Html.Icon("key")</span>
                <h1 class="account-title">@Html.LocalizedText("LOGIN", "LOSTPASSWORD")</h1>
                <p class="account-subtitle">@Html.LocalizedText("LOGIN", "PAGE1_INSTRUCTIONS")</p>
            </div>
            <form method="post" class="needs-validation" novalidate>
                <div class="mb-4">
                    <label asp-for="Input.UserName" localized-page="LOGIN" localized-tag="USERNAME" class="form-label">
                    </label>
                    <div class="input-group has-validation">
                        <span class="input-group-text">
                            @Html.Icon("user", "text-secondary")
                        </span>
                        <input asp-for="Input.UserName" class="form-control" autocomplete="username" autofocus required />
                        <div class="invalid-feedback">
                            @Html.LocalizedText("LOGIN", "NEED_USERNAME")
                        </div>
                    </div>
                </div>
                <div class="d-grid">
                    <button type="submit" button-style="Primary"
                            text-localized-page="LOGIN" text-localized-tag="RECOVER"
                            icon="paper-plane">
                    </button>
                </div>
            </form>
            @if (Model.Get<BoardConfiguration>().AllowLoginAndLogoff)
            {
                <div class="account-footer">
                    <a asp-page="@ForumPages.Account_Login.GetPageName()" id="BackToLogin">
                        @Html.Icon("arrow-left")@Html.LocalizedText("LOGIN", "BACK_TO_LOGIN")
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptPartial")
}
