@page "{f:int}/{name}/{p:int=1}/{handler?}"
@using YAF.Core.Extensions
@using YAF.Core.Helpers
@using YAF.Core.Model
@using YAF.Core.Services
@using YAF.Core.Utilities
@using YAF.Web.HtmlHelpers
@using YAF.Types.Constants
@using YAF.Types.Extensions
@using YAF.Types.Interfaces
@using YAF.Types.Interfaces.Services
@using YAF.Types.Models

@model TopicsModel

@{
    var totalTopics = Model.Topics.NullOrEmpty() ? 0 : Model.Topics.FirstOrDefault().TotalRows;
}

<div class="topics-header">
    <div class="topics-header-title">
        <h2 class="h4 mb-1">
            @Html.Icon("comments")@Model.PageBoardContext.PageForum.Name
            <span class="badge rounded-pill bg-secondary-subtle text-secondary-emphasis align-middle ms-1"
                  title="@Html.LocalizedText("TOPICS", "TOPICS")">@totalTopics.ToString("N0")</span>
            @if (Model.PageBoardContext.PageForum.ForumFlags.IsLocked)
            {
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle align-middle"
                      title="@Html.LocalizedText("TOPICS", "WARN_FORUM_LOCKED")">@Html.Icon("lock")</span>
            }
        </h2>
        @if (Model.PageBoardContext.PageForum.Description.IsSet())
        {
            <div class="topics-header-description">@Model.PageBoardContext.PageForum.Description</div>
        }
    </div>
    <div class="topics-header-actions">
        @if (Model.PageBoardContext.ForumModeratorAccess)
        {
            <a role="button" button-style="Secondary"
               icon="tasks"
               text-localized-tag="BUTTON_MODERATE"
               title-localized-tag="BUTTON_MODERATE_TT"
               href="@Html.Raw(Model.Get<ILinkBuilder>().GetLink(ForumPages.Moderate_Forums, new { f = Model.PageBoardContext.PageForumID }))"></a>
        }

        @if (Model.PageBoardContext.ForumPostAccess && (!Model.PageBoardContext.PageForum.ForumFlags.IsLocked || Model.PageBoardContext.ForumModeratorAccess))
        {
            <a role="button" button-style="Primary"
               icon="plus"
               text-localized-tag="BUTTON_NEWTOPIC"
               title-localized-tag="BUTTON_NEWTOPIC_TT"
               href="@Html.Raw(Model.Get<ILinkBuilder>().GetLink(ForumPages.PostTopic, new { f = Model.PageBoardContext.PageForumID }))"></a>
        }
    </div>
</div>

@if (Model.SubForums != null && Model.SubForums.HasItems())
{
    <div class="row">
        <div class="col">
            <div class="card mb-3">
                <div class="card-header">
                    <div class="row justify-content-between align-items-center">
                        <div class="col-auto">
                            @Html.IconHeader("comments", "TOPICS", "SUBFORUMS")
                        </div>
                        <div class="col-auto">
                            <form method="post">
                                <button button-style="Link"
                                        asp-page-handler="ToggleCollapse"
                                        asp-route-target="@Html.Raw($"forumPanel{Model.PageBoardContext.PageForumID}")"
                                        type="submit"
                                        class="btn px-0"
                                        bs-toggle="collapse"
                                        data-bs-target="@Html.Raw($"#forumPanel{Model.PageBoardContext.PageForumID}")"
                                        aria-label="collapse"
                                        aria-expanded="false"
                                        aria-controls="@Html.Raw($"forumPanel{Model.PageBoardContext.PageForumID}")">
                                    @Html.Icon(
                                        CollapsePanelHelper.GetCollapsiblePanelIcon($"forumPanel{Model.PageBoardContext.PageForumID}", Model.PageBoardContext.BoardSettings.DefaultCollapsiblePanelState),
                                        "text-primary")
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="card-body collapse @Html.Raw(Model.Get<ISessionService>().PanelState[$"forumPanel{Model.PageBoardContext.PageForumID}"] == CollapsiblePanelState.Expanded ? "show" : "")"
                     id="@Html.Raw($"forumPanel{Model.PageBoardContext.PageForumID}")">
                    @await Html.PartialAsync("_ForumList", Model)
                </div>
            </div>
        </div>
    </div>
}

@* the filters of the list and the tools of the forum *@
<div class="topics-toolbar mb-3">
    <div class="topics-toolbar-filters">
        <form method="post" asp-page-handler="PageSize" asp-route-f="@Model.PageBoardContext.PageForumID">
            <div class="input-group input-group-sm">
                <span class="input-group-text">@Html.LocalizedText("SHOW"):</span>
                <select asp-for="@Model.Size"
                        asp-items="Model.PageSizeList"
                        title="@Html.LocalizedText("COMMON", "SHOW_TITLE")"
                        aria-label="@Html.LocalizedText("COMMON", "SHOW_TITLE")"
                        class="form-select"
                        onchange="this.form.submit();"></select>
            </div>
            <input type="hidden" name="@nameof(Model.ShowTopicListSelected)" value="@Model.ShowTopicListSelected" />
        </form>

        <form method="post" asp-page-handler="ShowList" asp-route-f="@Model.PageBoardContext.PageForumID" class="topics-toolbar-since">
            <select asp-for="@Model.ShowTopicListSelected"
                    asp-items="Model.ShowList"
                    class="select2-select"
                    aria-label="@Html.LocalizedText("SHOWTOPICS")"
                    onchange="this.form.submit();"></select>
            <input type="hidden" name="@nameof(Model.Size)" value="@Model.Size" />
        </form>

        @if (Model.Get<IPermissions>().Check(Model.PageBoardContext.BoardSettings.SearchPermissions))
        {
            <form method="post" asp-page-handler="ForumSearch" asp-route-f="@Model.PageBoardContext.PageForumID">
                <div class="input-group input-group-sm">
                    <input type="search" id="forumSearch" name="forumSearch" class="form-control"
                           placeholder="@Html.LocalizedText("SEARCH_FORUM")"
                           aria-label="@Html.LocalizedText("SEARCH_FORUM")"/>
                    <button type="submit" button-style="OutlineSecondary"
                            button-size="Small"
                            icon="search"
                            title-localized-tag="OK_TT"></button>
                </div>
            </form>
        }
    </div>

    <div class="topics-toolbar-tools">
        @if (Model.PageBoardContext.BoardSettings.ShowForumJump)
        {
            <div class="topics-toolbar-jump">
                <select id="ForumJump" aria-label="@Html.LocalizedText("FORUM_JUMP")"></select>
            </div>
        }

        @if (!Model.PageBoardContext.IsGuest && Model.PageBoardContext.ForumReadAccess)
        {
            // check if this forum is being watched by this user
            var watchForumId = await Model.GetRepository<WatchForum>().CheckAsync(Model.PageBoardContext.PageUserID, Model.PageBoardContext.PageForumID);

            <form method="post" class="btn-group btn-group-sm" role="group">
                <button asp-page-handler="WatchForum"
                        asp-route-f="@RouteData.Values["f"]"
                        button-style="OutlineSecondary"
                        button-size="Small"
                        icon="@(watchForumId.HasValue ? "eye-slash" : "eye")"
                        text-localized-tag="@(watchForumId.HasValue ? "UNWATCHFORUM" : "WATCHFORUM")">
                </button>

                <button asp-page-handler="MarkRead"
                        asp-route-f="@RouteData.Values["f"]"
                        button-style="OutlineSecondary"
                        button-size="Small"
                        icon="glasses"
                        text-localized-page="COMMON"
                        text-localized-tag="MARKREAD">
                </button>
            </form>
        }

        @* only a forum with moderators (the list was empty) *@
        @if ((await Model.Get<DataBroker>().GetModeratorsAsync()).Exists(x => x.ForumID == Model.PageBoardContext.PageForumID))
        {
            <button button-style="OutlineSecondary"
                    button-size="Small"
                    bs-toggle="popover"
                    class="forum-mods-popover"
                    bs-content="@await Html.GetModeratorsAsync(Model.PageBoardContext.PageForumID)"
                    text-localized-page="DEFAULT"
                    text-localized-tag="MODERATORS"
                    icon="user-secret"></button>
        }

        @if (Model.Get<IPermissions>().Check(Model.PageBoardContext.BoardSettings.TopicsFeedAccess))
        {
            @Html.RssFeedLink(RssFeeds.Topics, true)
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-body topic-list"
         id="topicsContainer"
         data-load-more-url="@Url.Page("Topics", "LoadMoreTopics", new { f = Model.PageBoardContext.PageForumID, name = Model.PageBoardContext.PageForum.Name })"
         data-live-url="@(Model.PageBoardContext.PageIndex == 0 ? Url.Page("Topics", "LiveTopics", new { f = Model.PageBoardContext.PageForumID, name = Model.PageBoardContext.PageForum.Name }) : null)"
         data-forum-id="@Model.PageBoardContext.PageForumID"
         data-next-page="@(Model.PageBoardContext.PageIndex + 1)"
         data-page-size="@Model.Size"
         data-show="@Model.ShowTopicListSelected"
         data-total="@totalTopics"
         data-loaded-count="@Model.Topics.Count"
         data-icon-legend-content="@((await Html.PartialAsync("_TopicIconLegend")).RenderToString())">
        @if (!Model.Announcements.HasItems() && !Model.Topics.HasItems())
        {
	                <p class="text-center">@Html.Icon("comments", "text-secondary", iconSize: "fa-3x")</p>
            <p class="text-center lead">@Html.LocalizedText("TOPICS", "NO_TOPICS")</p>
        }

        @foreach (var topic in Model.Announcements)
        {
            @Html.TopicContainer(topic, false)
        }

        @foreach (var topic in Model.Topics)
        {
            @Html.TopicContainer(topic, false)
        }

        <div id="topicsLoadMoreSentinel" class="text-center py-3">
            <div class="spinner-border spinner-border-sm text-secondary d-none" role="status">
                <span class="visually-hidden">@Html.LocalizedText("COMMON", "LOADING")</span>
            </div>
        </div>
    </div>
</div>

@if (Model.PageBoardContext.BoardSettings.ShowBrowsingUsers)
{
    <div class="row mb-3">
        <div class="col">
            @await Html.PartialAsync("_ForumPageUsers")
        </div>
    </div>
}

@section Scripts {
    @await Html.PartialAsync("_ChoicesScriptsPartial")
    <script src="~/js/topics.min.js" asp-append-version="true" defer></script>
    <script>
        @Html.Raw(JsAndCssHelper.CompressJavaScript(JavaScriptBlocks.ForumModsPopoverJs(
                    $"<i class=\"fa fa-user-secret text-secondary\"></i>&nbsp;{Model.Get<ILocalization>().GetText("DEFAULT", "MODERATORS")} ...")))

        @Html.Raw(JsAndCssHelper.CompressJavaScript(
            JavaScriptBlocks.ForumIconLegendPopoverJs(
                    (await Html.PartialAsync("_ForumIconLegend")).RenderToString().ToJsString(),
                    "forum-icon-legend-popvover")))

        @Html.Raw(JsAndCssHelper.CompressJavaScript(
            JavaScriptBlocks.SelectForumsLoadJs(
                    "ForumJump",
                    Model.Get<ILocalization>().GetText("FORUM_JUMP_PLACEHOLDER"),
                    true,
                    false)))
    </script>
}