@page "{t:int}"

@using YAF.Types.Interfaces
@using YAF.Types.Interfaces.Services
@model PrintTopicModel

@foreach (var post in Model.Posts)
{
    <table class="table table-bordered" aria-label="@post.Topic">
        <thead>
        <tr>
            <th scope="col">
                    <strong>@(Model.Get<ILocalization>().GetText("postedby")): @(Model.PageBoardContext.BoardSettings.EnableDisplayName ? post.DisplayName : post.UserName)</strong> - @Html.Raw(Model.Get<IDateTimeService>().FormatDateTime(post.Posted))
            </th>
        </tr>
        </thead>
        <tbody>
        <tr>
            <td>
                @Html.Raw(post.Message)
            </td>
        </tr>
        </tbody>
    </table>
    <br/>
}