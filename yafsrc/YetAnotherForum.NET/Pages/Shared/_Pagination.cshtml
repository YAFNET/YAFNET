@using YAF.Core.Context
@using YAF.Web.HtmlHelpers

@model YAF.Types.Objects.Pagination

@{
	var showingFrom = Model.TotalRows == 0 ? 0 : BoardContext.Current.PageIndex * Model.Size + 1;
	var showingTo = Math.Min((BoardContext.Current.PageIndex + 1) * Model.Size, Model.TotalRows);
}

<div class="row justify-content-between align-items-center">
	<div class="col-auto">
		<p class="text-secondary">
			@Html.LocalizedTextFormatted("SHOWING_X_TO_X_OF_X", showingFrom, showingTo, Model.TotalRows)
		</p>
	</div>
	<div class="col-auto">
		<pager page-size="@Model.Size" count="@Model.TotalRows">
		</pager>
	</div>
</div>