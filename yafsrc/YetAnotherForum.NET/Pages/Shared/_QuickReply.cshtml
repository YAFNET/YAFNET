@using YAF.Core.Context
@using YAF.Types.Extensions
@using YAF.Types.Interfaces.Services
@using YAF.Web.HtmlHelpers
@model YAF.Types.Modals.QuickReplyModal

@inject BoardContext Current

@{
    var avatarUrl = Current.IsGuest ? null : Current.Get<IAvatars>().GetAvatarUrlForCurrentUser();
}

@* the reply box below the posts: the avatar of the user next to the editor, the options and the post button below it *@
<div class="card quick-reply">
    <div class="card-header quick-reply-header">
        @Html.Icon("reply")
        <span>@Html.LocalizedText("QUICKREPLY")</span>
    </div>
    <div class="card-body" id="quickReply">
        <form asp-controller="PostsModal" asp-action="Reply" asp-route-t="@Current.PageTopicID" asp-route-f="@Current.PageForumID">
            <input name="IsValid" type="hidden" value="@ViewData.ModelState.IsValid.ToString()" />
            <div class="quick-reply-body">
                @if (avatarUrl.IsSet())
                {
                    <img src="@avatarUrl" alt="" class="quick-reply-avatar d-none d-sm-block" />
                }
                <div class="quick-reply-editor">
                    <textarea asp-for="QuickReplyEditor"
                              class="form-control"
                              rows="6"
                              cols="100"
                              title="@Html.LocalizedText("QUICKREPLY")"
                              editor-mode="QuickReply"
                              users-can-upload="false"
                              maxlength="@Current.BoardSettings.MaxPostSize"
                              max-characters="@Current.BoardSettings.MaxPostSize" required></textarea>
                </div>
            </div>
            <div class="quick-reply-actions">
                @if (!Current.IsGuest)
                {
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" role="switch" switch asp-for="TopicWatch">
                        <label class="form-check-label" asp-for="TopicWatch" localized-tag="TOPICWATCH"></label>
                    </div>
                }
                <button button-style="Primary" data-bs-save="quickReply" type="button"
                        text-localized-tag="SAVE" text-localized-page="POSTMESSAGE"
                        Icon="reply"
                        class="quick-reply-post">
                </button>
            </div>
        </form>
    </div>
</div>
