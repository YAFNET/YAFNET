@page "{m:int}/{handler?}"
@using YAF.Types.Constants
@using YAF.Types.Interfaces
@using YAF.Web.HtmlHelpers
@model ReportPostModel

@{
    Model.PageBoardContext.CurrentForumPage.PageTitle = Html.Encode(Model.Get<ILocalization>().GetText("HEADER"));
}

<form method="post" class="needs-validation post-action-page" novalidate>
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h2 class="h4 mb-0">@Html.Icon("exclamation-triangle")@Html.LocalizedText("REPORTPOST", "HEADER")</h2>
    </div>

    <div class="card mb-3 post-action-preview">
        <div class="card-header">
            <div class="fw-semibold text-break">@Model.PageBoardContext.PageTopic.TopicName</div>
            <div class="post-action-meta">
                <span>@Html.Icon("user")@Html.LocalizedText("POSTEDBY") @Html.UserLink(Model.MessageAuthor)</span>
                <span>@Html.Icon("clock")@Html.DisplayDateTime(DateTimeFormat.Both, Model.PageBoardContext.PageMessage.Posted)</span>
            </div>
        </div>
        <div class="card-body post-action-body">
            <messagePostData show-attachments="false" show-signature="false" current-message="@Model.PageBoardContext.PageMessage"></messagePostData>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <label asp-for="Report" localized-tag="ENTER_TEXT" class="form-label"></label>
            <textarea asp-for="Report" class="form-control" rows="3" maxlength="@Model.PageBoardContext.BoardSettings.MaxReportPostChars" required="required" autofocus
                      data-counter="#ReportCounter"></textarea>
            <div class="invalid-feedback">
                @Html.LocalizedText("NEED_REASON")
            </div>
            <div class="form-text text-end" id="ReportCounter" data-max="@Model.PageBoardContext.BoardSettings.MaxReportPostChars">
                0 / @Model.PageBoardContext.BoardSettings.MaxReportPostChars
            </div>
        </div>
    </div>

    <div class="post-action-bar">
        <a role="button"
           href="@Html.Raw(Model.Get<ILinkBuilder>().GetMessageLink(Model.PageBoardContext.PageTopic, Model.PageBoardContext.PageMessage.ID))"
           button-style="Secondary"
           icon="reply"
           text-localized-page="COMMON"
           text-localized-tag="CANCEL"></a>
        <button type="submit"
                asp-page-handler="Report"
                asp-route-m="@Model.PageBoardContext.PageMessage.ID"
                button-style="Danger"
                icon="paper-plane"
                return-confirm-tag="CONFIRM_REPORTPOST"
                text-localized-page="REPORTPOST"
                text-localized-tag="SEND"
                title-localized-page="REPORTPOST"
                title-localized-tag="SEND_TITLE"></button>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptPartial")
    <script>
        document.querySelectorAll("[data-counter]").forEach(field => {
            const counter = document.querySelector(field.dataset.counter);
            const update = () => counter.textContent = `${field.value.length} / ${counter.dataset.max}`;
            field.addEventListener("input", update);
            update();
        });
    </script>
}
