@page "{handler?}"
@using YAF.Web.HtmlHelpers
@using YAF.Types.Extensions

@model NotificationModel

<form method="post">
    <div class="row">
        <div class="col-sm-auto">
            <profileMenu></profileMenu>
        </div>
        <div class="col">
            <div class="row">
                <div class="col">
                    <div class="card mb-3" id="activity">
                        <div class="card-header">
                            @Html.IconHeader("bell", "NOTIFICATION", "YOUR_NOTIFIY")
                        </div>
                        <div class="card-body border-bottom py-2" id="notificationFilters">
	                        <div class="d-flex flex-wrap align-items-center gap-2">
		                        <span class="text-muted">@Html.LocalizedText("FILTER_DROPDOWN"):</span>
                                <div class="btn-group flex-wrap" role="group" aria-label="Filters">
                                    <input asp-for="WasMentioned" class="btn-check" autocomplete="off" />
                                    <label asp-for="WasMentioned" class="btn btn-outline-primary btn-sm">
                                        @Html.Icon("at")@Html.LocalizedText("NOTIFICATION", "WAS_MENTIONED")
                                    </label>
                                    <input asp-for="ReceivedThanks" class="btn-check" autocomplete="off" />
                                    <label asp-for="ReceivedThanks" class="btn btn-outline-primary btn-sm">
                                        @Html.Icon("heart")@Html.LocalizedText("NOTIFICATION", "RECEIVED_THANKS")
                                    </label>
                                    <input asp-for="WasQuoted" class="btn-check" autocomplete="off" />
                                    <label asp-for="WasQuoted" class="btn btn-outline-primary btn-sm">
                                        @Html.Icon("quote-left")@Html.LocalizedText("NOTIFICATION", "WAS_QUOTED")
                                    </label>
                                    <input asp-for="WatchForumReply" class="btn-check" autocomplete="off" />
                                    <label asp-for="WatchForumReply" class="btn btn-outline-primary btn-sm">
                                        @Html.Icon("comments")@Html.LocalizedText("NOTIFICATION", "WATCH_FORUM_REPLY")
                                    </label>
                                    <input asp-for="WatchTopicReply" class="btn-check" autocomplete="off" />
                                    <label asp-for="WatchTopicReply" class="btn btn-outline-primary btn-sm">
                                        @Html.Icon("comment")@Html.LocalizedText("NOTIFICATION", "WATCH_TOPIC_REPLY")
                                    </label>
                                    <input asp-for="BecomeFriends" class="btn-check" autocomplete="off" />
                                    <label asp-for="BecomeFriends" class="btn btn-outline-primary btn-sm">
                                        @Html.Icon("user-group")@Html.LocalizedText("ACCOUNT", "BECOME_FRIENDS")
                                    </label>
                                </div>
                                <button type="submit"
                                        asp-page-handler="Reset"
                                        text-localized-tag="CLEAR"
                                        button-style="Secondary"
                                        button-size="Small"
                                        Icon="trash">
                                </button>
                            </div>
                        </div>
                        <ul class="list-group list-group-flush @(Model.Notifications.NullOrEmpty() ? "d-none" : string.Empty)"
                            id="notificationsContainer"
                            data-load-more-url="@Url.Page("Notification", "LoadMoreNotifications")"
                            data-page-size="@Model.Size"
                            data-loaded-count="@Model.Notifications.Count">
                            @if (!Model.Notifications.NullOrEmpty())
                            {
                                @await Html.PartialAsync("_NotificationListItems", Model.Notifications)
                            }
                            <li id="notificationsLoadMoreSentinel" class="list-group-item border-0 text-center py-3 d-none">
                                <div class="spinner-border spinner-border-sm text-secondary d-none" role="status">
                                    <span class="visually-hidden">@Html.LocalizedText("COMMON", "LOADING")</span>
                                </div>
                            </li>
                        </ul>
                        <div class="card-body @(Model.Notifications.NullOrEmpty() ? string.Empty : "d-none")" id="notificationsEmpty">
                            @await Html.PartialAsync("_NoEntryInfo")
                        </div>

                        <div class="card-footer">
                            <div class="row justify-content-end align-items-center">
                                <div class="col-auto">
                                    <div class="btn-group" role="group" aria-label="Tools">
                                        <button asp-page-handler="MarkAll"
                                                text-localized-tag="MARK_ALL_ASREAD" text-localized-page="DEFAULT"
                                                button-style="Secondary"
                                                button-size="Small"
                                                Icon="glasses"></button>
                                    </div>
                                </div>
                            </div>


                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/notification.min.js" asp-append-version="true" defer></script>
}
