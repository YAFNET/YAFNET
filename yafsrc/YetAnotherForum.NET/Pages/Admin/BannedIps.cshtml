@page "{p:int=1}/{handler?}"

@model BannedIpsModel
@using YAF.Core.Extensions
@using YAF.Core.Helpers
@using YAF.Core.Utilities
@using YAF.Types.Extensions
@using YAF.Types.Interfaces
@using YAF.Types.Interfaces.Services
@using YAF.Types.Models
@using YAF.Types.Objects
@using YAF.Web.HtmlHelpers

<div class="admin-spam">

@Html.SpamProtectionNav()

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h2 class="h4 mb-0">
        @Html.Icon("network-wired")@Html.LocalizedText("ADMIN_BANNEDIP", "TITLE")
        <span class="badge text-bg-secondary align-middle ms-1 spam-count">@Model.TotalRows</span>
    </h2>
    <div class="d-flex flex-wrap gap-2 spam-actions">
        <button Icon="plus-square"
                button-style="Primary"
                button-size="Small"
                bs-toggle="ajax-modal"
                bs-target-url="@Url.Page("BannedIps", "Add")"
                text-localized-tag="ADD_IP" text-localized-page="ADMIN_BANNEDIP"></button>
        <button Icon="upload"
                button-style="Secondary"
                button-size="Small"
                bs-toggle="ajax-modal"
                bs-target-url="@Url.Page("BannedIps", "Import")"
                text-localized-tag="IMPORT_IPS" text-localized-page="ADMIN_BANNEDIP"></button>
        @if (Model.PageBoardContext.BoardSettings.AbuseIpDbApiKey.IsSet())
        {
            <button asp-page-handler="ImportMostRecent"
                    form="SpamList"
                    button-style="Secondary"
                    button-size="Small"
                    class="btn-spinner"
                    Icon="cloud-download-alt"
                    title-localized-page="ADMIN_BANNEDIP" title-localized-tag="IMPORT_BLACKLIST_HELP"
                    text-localized-page="ADMIN_BANNEDIP" text-localized-tag="IMPORT_BLACKLIST"></button>
        }
        <button asp-page-handler="Export"
                form="SpamList"
                button-style="Secondary"
                button-size="Small"
                Icon="download"
                text-localized-page="ADMIN_BANNEDIP" text-localized-tag="EXPORT"></button>
        <button type="button"
                button-style="OutlineSecondary"
                button-size="Small"
                bs-toggle="collapse"
                bs-target="#BanTest"
                Icon="vial"
                text-localized-tag="SPAM_TEST" text-localized-page="ADMINMENU"></button>
    </div>
</div>

@await Html.PartialAsync("_BanTestBox", Model.TestBox)

<form method="post" id="SpamList">
    @* Enter in the search field searches *@
    <button type="submit" asp-page-handler="Search" asp-route-p="1" class="visually-hidden" tabindex="-1" aria-hidden="true"></button>

    <div class="d-flex flex-wrap align-items-center gap-2 mb-3 spam-search">
        <div class="input-group input-group-sm flex-grow-1">
            <span class="input-group-text">@Html.Icon("search")</span>
            <input type="search" asp-for="SearchInput" class="form-control"
                   placeholder="@Html.LocalizedText("ADMIN_BANNEDIP", "MASK")"
                   aria-label="@Html.LocalizedText("ADMIN_BANNEDIP", "MASK")" />
            <button button-style="Secondary"
                    button-size="Small"
                    asp-page-handler="Search"
                    asp-route-p="1"
                    Icon="search"
                    text-localized-tag="BTNSEARCH" text-localized-page="SEARCH"></button>
            @if (Model.SearchInput.IsSet())
            {
                <button button-style="OutlineSecondary"
                        button-size="Small"
                        asp-page-handler="Clear"
                        asp-route-p="1"
                        Icon="times"
                        text-localized-tag="CLEAR"></button>
            }
        </div>
        <div class="input-group input-group-sm w-auto">
            <span class="input-group-text">@Html.LocalizedText("SHOW"):</span>
            <select asp-for="@Model.Size"
                    asp-items="Model.PageSizeList"
                    title="@Html.LocalizedText("COMMON", "SHOW_TITLE")"
                    aria-label="@Html.LocalizedText("COMMON", "SHOW_TITLE")"
                    class="form-select"
                    onchange="this.form.submit();"></select>
        </div>
    </div>

    @if (!Model.List.NullOrEmpty())
    {
        <ul class="list-group mb-3 spam-list">
            @foreach (var item in Model.List)
            {
                var user = item.UserID.HasValue ? await Model.GetRepository<User>().GetByIdAsync(item.UserID.Value) : null;

                <li class="list-group-item list-group-item-menu spam-row">
                    <input type="hidden" id="fID" value="@item.ID" />
                    <div class="spam-row-main">
                        <a class="spam-mask font-monospace"
                           href="@string.Format(Model.PageBoardContext.BoardSettings.IPInfoPageURL, IPHelper.GetIpAddressAsString(item.Mask))"
                           title="@Html.LocalizedText("COMMON", "TT_IPDETAILS")"
                           target="_blank" rel="noopener">@IPHelper.GetIpAddressAsString(item.Mask)</a>
                        @if (item.Reason.IsSet())
                        {
                            <div class="spam-reason small text-body-secondary">@item.Reason</div>
                        }
                        @if (user is not null)
                        {
                            <div class="small text-body-secondary">
                                @Html.LocalizedText("REPORTEDBY") @Html.UserLabel(user)
                            </div>
                        }
                    </div>
                    <div class="spam-row-since small text-body-secondary">
                        @Html.Icon("calendar-day")@(Model.Get<IDateTimeService>().FormatDateTime(item.Since))
                    </div>
                    <div class="btn-group btn-group-sm spam-row-actions">
                        <button button-style="Info"
                                button-size="Small"
                                bs-toggle="ajax-modal"
                                bs-target-url="@(Url.Page("BannedIps", "Edit", new { id = item.ID }))"
                                text-localized-tag="EDIT"
                                title-localized-tag="EDIT"
                                Icon="edit"></button>
                        <button button-style="Danger"
                                button-size="Small"
                                asp-page-handler="Delete"
                                asp-route-id="@item.ID"
                                text-localized-tag="DELETE"
                                return-confirm-tag="MSG_DELETE"
                                title-localized-tag="DELETE"
                                Icon="trash"></button>
                    </div>
                    <div class="dropdown-menu context-menu" aria-labelledby="context menu">
                        <button button-style="None"
                                class="dropdown-item"
                                bs-toggle="ajax-modal"
                                bs-target-url="@(Url.Page("BannedIps", "Edit", new { id = item.ID }))"
                                text-localized-tag="EDIT"
                                title-localized-tag="EDIT"
                                Icon="edit"></button>
                        <button button-style="None"
                                class="dropdown-item"
                                asp-page-handler="Delete"
                                asp-route-id="@item.ID"
                                text-localized-tag="DELETE"
                                return-confirm-tag="MSG_DELETE"
                                title-localized-tag="DELETE"
                                Icon="trash"></button>
                        <div class="dropdown-divider"></div>
                        <button Icon="plus-square"
                                button-style="None"
                                class="dropdown-item"
                                text-localized-tag="ADD_IP" text-localized-page="ADMIN_BANNEDIP"
                                bs-toggle="ajax-modal"
                                bs-target-url="@(Url.Page("BannedIps", "Add"))"></button>
                        <div class="dropdown-divider"></div>
                        <button Icon="upload"
                                button-style="None"
                                class="dropdown-item"
                                bs-toggle="ajax-modal"
                                bs-target-url="@(Url.Page("BannedIps", "Import"))"
                                text-localized-tag="IMPORT_IPS" text-localized-page="ADMIN_BANNEDIP"></button>
                        <button asp-page-handler="Export"
                                button-style="None"
                                class="dropdown-item"
                                Icon="download"
                                text-localized-page="ADMIN_BANNEDIP" text-localized-tag="EXPORT"></button>
                    </div>
                </li>
            }
        </ul>

        @await Html.PartialAsync("_Pagination", new Pagination { TotalRows = Model.TotalRows, Size = Model.Size })
    }
    else if (Model.SearchInput.IsSet())
    {
        <div class="alert alert-info">@Html.LocalizedText("ADMINMENU", "SPAM_NO_MATCHES")</div>
    }
    else
    {
        <div class="card mb-3">
            <div class="card-body">
                <empty icon="network-wired"
                       header-text-page="ADMIN_BANNEDIP" header-text-tag="EMPTY_HEADER"
                       message-text-page="ADMIN_BANNEDIP" message-text-tag="EMPTY_MESSAGE">
                </empty>
            </div>
        </div>
    }
</form>

</div>

@section Scripts {
    <script>
        @Html.Raw(JsAndCssHelper.CompressJavaScript(JavaScriptBlocks.ModalNotifyJs()));

        @Html.Raw(JsAndCssHelper.CompressJavaScript(
            JavaScriptBlocks.DialogFunctionsJs(JavaScriptBlocks.ToolTipJs)))
    </script>
}
