@page "{handler?}"

@model ReplaceWordsModel
@using YAF.Core.Helpers
@using YAF.Core.Utilities
@using YAF.Types.Extensions
@using YAF.Web.HtmlHelpers

<div class="admin-replace-words">

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h2 class="h4 mb-0">
        @Html.Icon("spell-check")@Html.LocalizedText("ADMIN_REPLACEWORDS", "TITLE")
        <span class="badge text-bg-secondary align-middle ms-1">@(Model.List?.Count ?? 0)</span>
    </h2>
    <div class="d-flex flex-wrap gap-2 replace-words-actions">
        <button Icon="plus-square"
                button-style="Primary"
                button-size="Small"
                bs-toggle="ajax-modal"
                bs-target-url="@Url.Page("ReplaceWords", "Add")"
                text-localized-tag="ADD" text-localized-page="ADMIN_REPLACEWORDS"></button>
        <button Icon="upload"
                button-style="Secondary"
                button-size="Small"
                bs-toggle="ajax-modal"
                bs-target-url="@Url.Page("ReplaceWords", "Import")"
                text-localized-tag="IMPORT" text-localized-page="ADMIN_REPLACEWORDS"></button>
        <button asp-page-handler="Export"
                form="ReplaceWordsList"
                button-style="Secondary"
                button-size="Small"
                Icon="download"
                text-localized-tag="EXPORT" text-localized-page="ADMIN_REPLACEWORDS"></button>
        <button type="button"
                button-style="OutlineSecondary"
                button-size="Small"
                bs-toggle="collapse"
                bs-target="#ReplaceTest"
                Icon="vial"
                text-localized-tag="SPAM_TEST" text-localized-page="ADMINMENU"></button>
    </div>
</div>

@* the text after the replacements (an own form, Enter tests the text) *@
<div class="collapse@(Model.TestResult is not null ? " show" : "")" id="ReplaceTest">
    <form method="post" class="card card-body mb-3">
        <label class="form-label fw-semibold" for="TestInput">
            @Html.Icon("vial")@Html.LocalizedText("ADMINMENU", "SPAM_TEST")
        </label>
        <div class="input-group">
            <input type="text" class="form-control" id="TestInput" name="TestInput"
                   value="@Model.TestInput" maxlength="1000"
                   placeholder="@Html.LocalizedText("ADMIN_REPLACEWORDS", "TEST_PLACEHOLDER")" />
            <button button-style="Secondary"
                    asp-page-handler="Test"
                    Icon="vial"
                    text-localized-tag="SPAM_TEST" text-localized-page="ADMINMENU"></button>
        </div>
        <div class="form-text">@Html.LocalizedText("ADMIN_REPLACEWORDS", "TEST_HELP")</div>

        @if (Model.TestResult is not null)
        {
            <div class="alert @(Model.TestResult == Model.TestInput ? "alert-secondary" : "alert-info") mt-3 mb-0 replace-test-result" role="status">
                <div class="small fw-semibold">@Html.LocalizedText("ADMIN_REPLACEWORDS", "TEST_RESULT")</div>
                <div class="text-break replace-test-text">@Model.TestResult</div>
            </div>
        }
    </form>
</div>

<form method="post" id="ReplaceWordsList">
    @if (Model.List.NullOrEmpty())
    {
        <div class="card mb-3">
            <div class="card-body">
                <empty icon="spell-check"
                       header-text-page="ADMIN_REPLACEWORDS" header-text-tag="EMPTY_HEADER"
                       message-text-page="ADMIN_REPLACEWORDS" message-text-tag="EMPTY_MESSAGE">
                </empty>
            </div>
        </div>
    }
    else
    {
        <ul class="list-group mb-3">
            @foreach (var item in Model.List)
            {
                <li class="list-group-item list-group-item-menu replace-word-row">
                    <div class="replace-word-main">
                        <code class="replace-word-bad" title="@Html.LocalizedText("ADMIN_REPLACEWORDS", "BAD")">@item.BadWord</code>
                        <span class="text-body-secondary" aria-hidden="true">@Html.Icon("arrow-right")</span>
                        <span class="replace-word-good" title="@Html.LocalizedText("ADMIN_REPLACEWORDS", "GOOD")">@item.GoodWord</span>
                    </div>
                    <div class="btn-group btn-group-sm">
                        <button button-style="Info"
                                button-size="Small"
                                bs-toggle="ajax-modal"
                                bs-target-url="@(Url.Page("ReplaceWords", "Edit", new { id = item.ID }))"
                                text-localized-tag="EDIT"
                                title-localized-tag="EDIT"
                                Icon="edit"></button>
                        <button button-style="Danger"
                                button-size="Small"
                                asp-page-handler="Delete"
                                asp-route-id="@item.ID"
                                text-localized-tag="DELETE"
                                title-localized-tag="DELETE"
                                Icon="trash"
                                return-confirm-tag="MSG_DELETE"></button>
                    </div>
                    <div class="dropdown-menu context-menu" aria-labelledby="context menu">
                        <button button-style="None"
                                class="dropdown-item"
                                bs-toggle="ajax-modal"
                                bs-target-url="@(Url.Page("ReplaceWords", "Edit", new { id = item.ID }))"
                                text-localized-tag="EDIT"
                                title-localized-tag="EDIT"
                                Icon="edit"></button>
                        <button button-style="None"
                                class="dropdown-item"
                                asp-page-handler="Delete"
                                asp-route-id="@item.ID"
                                text-localized-tag="DELETE"
                                title-localized-tag="DELETE"
                                Icon="trash"
                                return-confirm-tag="MSG_DELETE"></button>
                        <div class="dropdown-divider"></div>
                        <button bs-toggle="ajax-modal"
                                bs-target-url="@(Url.Page("ReplaceWords", "Add"))"
                                button-style="None"
                                class="dropdown-item"
                                Icon="plus-square"
                                text-localized-tag="ADD" text-localized-page="ADMIN_REPLACEWORDS"></button>
                        <div class="dropdown-divider"></div>
                        <button Icon="upload"
                                bs-toggle="ajax-modal"
                                bs-target-url="@Url.Page("ReplaceWords", "Import")"
                                button-style="None"
                                class="dropdown-item"
                                text-localized-tag="IMPORT" text-localized-page="ADMIN_REPLACEWORDS"></button>
                        <button asp-page-handler="Export"
                                button-style="None"
                                class="dropdown-item"
                                Icon="download"
                                text-localized-tag="EXPORT" text-localized-page="ADMIN_REPLACEWORDS"></button>
                    </div>
                </li>
            }
        </ul>
    }
</form>

</div>

@section Scripts {
    <script>
        @Html.Raw(JsAndCssHelper.CompressJavaScript(JavaScriptBlocks.ModalNotifyJs()));

        @Html.Raw(JsAndCssHelper.CompressJavaScript(
            JavaScriptBlocks.DialogFunctionsJs(JavaScriptBlocks.ToolTipJs)))
    </script>
}
