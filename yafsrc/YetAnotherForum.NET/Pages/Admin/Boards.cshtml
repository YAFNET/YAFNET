@page "{handler?}"
@model BoardsModel
@using YAF.Types.Constants
@using YAF.Types.Extensions
@using YAF.Types.Interfaces.Services
@using YAF.Types.Objects
@using YAF.Web.HtmlHelpers

@{
	var currentBoardId = Model.PageBoardContext.PageBoardID;

	// a board without users has no start date
	Func<BoardStat, string> boardStart = stat => stat is null || stat.BoardStart <= DateTime.MinValue.AddDays(1)
		? null
		: Model.Get<IDateTimeService>().FormatDateLong(stat.BoardStart);

	// the key figures of a board as (icon, color, label, value)
	Func<BoardStat, (string Icon, string Color, string Label, int Value)[]> figures = stat =>
	[
		("users", "success", Model.GetText("ADMIN_BOARDS", "USERS"), stat?.Users ?? 0),
		("comments", "info", Model.GetText("ADMIN_BOARDS", "TOPICS"), stat?.Topics ?? 0),
		("comment", "primary", Model.GetText("ADMIN_BOARDS", "POSTS"), stat?.Posts ?? 0),
		("layer-group", "warning", Model.GetText("ADMIN_BOARDS", "FORUMS"), stat?.Forums ?? 0)
	];
}

<form method="post" class="admin-boards">
	<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
		<h2 class="h4 mb-0">
			@Html.IconHeader("globe", "ADMIN_BOARDS", "TITLE")
			@if (!Model.List.NullOrEmpty())
			{
				<span class="badge rounded-pill text-bg-secondary align-middle">@Model.List.Count</span>
			}
		</h2>
		<a asp-page="@ForumPages.Admin_EditBoard.GetPageName()"
		   button-style="Primary"
		   text-localized-tag="NEW_BOARD"
		   Icon="plus-square"></a>
	</div>

	@if (Model.List.NullOrEmpty())
	{
		<div class="card mb-3">
			<div class="card-body">
				<empty icon="globe"
				       header-text-page="ADMIN_BOARDS" header-text-tag="EMPTY_HEADER"
				       message-text-page="ADMIN_BOARDS" message-text-tag="EMPTY_MESSAGE">
				</empty>
			</div>
		</div>
	}
	else
	{
		<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 mb-3">
			@foreach (var board in Model.List)
			{
				var isCurrent = board.ID == currentBoardId;
				var stat = Model.Stats.GetValueOrDefault(board.ID);
				var since = boardStart(stat);
				var culture = Model.Cultures.GetValueOrDefault(board.ID);

				<div class="col">
					<div class="card board-card h-100 @(isCurrent ? "board-card-current" : "")" data-board-id="@board.ID">
						<div class="card-body d-flex flex-column">
							<div class="d-flex align-items-start justify-content-between gap-2 mb-1">
								<h3 class="h5 card-title mb-0 text-break">
									@Html.HtmlEncode(board.Name)
								</h3>
								<span class="badge bg-body-tertiary text-body-secondary border text-nowrap"
								      title="@Model.GetText("ADMIN_BOARDS", "ID")">#@board.ID</span>
							</div>

							<div class="d-flex flex-wrap gap-1 mb-2">
								@if (isCurrent)
								{
									<span class="badge text-bg-primary">
										@Html.Icon("star")@Html.LocalizedText("ADMIN_BOARDS", "CURRENT_BOARD")
									</span>
								}
								@if (culture.IsSet())
								{
									<span class="badge text-bg-secondary">
										@Html.Icon("language")@culture
									</span>
								}
							</div>

							@if (board.Description.IsSet())
							{
								<p class="card-text board-description text-body-secondary" title="@board.Description">
									@Html.HtmlEncode(board.Description)
								</p>
							}
							else
							{
								<p class="card-text board-description text-body-tertiary fst-italic">
									@Html.LocalizedText("ADMIN_BOARDS", "NO_DESCRIPTION")
								</p>
							}

							<div class="row row-cols-2 row-cols-sm-4 g-2 mt-auto">
								@foreach (var figure in figures(stat))
								{
									<div class="col">
										<div class="board-figure">
											<span class="@($"board-figure-icon bg-{figure.Color}-subtle text-{figure.Color}-emphasis")">
												@Html.Icon(figure.Icon, marginEnd: false)
											</span>
											<span class="board-figure-value">@($"{figure.Value:N0}")</span>
											<span class="board-figure-label">@figure.Label</span>
										</div>
									</div>
								}
							</div>

							@if (since.IsSet())
							{
								<div class="board-since mt-2">
									@Html.Icon("calendar-day")@string.Format(Model.GetText("ADMIN_BOARDS", "SINCE"), since)
								</div>
							}
						</div>
						<div class="card-footer d-flex flex-wrap gap-2 justify-content-end">
							<a button-style="Primary"
							   button-size="Small"
							   asp-page="@ForumPages.Admin_EditBoard.GetPageName()"
							   asp-route-b="@board.ID"
							   title-localized-tag="EDIT"
							   text-localized-tag="EDIT"
							   Icon="edit">
							</a>
							@if (isCurrent)
							{
								@* a disabled button shows no tooltip, the wrapper does *@
								<span class="d-inline-block" tabindex="0"
								      data-bs-toggle="tooltip"
								      data-bs-title="@Model.GetText("ADMIN_BOARDS", "CURRENT_BOARD_NO_DELETE")">
									<button type="button" class="btn btn-sm btn-outline-danger" disabled>
										@Html.Icon("trash")@Html.LocalizedText("ADMIN_BOARDS", "DELETE")
									</button>
								</span>
							}
							else
							{
								<button type="button" class="btn btn-sm btn-outline-danger"
								        data-bs-toggle="modal"
								        data-bs-target="#deleteBoard@(board.ID)">
									@Html.Icon("trash")@Html.LocalizedText("ADMIN_BOARDS", "DELETE")
								</button>
							}
						</div>
					</div>
				</div>
			}

			<div class="col">
				<a asp-page="@ForumPages.Admin_EditBoard.GetPageName()"
				   class="card board-card-new h-100 text-decoration-none">
					<span class="card-body d-flex flex-column align-items-center justify-content-center gap-2">
						@Html.Icon("plus", iconSize: "fa-2x", marginEnd: false)
						<span class="fw-semibold">@Html.LocalizedText("ADMIN_BOARDS", "NEW_BOARD")</span>
					</span>
				</a>
			</div>
		</div>
	}
</form>

@* the delete dialogs are outside of the page form, each dialog has its own form *@
@if (!Model.List.NullOrEmpty())
{
	foreach (var board in Model.List.Where(b => b.ID != currentBoardId))
	{
		var stat = Model.Stats.GetValueOrDefault(board.ID);
		var inputId = $"confirmName{board.ID}";

		<div class="modal fade admin-boards-delete" id="deleteBoard@(board.ID)" tabindex="-1"
		     aria-labelledby="deleteBoardTitle@(board.ID)" aria-hidden="true">
			<div class="modal-dialog modal-dialog-centered">
				<form method="post" asp-page-handler="Delete" asp-route-id="@board.ID" class="modal-content">
					<div class="modal-header">
						<h5 class="modal-title" id="deleteBoardTitle@(board.ID)">
							@Html.Icon("exclamation-triangle", "text-danger")@Html.LocalizedText("ADMIN_BOARDS", "CONFIRM_DELETE")
						</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal"
						        aria-label="@Model.GetText("CANCEL")"></button>
					</div>
					<div class="modal-body">
						<div class="alert alert-danger mb-3" role="alert">
							@Html.Raw(string.Format(
								Model.GetText("ADMIN_BOARDS", "DELETE_WARNING"),
								$"<strong>{Html.Encode(board.Name)}</strong>"))
						</div>
						<ul class="list-group list-group-horizontal-sm mb-3 text-center">
							@foreach (var figure in figures(stat))
							{
								<li class="list-group-item flex-fill">
									<div class="fw-bold">@($"{figure.Value:N0}")</div>
									<small class="text-body-secondary">@figure.Label</small>
								</li>
							}
						</ul>
						<label class="form-label" for="@inputId">
							@Html.Raw(string.Format(
								Model.GetText("ADMIN_BOARDS", "DELETE_CONFIRM_LABEL"),
								$"<code class=\"user-select-all\">{Html.Encode(board.Name)}</code>"))
						</label>
						<input type="text" id="@inputId" name="confirmName" class="form-control"
						       autocomplete="off" spellcheck="false" required
						       data-confirm-name="@board.Name" />
					</div>
					<div class="modal-footer">
						<button type="button" button-style="Secondary" Icon="xmark"
						        data-bs-dismiss="modal" text-localized-tag="CANCEL"></button>
						<button type="submit" class="btn btn-danger" data-confirm-submit disabled>
							@Html.Icon("trash")@Html.LocalizedText("ADMIN_BOARDS", "DELETE")
						</button>
					</div>
				</form>
			</div>
		</div>
	}
}

@section Scripts {
	<script src="~/js/admin-boards.min.js" asp-append-version="true"></script>
}
