@page "{handler?}"

@using YAF.Web.HtmlHelpers
@model YAF.Pages.Admin.RestartAppModel

<div class="admin-restart-app">
	<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
		<h2 class="h4 mb-0">
			@Html.Icon("sync")@Html.LocalizedText("ADMIN_RESTARTAPP", "TITLE")
		</h2>
	</div>

	<div class="row justify-content-center">
		<div class="col-lg-8 col-xl-6">
			@if (Model.IsRestarting)
			{
				<div class="card mb-3 restart-status">
					<div class="card-body text-center">
						<div id="RestartPending">
							<div class="spinner-border text-primary mb-3" role="status" aria-hidden="true"></div>
							<p class="mb-0" role="status">
								@Html.LocalizedText("ADMIN_RESTARTAPP", "RESTARTING")
							</p>
						</div>
						<div id="RestartTimeout" class="alert alert-warning d-none mb-0" role="alert">
							@Html.LocalizedText("ADMIN_RESTARTAPP", "RESTART_TIMEOUT")
						</div>
					</div>
				</div>
			}
			else
			{
				<form method="post">
					<div class="card mb-3 border-warning-subtle restart-card">
						<div class="card-header bg-warning-subtle text-warning-emphasis">
							@Html.Icon("triangle-exclamation")@Html.LocalizedText("ADMIN_RESTARTAPP", "WARNING_HEADER")
						</div>
						<div class="card-body">
							<p>@Html.LocalizedText("ADMIN_RESTARTAPP", "INFO")</p>
							<p class="text-body-secondary mb-0">@Html.LocalizedText("ADMIN_RESTARTAPP", "WARNING")</p>
						</div>
						<div class="card-footer d-flex justify-content-end">
							<button type="submit"
							        button-style="Warning"
							        text-localized-page="ADMIN_RESTARTAPP"
							        text-localized-tag="TITLE"
							        icon="sync"></button>
						</div>
					</div>
				</form>
			}
		</div>
	</div>
</div>

@section Scripts {
	@if (Model.IsRestarting)
	{
		<script>
			(function () {
				const targetUrl = '@Html.Raw(Model.Get<ILinkBuilder>().GetLink(ForumPages.Admin_Admin))';
				const startedAt = Date.now();
				const timeout = 120000;

				const poll = function () {
					fetch(targetUrl, { cache: 'no-store', credentials: 'same-origin' })
						.then(function (response) {
							if (response.ok) {
								window.location.href = targetUrl;
							} else {
								retry();
							}
						})
						.catch(retry);
				};

				const retry = function () {
					if (Date.now() - startedAt > timeout) {
						document.getElementById('RestartPending').classList.add('d-none');
						document.getElementById('RestartTimeout').classList.remove('d-none');
						return;
					}

					setTimeout(poll, 2000);
				};

				// the server stops ~1 second after this page was sent, don't poll the old instance
				setTimeout(poll, 4000);
			})();
		</script>
	}
}
