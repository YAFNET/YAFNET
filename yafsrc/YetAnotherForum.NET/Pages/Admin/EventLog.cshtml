@page "{p:int=1}/{handler?}"

@model EventLogModel
@using YAF.Types.Interfaces
@using YAF.Types.Extensions
@using YAF.Types.Interfaces.Services
@using YAF.Types.Objects
@using YAF.Web.HtmlHelpers

@{
    var total = Model.List.NullOrEmpty() ? 0 : Model.List.FirstOrDefault()!.TotalRows;
    var allCount = Model.TypeCounts.Values.Sum();
    var types = Model.TypeCounts.Where(t => t.Value > 0 || t.Key == Model.Input.Type).OrderByDescending(t => t.Value).ToList();

    if (Model.Input.Type != -1 && !Model.TypeCounts.ContainsKey(Model.Input.Type))
    {
        types.Add(new KeyValuePair<int, int>(Model.Input.Type, 0));
    }
}

<form method="post" class="admin-edit-form admin-event-log">
    <input type="hidden" asp-for="Input.Type" />

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h2 class="h4 mb-0">
            @Html.Icon("book")@Html.LocalizedText("ADMIN_EVENTLOG", "TITLE")
            <span class="badge text-bg-secondary align-middle ms-1">@total</span>
        </h2>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <div class="input-group input-group-sm w-auto" role="group">
                <div class="input-group-text">
                    @Html.LocalizedText("SHOW"):
                </div>
                <select asp-for="@Model.Size"
                        asp-items="Model.PageSizeList"
                        title="@Html.LocalizedText("COMMON", "SHOW_TITLE")"
                        aria-label="@Html.LocalizedText("COMMON", "SHOW_TITLE")"
                        class="form-select"
                        onchange="this.form.submit();"></select>
            </div>
            @if (total > 0)
            {
                <button button-style="Danger"
                        button-size="Small"
                        Icon="trash"
                        asp-page-handler="DeleteAll"
                        text-localized-page="ADMIN_EVENTLOG" text-localized-tag="DELETE_ALLOWED"
                        return-confirm-tag="CONFIRM_DELETE_ALL">
                </button>
            }
        </div>
    </div>

    @* the period, on small screens it is folded while the default filter is used *@
    <div class="card mb-3 event-filter">
        <div class="card-body py-2">
            <button type="button"
                    class="btn btn-sm btn-secondary d-md-none@(Model.FilterActive ? "" : " collapsed")"
                    data-bs-toggle="collapse"
                    data-bs-target="#EventFilter"
                    aria-expanded="@(Model.FilterActive ? "true" : "false")"
                    aria-controls="EventFilter">
                @Html.Icon("filter")@Html.LocalizedText("ADMIN_USERS", "FILTER_DROPDOWN")
            </button>
            <div id="EventFilter" class="collapse d-md-block@(Model.FilterActive ? " show" : "")">
                <div class="row g-2 align-items-end pt-2 pt-md-0">
                    <div class="col-sm-6 col-md-4">
                        <label class="form-label small mb-1" info-button="true"
                               asp-for="Input.SinceDate"
                               localized-page="ADMIN_EVENTLOG" localized-tag="SINCEDATE"></label>
                        <input type="date" asp-for="Input.SinceDate"
                               class="form-control form-control-sm" />
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <label class="form-label small mb-1" info-button="true"
                               asp-for="Input.ToDate"
                               localized-page="ADMIN_EVENTLOG" localized-tag="TODATE"></label>
                        <input type="date" asp-for="Input.ToDate"
                               class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-auto d-grid">
                        <button button-style="Primary"
                                button-size="Small"
                                asp-page-handler="ApplyButton"
                                asp-route-p="1"
                                text-localized-page="ADMIN_EVENTLOG"
                                text-localized-tag="APPLY"
                                Icon="check"></button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* the types of the period, a chip filters the list by its type *@
    @if (allCount > 0 || Model.Input.Type != -1)
    {
        <div class="event-types d-flex flex-wrap gap-2 mb-3" role="group" aria-label="@Html.LocalizedText("ADMIN_EVENTLOG", "TYPES")">
            <button type="submit"
                    class="btn btn-sm event-type @(Model.Input.Type == -1 ? "btn-secondary" : "btn-outline-secondary")"
                    asp-page-handler="TypeFilter"
                    asp-route-p="1"
                    data-type="-1"
                    data-set-values='{"#Input_Type":"-1"}'>
                @Html.LocalizedText("ADMIN_EVENTLOG", "ALL_TYPES")
                <span class="badge rounded-pill bg-body text-body-emphasis ms-1">@allCount</span>
            </button>
            @foreach (var type in types)
            {
                var (icon, color) = EventLogModel.GetTypeIcon(type.Key);
                var selected = type.Key == Model.Input.Type;

                <button type="submit"
                        class="btn btn-sm event-type @(selected ? $"btn-{color}" : $"btn-outline-{color}")"
                        asp-page-handler="TypeFilter"
                        asp-route-p="1"
                        data-type="@type.Key"
                        data-set-values='@($"{{\"#Input_Type\":\"{type.Key}\"}}")'>
                    @Html.Icon(icon)@EventLogModel.GetTypeName(type.Key)
                    <span class="badge rounded-pill bg-body text-body-emphasis ms-1">@type.Value</span>
                </button>
            }
        </div>
    }

    @if (!Model.List.NullOrEmpty())
    {
        <ul class="list-group mb-3">
            @foreach (var item in Model.List)
            {
                var (icon, color) = EventLogModel.GetTypeIcon(item.Type);

                <li class="list-group-item list-group-item-menu event-row" data-type="@item.Type">
                    <div class="event-head">
                        <span class="event-icon bg-@(color)-subtle text-@(color)-emphasis" title="@EventLogModel.GetTypeName(item.Type)">
                            <i class="fas fa-@icon fa-fw"></i>
                        </span>
                        <div class="event-main">
                            <div class="event-message text-break"
                                 role="button"
                                 data-bs-toggle="collapse"
                                 data-bs-target="#eventDetails@(item.ID)">@EventLogModel.GetSummary(item)</div>
                            <div class="event-meta small text-body-secondary">
                                <span class="badge bg-@(color)-subtle text-@(color)-emphasis border border-@(color)-subtle">@EventLogModel.GetTypeName(item.Type)</span>
                                <span class="text-break" title="@Html.LocalizedText("ADMIN_EVENTLOG", "SOURCE")">
                                    @Html.Icon("code")@(item.Source.IsSet() ? item.Source : "N/A")
                                </span>
                                <span title="@Html.LocalizedText("ADMIN_EVENTLOG", "TIME")">
                                    @Html.Icon("clock")@Html.Raw(Model.Get<IDateTimeService>().FormatDateTimeTopic(item.EventTime))
                                </span>
                                @if (item.UserID != 0)
                                {
                                    <span>
                                        @Html.Icon("user")@Html.UserLink(item.UserID,
                                                              Model.PageBoardContext.BoardSettings.EnableDisplayName ? item.DisplayName : item.Name,
                                                              item.Suspended,
                                                              item.UserStyle,
                                                              isGuest: item.UserFlags.IsGuest)
                                    </span>
                                }
                            </div>
                        </div>
                        <div class="btn-group btn-group-sm event-actions">
                            <button type="button"
                                    class="btn btn-sm btn-info event-toggle collapsed"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#eventDetails@(item.ID)"
                                    aria-expanded="false"
                                    aria-controls="eventDetails@(item.ID)">
                                <span class="event-show">@Html.Icon("caret-square-down")@Html.LocalizedText("ADMIN_EVENTLOG", "SHOW")</span>
                                <span class="event-hide">@Html.Icon("caret-square-up")@Html.LocalizedText("ADMIN_EVENTLOG", "HIDE")</span>
                            </button>
                            <button button-style="Danger"
                                    button-size="Small"
                                    asp-page-handler="Delete"
                                    asp-route-id="@Html.Raw(item.ID)"
                                    return-confirm-tag="CONFIRM_DELETE"
                                    title-localized-tag="DELETE"
                                    Icon="trash"
                                    text-localized-tag="DELETE">
                            </button>
                        </div>
                    </div>
                    <div class="dropdown-menu context-menu" aria-labelledby="context menu">
                        <button button-style="None"
                                class="dropdown-item"
                                asp-page-handler="Delete"
                                asp-route-id="@Html.Raw(item.ID)"
                                return-confirm-tag="CONFIRM_DELETE"
                                Icon="trash"
                                text-localized-tag="DELETE">
                        </button>
                        <button button-style="None"
                                class="dropdown-item"
                                Icon="clipboard"
                                onclick="@Html.Raw($"copyToClipBoard($('#eventDetails{item.ID} code').text())")"
                                text-localized-tag="COPY_TO_CLIPBOARD">
                        </button>
                        <div class="dropdown-divider"></div>
                        <button button-style="None"
                                class="dropdown-item"
                                Icon="trash"
                                asp-page-handler="DeleteAll"
                                text-localized-page="ADMIN_EVENTLOG" text-localized-tag="DELETE_ALLOWED"
                                return-confirm-tag="CONFIRM_DELETE_ALL">
                        </button>
                    </div>

                    <div class="collapse" id="eventDetails@(item.ID)">
                        <div class="card card-body mt-2 event-details">
                            <pre class="pre-scrollable stacktrace overflow-auto mb-0"><code>@Html.Raw(Model.FormatStackTrace(item.Description))</code></pre>
                        </div>
                    </div>
                </li>
            }
        </ul>

        @await Html.PartialAsync("_Pagination", new Pagination { TotalRows = total, Size = Model.Size })
    }
    else
    {
        <div class="card mb-3">
            <div class="card-body">
                <empty icon="book"
                       header-text-page="ADMIN_EVENTLOG" header-text-tag="EMPTY_HEADER"
                       message-text-page="ADMIN_EVENTLOG" message-text-tag="EMPTY_MESSAGE">
                </empty>
            </div>
        </div>
    }
</form>

@section Scripts {
    <script src="~/js/admin-edit-form.min.js" asp-append-version="true"></script>
}
