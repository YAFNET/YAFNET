@page "{u:int}/{handler?}"
@using YAF.Types.Constants
@using YAF.Types.Extensions
@using YAF.Types.Interfaces
@using YAF.Types.Interfaces.Services
@using YAF.Web.HtmlHelpers
@model PageAccessEditModel

@{
    // the pages grouped by the sections of the admin menu (the list is in this order)
    var sections = Model.AccessList.Select((access, index) => (access, index))
        .GroupBy(x => PageAccessEditModel.GetSectionIndex(x.access.PageName));
}

<form method="post" class="admin-edit-form admin-page-access">
    <input type="hidden" asp-for="UserId" value="@Model.UserId" />

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h2 class="h4 mb-0 text-break">
            @Html.Icon("building")@Html.LocalizedText("ADMIN_PAGEACCESSEDIT", "HEADER")
            <strong class="ms-1">@(Model.Get<IUserDisplayName>().GetNameById(Model.UserId))</strong>
        </h2>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-9">
            @foreach (var section in sections)
            {
                var (tag, icon) = section.Key < PageAccessEditModel.Sections.Length
                                      ? (PageAccessEditModel.Sections[section.Key].Tag, PageAccessEditModel.Sections[section.Key].Icon)
                                      : (null, "ellipsis-h");
                var sectionId = $"PageSection{section.Key}";

                <div class="card mb-3" id="@sectionId">
                    <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <span>
                            @Html.Icon(icon)@(tag is null ? Html.LocalizedText("ADMIN_PAGEACCESSEDIT", "OTHER_PAGES") : Html.LocalizedText("ADMINMENU", tag))
                        </span>
                        @* all pages of the section (in the browser, saved with the form), not for the admin index (always allowed) *@
                        @if (section.Any(x => x.access.PageName != "Admin_Admin"))
                        {
                        <div class="form-check form-switch mb-0">
                            <input type="checkbox" class="form-check-input" role="switch"
                                   id="@(sectionId)_All"
                                   data-check-all="#@sectionId input.page-access-check:not(:disabled)" />
                            <label class="form-check-label small" for="@(sectionId)_All">
                                @Html.LocalizedText("ADMIN_PAGEACCESSEDIT", "ALL_PAGES")
                            </label>
                        </div>
                        }
                    </div>
                    <div class="list-group list-group-flush">
                        @foreach (var (access, index) in section)
                        {
                            // the admin index can always be opened
                            var always = access.PageName == "Admin_Admin";

                            <div class="list-group-item">
                                <input type="hidden" asp-for="AccessList[index].PageName" value="@access.PageName" />
                                <div class="form-check form-switch mb-0">
                                    <input type="checkbox" name="AccessList[@index].ReadAccess" value="true"
                                           id="AccessList_@(index)__ReadAccess"
                                           class="form-check-input page-access-check" role="switch"
                                           checked="@(always || access.ReadAccess)"
                                           disabled="@always" />
                                    <label class="form-check-label" for="AccessList_@(index)__ReadAccess">
                                        @Model.GetPageTitle(access.PageName)
                                        <code class="small text-body-secondary ms-1">@access.PageName</code>
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @* the actions stay visible at the bottom of the window *@
            <div class="admin-edit-actions">
                <a asp-page="@ForumPages.Admin_PageAccessList.GetPageName()"
                   button-style="Secondary"
                   Icon="xmark"
                   text-localized-tag="CANCEL"
                   text-localized-page="ADMIN_PAGEACCESSEDIT"></a>
                <button asp-page-handler="RevokeAll"
                        button-style="OutlineSecondary"
                        Icon="times"
                        text-localized-tag="REVOKEALL"
                        text-localized-page="ADMIN_PAGEACCESSEDIT"></button>
                <button asp-page-handler="GrantAll"
                        button-style="OutlineSecondary"
                        Icon="check"
                        text-localized-tag="GRANTALL"
                        text-localized-page="ADMIN_PAGEACCESSEDIT"></button>
                <button asp-page-handler="Save"
                        button-style="Primary"
                        Icon="save"
                        text-localized-tag="SAVE"
                        text-localized-page="ADMIN_PAGEACCESSEDIT"></button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/admin-edit-form.min.js" asp-append-version="true"></script>
}
