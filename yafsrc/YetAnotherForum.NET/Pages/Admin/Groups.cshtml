@page "{handler?}"

@model GroupsModel
@using YAF.Types.Constants
@using YAF.Types.Extensions
@using YAF.Types.Interfaces
@using YAF.Types.Interfaces.Services
@using YAF.Web.HtmlHelpers

@{
    var styleTransform = Model.Get<IStyleTransform>();
}

<form method="post" class="admin-groups">

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h2 class="h4 mb-0">
        @Html.IconHeader("users", "ADMIN_GROUPS", "TITLE")
        <span class="badge rounded-pill text-bg-secondary align-middle">@(Model.RoleListYaf?.Count ?? 0)</span>
    </h2>
    <a asp-page="@ForumPages.Admin_EditGroup.GetPageName()"
       button-style="Primary"
       Icon="plus-square"
       text-localized-tag="NEW_ROLE">
    </a>
</div>

@if (Model.RoleListNet is { Count: > 0 })
{
    @* the roles of the provider without a group of this board *@
    <div class="card border-warning mb-3">
        <div class="card-header">
            <button type="button" class="btn btn-link p-0 text-reset text-decoration-none fw-semibold"
                    data-bs-toggle="collapse" data-bs-target="#ProviderRoles"
                    aria-expanded="false" aria-controls="ProviderRoles">
                @Html.Icon("exclamation-triangle", "text-warning")@Html.LocalizedText("ADMIN_GROUPS", "PROVIDER_ROLES")
                <span class="badge rounded-pill text-bg-warning ms-1">@Model.RoleListNet.Count</span>
            </button>
        </div>
        <div id="ProviderRoles" class="collapse">
            <div class="card-body">
                <p class="small text-body-secondary">@Html.LocalizedText("ADMIN_GROUPS", "NOTE_DELETE")</p>
                <ul class="list-group">
                    @foreach (var role in Model.RoleListNet)
                    {
                        <li class="list-group-item d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <span class="text-break">
                                @role
                                <span class="badge bg-body-tertiary text-body-secondary border ms-1">@Html.LocalizedText("ADMIN_GROUPS", "UNLINKED")</span>
                            </span>
                            <span class="btn-group btn-group-sm">
                                <button button-style="Info"
                                        button-size="Small"
                                        asp-page-handler="Add"
                                        asp-route-role="@role"
                                        title-localized-tag="ADD_ROLETOYAF"
                                        title-localized-page="ADMIN_GROUPS"
                                        text-localized-tag="ADD_ROLETOYAF"
                                        text-localized-page="ADMIN_GROUPS"
                                        Icon="plus-circle">
                                </button>
                                <button button-style="Danger"
                                        button-size="Small"
                                        asp-page-handler="DeleteNet"
                                        asp-route-role="@role"
                                        title-localized-tag="DELETE"
                                        Icon="trash"
                                        text-localized-tag="DELETE"
                                        return-confirm-tag="CONFIRM_DELETE">
                                </button>
                            </span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

@if (!Model.RoleListYaf.NullOrEmpty())
{
    <ul class="list-group mb-3">
        @foreach (var role in Model.RoleListYaf)
        {
            var flags = role.GroupFlags;
            var canDelete = !flags.IsGuest && !flags.IsAdmin;
            var members = Model.MemberCounts.TryGetValue(role.ID, out var count) ? count : 0;
            var icon = flags.IsGuest ? "user-secret" : flags.IsAdmin ? "user-shield" : flags.IsModerator ? "user-tie" : "users";

            <li class="list-group-item group-row list-group-item-menu" data-group-id="@role.ID">
                <span class="group-icon">@Html.Icon(icon)</span>
                <div class="group-main">
                    <div class="d-flex flex-wrap align-items-center gap-1">
                        <a class="group-name"
                           asp-page="@ForumPages.Admin_EditGroup.GetPageName()"
                           asp-route-i="@role.ID"
                           style="@styleTransform.Decode(role.Style)">@role.Name</a>
                        @if (flags.IsAdmin)
                        {
                            <span class="badge text-bg-danger">@Html.LocalizedText("ADMIN_GROUPS", "ADMIN")</span>
                        }
                        @if (flags.IsModerator)
                        {
                            <span class="badge text-bg-primary">@Html.LocalizedText("ADMIN_GROUPS", "MODERATOR")</span>
                        }
                        @if (flags.IsStart)
                        {
                            <span class="badge text-bg-success">@Html.LocalizedText("ADMIN_GROUPS", "START")</span>
                        }
                        @if (flags.IsGuest)
                        {
                            <span class="badge bg-body-tertiary text-body-secondary border">@Html.LocalizedText("ADMIN_GROUPS", "GUEST")</span>
                        }
                    </div>
                    @if (role.Description.IsSet())
                    {
                        <div class="group-description">@role.Description</div>
                    }
                    <div class="group-meta">
                        <span>@Html.LocalizedText("ADMIN_GROUPS", "PRIORITY_SHORT") @role.SortOrder</span>
                        <span>@Html.Icon("signature")@Html.LocalizedTextFormatted("SIGNATURE_SHORT", role.UsrSigChars)</span>
                        <span>@Html.Icon("images")@Html.LocalizedTextFormatted("ALBUMS_SHORT", role.UsrAlbums, role.UsrAlbumImages)</span>
                        @if (flags.AllowUpload)
                        {
                            <span>@Html.Icon("upload")@Html.LocalizedText("ADMIN_ACCESSMASKS", "UPLOAD")</span>
                        }
                        @if (flags.AllowDownload)
                        {
                            <span>@Html.Icon("download")@Html.LocalizedText("ADMIN_ACCESSMASKS", "DOWNLOAD")</span>
                        }
                    </div>
                </div>
                <a class="group-members btn btn-sm btn-outline-secondary"
                   asp-page="@ForumPages.Admin_Users.GetPageName()"
                   asp-route-g="@role.ID"
                   title="@Html.LocalizedText("ADMIN_GROUPS", "SHOW_MEMBERS")">
                    @Html.Icon("user")@($"{members:N0}")
                    <span class="visually-hidden">@Html.LocalizedText("ADMIN_GROUPS", "MEMBERS")</span>
                </a>
                <div class="btn-group btn-group-sm group-actions">
                    <a button-style="Info"
                       button-size="Small"
                       asp-page="@ForumPages.Admin_EditGroup.GetPageName()"
                       asp-route-i="@role.ID"
                       title-localized-tag="EDIT"
                       Icon="edit"
                       text-localized-tag="EDIT">
                    </a>
                    @if (canDelete)
                    {
                        <button button-style="Danger"
                                button-size="Small"
                                asp-page-handler="Delete"
                                asp-route-id="@role.ID"
                                return-confirm-tag="CONFIRM_DELETE"
                                title-localized-tag="DELETE"
                                Icon="trash"
                                text-localized-tag="DELETE">
                        </button>
                    }
                </div>
                <div class="dropdown-menu context-menu" aria-labelledby="context menu">
                    <a button-style="None"
                       class="dropdown-item"
                       asp-page="@ForumPages.Admin_EditGroup.GetPageName()"
                       asp-route-i="@role.ID"
                       title-localized-tag="EDIT"
                       Icon="edit"
                       text-localized-tag="EDIT">
                    </a>
                    <a button-style="None"
                       class="dropdown-item"
                       asp-page="@ForumPages.Admin_Users.GetPageName()"
                       asp-route-g="@role.ID"
                       Icon="user"
                       text-localized-tag="SHOW_MEMBERS"
                       text-localized-page="ADMIN_GROUPS">
                    </a>
                    @if (canDelete)
                    {
                        <button button-style="None"
                                class="dropdown-item"
                                asp-page-handler="Delete"
                                asp-route-id="@role.ID"
                                return-confirm-tag="CONFIRM_DELETE"
                                title-localized-tag="DELETE"
                                Icon="trash"
                                text-localized-tag="DELETE">
                        </button>
                    }
                    <div class="dropdown-divider"></div>
                    <a asp-page="@ForumPages.Admin_EditGroup.GetPageName()"
                       button-style="None"
                       class="dropdown-item"
                       Icon="plus-square"
                       text-localized-tag="NEW_ROLE">
                    </a>
                </div>
            </li>
        }
    </ul>
}

</form>
