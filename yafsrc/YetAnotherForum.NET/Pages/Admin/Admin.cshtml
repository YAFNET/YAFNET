@page "{p:int=1}/{p2:int=1}/{handler?}"
@model AdminModel
@using YAF.Core.Context
@using YAF.Core.Extensions
@using YAF.Types.Interfaces
@using YAF.Types.Interfaces.Services
@using YAF.Types.Constants
@using YAF.Core.Helpers
@using YAF.Types.Extensions
@using YAF.Types.Models
@using YAF.Web.HtmlHelpers

@section StyleSheets {
	@await Html.PartialAsync("_FlagIconsStylesSheetsPartial")
}

@{
	// the stat labels end with a colon ("Number of posts:"), not needed as a tile title
	Func<string, string> statLabel = tag => Model.GetText("ADMIN_ADMIN", tag).TrimEnd(' ', ':', '：');

	// the page comes from the url, a page after the last one has no rows
	var countActive = Model.ActiveUserList.HasItems() ? Model.ActiveUserList[0].UserCount : 0;
	var indexActive = Math.Max(HttpContext.Request.GetQueryOrRouteValue<int>("p").ToTypeOrDefault(1) - 1, 0);
	var showingFromActive = Model.ActiveUserList.HasItems() ? (long)indexActive * Model.Size + 1 : 0;
	var showingToActive = Model.ActiveUserList.HasItems() ? (long)indexActive * Model.Size + Model.ActiveUserList.Count : 0;

	// the unverified users have their own page (p2) and page size
	var indexUnverified = Math.Max(HttpContext.Request.GetQueryOrRouteValue<int>("p2").ToTypeOrDefault(1) - 1, 0);
	var showingFromUnverified = !Model.UserList.NullOrEmpty() ? (long)indexUnverified * Model.Input.UnverifiedPageSize + 1 : 0;
	var showingToUnverified = !Model.UserList.NullOrEmpty() ? (long)indexUnverified * Model.Input.UnverifiedPageSize + Model.UserList.Count : 0;
}

<form method="post" class="admin-dashboard">
@if (Model.UpdateHighlight.IsSet())
{
	<alert type="info">
		<h6 class="alert-heading mb-0">
			@Html.Icon("box-open", "text-info")
			@Html.LocalizedText("NEW_VERSION")
			<a text-localized-tag="UPGRADE_VERSION"
			   button-style="Info"
			   Icon="cloud-download-alt"
			   href="@Model.UpdateHighlight"></a>
		</h6>
	</alert>
}

<div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2 mb-3">
	<h2 class="h4 mb-0">
		@Html.IconHeader("tachometer-alt", "ADMIN_ADMIN", "HEADER3")
		<strong>@(Model.PageBoardContext.BoardSettings.Name)</strong>
	</h2>
	@* the version check (it was the page admin version) *@
	<div class="d-flex flex-wrap align-items-center gap-2 dashboard-version" id="DashboardVersion">
		<span class="badge bg-body-tertiary text-body-secondary border"
		      title="@HtmlTagHelper.StripHtml(Model.RunningVersion)">
			@Html.Icon("code-branch")YAF.NET @Model.AppVersionName
		</span>
		@if (Model.UpdateHighlight.IsSet())
		{
			<a class="badge text-bg-warning text-decoration-none version-new" href="@Model.UpdateHighlight"
			   title="@HtmlTagHelper.StripHtml(Model.LatestVersion ?? string.Empty)">
				@Html.Icon("cloud-download-alt")@Html.LocalizedText("NEW_VERSION")
			</a>
		}
		else if (Model.LatestVersion.IsSet())
		{
			<span class="badge bg-success-subtle text-success-emphasis border border-success-subtle version-current"
			      title="@HtmlTagHelper.StripHtml(Model.LatestVersion)">
				@Html.Icon("check")@Html.LocalizedText("ADMIN_ADMIN", "UP_TO_DATE")
			</span>
		}
	</div>
</div>

@* key figures *@
<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xxl-6 g-3 mb-3">
	<div class="col">
		<div class="card stats-card h-100">
			<div class="card-body d-flex align-items-center gap-3">
				<div class="stats-icon bg-primary-subtle text-primary-emphasis">
					@Html.Icon("comment", marginEnd: false)
				</div>
				<div class="stats-body">
					<div class="stats-label">@statLabel("NUM_POSTS")</div>
					<div class="stats-value stats" data-count-target="@Model.Stats.Posts">@Model.Input.NumPosts</div>
					<div class="stats-caption">
						@Html.LocalizedText("ADMIN_ADMIN", "POSTS_DAY") <span class="text-nowrap">@Model.Input.DayPosts</span>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="col">
		<div class="card stats-card h-100">
			<div class="card-body d-flex align-items-center gap-3">
				<div class="stats-icon bg-info-subtle text-info-emphasis">
					@Html.Icon("comments", marginEnd: false)
				</div>
				<div class="stats-body">
					<div class="stats-label">@statLabel("NUM_TOPICS")</div>
					<div class="stats-value stats" data-count-target="@Model.Stats.Topics">@Model.Input.NumTopics</div>
					<div class="stats-caption">
						@Html.LocalizedText("ADMIN_ADMIN", "TOPICS_DAY") <span class="text-nowrap">@Model.Input.DayTopics</span>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="col">
		<div class="card stats-card h-100">
			<div class="card-body d-flex align-items-center gap-3">
				<div class="stats-icon bg-success-subtle text-success-emphasis">
					@Html.Icon("users", marginEnd: false)
				</div>
				<div class="stats-body">
					<div class="stats-label">@statLabel("NUM_USERS")</div>
					<div class="stats-value stats" data-count-target="@Model.Stats.Users">@Model.Input.NumUsers</div>
					<div class="stats-caption">
						@Html.LocalizedText("ADMIN_ADMIN", "USERS_DAY") <span class="text-nowrap">@Model.Input.DayUsers</span>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="col">
		<div class="card stats-card h-100">
			<div class="card-body d-flex align-items-center gap-3">
				<div class="stats-icon bg-warning-subtle text-warning-emphasis">
					@Html.Icon("layer-group", marginEnd: false)
				</div>
				<div class="stats-body">
					<div class="stats-label">@statLabel("NUM_FORUMS")</div>
					<div class="stats-value stats" data-count-target="@Model.Input.NumForums">@Model.Input.NumForums</div>
					<div class="stats-caption">
						@Html.LocalizedText("ADMIN_ADMIN", "NUM_CATEGORIES") <span class="text-nowrap">@Model.Input.NumCategories</span>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="col">
		<div class="card stats-card h-100">
			<div class="card-body d-flex align-items-center gap-3">
				<div class="stats-icon bg-danger-subtle text-danger-emphasis">
					@Html.Icon("database", marginEnd: false)
				</div>
				<div class="stats-body">
					<div class="stats-label">@statLabel("SIZE_DATABASE")</div>
					<div class="stats-value">@Model.Input.DBSize</div>
				</div>
			</div>
		</div>
	</div>
	<div class="col">
		<div class="card stats-card h-100">
			<div class="card-body d-flex align-items-center gap-3">
				<div class="stats-icon bg-secondary-subtle text-secondary-emphasis">
					@Html.Icon("globe", marginEnd: false)
				</div>
				<div class="stats-body">
					<div class="stats-label">@statLabel("BOARD_STARTED")</div>
					<div class="stats-value stats-value-sm">
						@Html.DisplayDateTime(DateTimeFormat.BothTopic, Model.Input.BoardStartAgo)
					</div>
					<div class="stats-caption">@Html.Raw(Model.Input.BoardStart)</div>
				</div>
			</div>
		</div>
	</div>
</div>

<p class="small text-body-secondary mt-n2 mb-3">
	@Html.LocalizedText("ADMIN_ADMIN", "STATS_DONTCOUNT")
</p>

@* registrations and the background tasks *@
<div class="row g-3 mb-3">
	<div class="col-xl-8">
		<div class="card h-100">
			<div class="card-header">
				@Html.IconHeader("chart-line", "ADMIN_ADMIN", "REGISTRATIONS_TITLE")
			</div>
			<div class="card-body">
				<div class="chart-container chart-container-wide">
					<canvas id="chart-registrations"
					        data-url="@(Model.Get<IUrlHelper>().Action("GetUserStats", "Stats"))"
					        data-label="@(Model.GetText("ADMIN_ADMIN", "REGISTRATIONS"))"></canvas>
				</div>
			</div>
		</div>
	</div>
	<div class="col-xl-4">
		<div class="card h-100">
			<div class="card-header d-flex justify-content-between align-items-center">
				<span>@Html.IconHeader("tasks", "ADMIN_TASKMANAGER", "TITLE")</span>
				<span class="badge rounded-pill @(Model.RunningTaskCount > 0 ? "text-bg-success" : "text-bg-secondary")"
				      data-bs-toggle="tooltip"
				      data-bs-title="@string.Format(Model.GetText("ADMIN_TASKMANAGER", "HEADER"), Model.RunningTaskCount)">
					@Model.RunningTaskCount / @Model.Tasks.Count
				</span>
			</div>
			@if (!Model.Tasks.NullOrEmpty())
			{
				<ul class="list-group list-group-flush task-list"
				    data-server-now="@AdminModel.StartedTimestamp(DateTime.UtcNow)">
					@foreach (var task in Model.Tasks)
					{
						<li class="list-group-item">
							<div class="d-flex justify-content-between align-items-start gap-2">
								<div class="text-break">
									<div class="fw-semibold">@task.TaskName</div>
									<div class="small text-body-secondary">@task.TaskDescription</div>
								</div>
								@if (task.IsRunning)
								{
									<span class="badge rounded-pill text-bg-success flex-shrink-0">
										@Html.Icon("sync", "fa-spin")@Html.LocalizedText("ADMIN_TASKMANAGER", "STATUS_RUNNING")
									</span>
								}
								else
								{
									<span class="badge rounded-pill text-bg-secondary flex-shrink-0">
										@Html.Icon("check")@Html.LocalizedText("ADMIN_TASKMANAGER", "STATUS_FINISHED")
									</span>
								}
							</div>
							<div class="small text-body-secondary mt-1">
								@Html.Icon("clock")@Html.LocalizedText("ADMIN_TASKMANAGER", "DURATION"):
								<span class="font-monospace task-duration"
								      data-started="@AdminModel.StartedTimestamp(task.Started)">@AdminModel.FormatDuration(task.Started)</span>
							</div>
						</li>
					}
				</ul>
			}
			else
			{
				<div class="card-body flex-grow-1">
					<p class="text-body-secondary text-center mb-0 py-3">
						@Html.Icon("circle-info")@Html.LocalizedText("ADMIN_EVENTLOG", "NO_ENTRY")
					</p>
				</div>
			}
		</div>
	</div>
</div>

@* user statistics *@
<div class="row g-3 mb-3">
	<div class="col-md-6 @(Model.Get<IGeoIpCountryService>().DatabaseExists() ? "col-xl-4" : "")">
		<div class="card h-100">
			<div class="card-header">
				@Html.IconHeader("chart-pie", "ADMIN_ADMIN", "BROWSER")
			</div>
			<div class="card-body">
				<div class="chart-container">
					<canvas id="chart-browsers"
					        data-label="@(Model.GetText("BROWSER"))"></canvas>
				</div>
			</div>
		</div>
	</div>
	<div class="col-md-6 @(Model.Get<IGeoIpCountryService>().DatabaseExists() ? "col-xl-4" : "")">
		<div class="card h-100">
			<div class="card-header">
				@Html.IconHeader("chart-pie", "ADMIN_ADMIN", "PLATFORM")
			</div>
			<div class="card-body">
				<div class="chart-container">
					<canvas id="chart-platforms"
					        data-label="@(Model.GetText("PLATFORM"))"></canvas>
				</div>
			</div>
		</div>
	</div>
	@if (Model.Get<IGeoIpCountryService>().DatabaseExists())
	{
		<div class="col-xl-4">
			<div class="card h-100">
				<div class="card-header">
					@Html.IconHeader("globe", "ADMIN_ADMIN", "COUNTRIES")
				</div>
				<div class="card-body">
					<div class="chart-container">
						<canvas id="chart-countries"
						        data-label="@(Model.GetText("ADMIN_ADMIN", "COUNTRY"))"></canvas>
					</div>
				</div>
			</div>
		</div>
	}
</div>

@* who is online and the unverified users *@
<div class="row g-3 mb-3">
	<div class="col-xl-8">
		<div class="card h-100">
			<div class="card-header">
				<div class="row justify-content-between align-items-center g-2">
					<div class="col-auto">
						@Html.IconHeader("users", "ADMIN_ADMIN", "HEADER1")
						<span class="badge rounded-pill text-bg-primary ms-1">@countActive</span>
					</div>
					<div class="col-auto">
						<div class="input-group input-group-sm" role="group">
							<div class="input-group-text">
								@Html.LocalizedText("SHOW"):
							</div>

							<select asp-for="@Model.Size"
							        asp-items="Model.PageSizeList"
							        title="@Html.LocalizedText("COMMON", "SHOW_TITLE")"
							        aria-label="@Html.LocalizedText("COMMON", "SHOW_TITLE")"
							        class="form-select"
							        onchange="this.form.submit();"></select>
						</div>
					</div>
				</div>
			</div>
			@if (!Model.ActiveUserList.NullOrEmpty())
			{
				var bannedIPs = Model.Get<IDataCache>().GetOrSet(
					Constants.Cache.BannedIP,
					() => Model.GetRepository<BannedIP>().Get(x => x.BoardID == BoardContext.Current.PageBoardID)
						.Select(x => x.Mask.Trim()).ToList());

				<ul class="list-group list-group-flush flex-grow-1">

					@foreach (var activeUser in Model.ActiveUserList)
					{
						var ipAddress = IPHelper.GetIpAddressAsString(activeUser.IP);

						var isBanned = bannedIPs.Contains(ipAddress);

						<li class="list-group-item list-group-item-action list-group-item-menu">
							<div class="d-flex flex-wrap w-100 justify-content-between align-items-start gap-2 text-break">
								<div>
									<div class="fw-semibold">
										@Html.UserLabel(
											Model.PageBoardContext.BoardSettings.EnableDisplayName ? activeUser.UserDisplayName : activeUser.UserName,
											activeUser.UserStyle,
											activeUser.ActiveFlags.IsCrawler ? activeUser.Browser : string.Empty)

										@if (activeUser.Country.IsSet() && !activeUser.Country.Equals("--"))
										{
											<span class="@($"fi fi-{activeUser.Country.ToLower()} ms-1")" title="@(Model.GetText("COUNTRY", activeUser.Country))"></span>
										}
									</div>
									<div class="small">
										<span data-bs-toggle="tooltip" data-bs-title="@Html.LocalizedText("ADMIN_ADMIN", "BOARD_LOCATION")">
											@Html.Icon("file-lines", "text-body-secondary")@Html.ActiveLocation(activeUser.UserID,
												                        false,
												                        activeUser.ForumPage,
												                        activeUser.Path,
												                        activeUser.ForumID ?? 0,
												                        activeUser.ForumName,
												                        activeUser.TopicID ?? 0,
												                        activeUser.TopicName,
												                        false)
										</span>
										<span class="text-body-secondary">(@activeUser.Path)</span>
									</div>
								</div>
								<div class="btn-group btn-group-sm flex-shrink-0">
									<a href="@Html.Raw(string.Format(Model.PageBoardContext.BoardSettings.IPInfoPageURL, ipAddress))"
									   button-style="OutlineInfo"
									   button-size="Small"
									   target="_blank" title-localized-tag="TT_IPDETAILS" title-localized-page="COMMON"
									   rel="noopener">
										@Html.Icon("computer")@Html.Raw(ipAddress) (@Model.CountRequests(activeUser.IP))
									</a>
									@if (!isBanned && Model.CanBanIps)
									{
										<button button-style="Danger"
										        button-size="Small"
										        asp-page-handler="BanIp"
										        asp-route-mask="@Html.Raw(ipAddress)"
										        asp-route-p="@Model.Request.RouteValues["p"]"
										        asp-route-p2="@Model.Request.RouteValues["p2"]"
										        text-localized-page="ADMIN_BANNEDIP_EDIT"
										        text-localized-tag="TITLE"
										        Icon="ban"></button>
									}
								</div>
							</div>
							<div class="small text-body-secondary mt-1 text-break">
								<div>
									@Html.Icon("user-secret")@activeUser.UserAgent
								</div>
								@if (activeUser.Referer.IsSet())
								{
									<div>
										@Html.Icon("link")@activeUser.Referer
									</div>
								}
							</div>
							<div class="dropdown-menu context-menu" aria-labelledby="context menu">
								@if (isBanned && Model.CanBanIps)
								{
									<button button-style="None"
									        class="dropdown-item"
									        bs-toggle="ajax-modal"
									        bs-target-url="@(Url.Page("BannedIps", "Edit", new { mask = ipAddress }))"
									        text-localized-page="ADMIN_BANNEDIP_EDIT"
									        text-localized-tag="TITLE"
									        Icon="edit"></button>
								}
							</div>
						</li>
					}

				</ul>
			}
			else
			{
				<div class="card-body flex-grow-1">
					<p class="text-body-secondary text-center mb-0 py-3">
						@Html.Icon("circle-info")@Html.LocalizedText("ADMIN_EVENTLOG", "NO_ENTRY")
					</p>
				</div>
			}
			<div class="card-footer">
				<div class="row justify-content-between align-items-center g-2">
					<div class="col-auto">
						<small class="text-body-secondary">
							@Html.LocalizedTextFormatted("SHOWING_X_TO_X_OF_X", showingFromActive, showingToActive, countActive)
						</small>
					</div>
					<div class="col-auto">
						<pager page-size="@Model.Size"
						       count="@countActive"
						       query-name="p" use-submit="false">
						</pager>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="col-xl-4">
		<div class="card h-100">
			<div class="card-header">
				<div class="row justify-content-between align-items-center g-2">
					<div class="col-auto">
						@Html.IconHeader("user-plus", "ADMIN_ADMIN", "HEADER2")
						<span class="badge rounded-pill @(Model.Input.UnverifiedCount > 0 ? "text-bg-warning" : "text-bg-secondary") ms-1">@Model.Input.UnverifiedCount</span>
					</div>
					<div class="col-auto">
						<div class="input-group input-group-sm" role="group">
							<div class="input-group-text">
								@Html.LocalizedText("SHOW"):
							</div>
							<select asp-for="@Model.Input.UnverifiedPageSize"
							        asp-items="Model.UnverifiedPageSizeList"
							        title="@Html.LocalizedText("COMMON", "SHOW_TITLE")"
							        aria-label="@Html.LocalizedText("COMMON", "SHOW_TITLE")"
							        class="form-select"
							        onchange="this.form.submit();"></select>
						</div>
					</div>
				</div>
			</div>

			@if (!Model.UserList.NullOrEmpty())
			{
				<ul class="list-group list-group-flush flex-grow-1">
					@foreach (var user in Model.UserList)
					{
						<li class="list-group-item list-group-item-action list-group-item-menu d-flex justify-content-between align-items-start gap-2">
							<div class="text-break">
								<div class="fw-semibold">
									@Model.HtmlEncode(Model.PageBoardContext.BoardSettings.EnableDisplayName ? user.DisplayName : user.Name)
								</div>
								<div class="small">
									@Html.Icon("envelope", "text-body-secondary")@user.Email
								</div>
								<div class="small text-body-secondary">
									@Html.LocalizedText("ADMIN_ADMIN", "ADMIN_JOINED"):
									@Html.Raw(Model.Get<IDateTimeService>().FormatDateTime(user.Joined))
								</div>
							</div>
							@* the actions need the access to the users pages (every admin can open the dashboard) *@
							@if (Model.CanManageUsers || Model.CanEditUsers)
							{
								<div class="flex-shrink-0">
									<button class="dropdown-toggle"
									        button-style="Secondary"
									        button-size="Small"
									        bs-toggle="dropdown"
									        aria-label="@Model.GetText("TOOLS")"
									        Icon="ellipsis-v"></button>
									<div class="dropdown-menu">
										@if (Model.CanEditUsers)
										{
											<a asp-page="@ForumPages.Admin_EditUser.GetPageName()"
											   asp-route-u="@Html.Raw(user.ID)"
											   Icon="user-edit"
											   text-localized-tag="EDITUSER"
											   button-style="None"
											   class="dropdown-item">
											</a>
										}
										@if (Model.CanManageUsers)
										{
											<button asp-page-handler="ResendEmail"
											        asp-route-id="@Html.Raw(user.ID)"
											        asp-route-p="@Model.Request.RouteValues["p"]"
											        asp-route-p2="@Model.Request.RouteValues["p2"]"
											        Icon="share"
											        text-localized-tag="ADMIN_RESEND_EMAIL"
											        button-style="None"
											        class="dropdown-item">
											</button>
											<button asp-page-handler="Approve"
											        asp-route-id="@Html.Raw(user.ID)"
											        asp-route-p="@Model.Request.RouteValues["p"]"
											        asp-route-p2="@Model.Request.RouteValues["p2"]"
											        button-style="None"
											        class="dropdown-item"
											        Icon="check"
											        text-localized-tag="ADMIN_APPROVE">
											</button>
											<button asp-page-handler="Delete"
											        asp-route-id="@Html.Raw(user.ID)"
											        asp-route-p="@Model.Request.RouteValues["p"]"
											        asp-route-p2="@Model.Request.RouteValues["p2"]"
											        button-style="None"
											        class="dropdown-item"
											        return-confirm-tag="CONFIRM_DELETE"
											        Icon="trash"
											        text-localized-tag="ADMIN_DELETE">
											</button>
										}
									</div>
								</div>
								<div class="dropdown-menu context-menu" aria-labelledby="context menu">
									@if (Model.CanEditUsers)
									{
										<a asp-page="@ForumPages.Admin_EditUser.GetPageName()"
										   asp-route-u="@Html.Raw(user.ID)"
										   Icon="user-edit"
										   text-localized-tag="EDITUSER"
										   button-style="None"
										   class="dropdown-item">
										</a>
									}
									@if (Model.CanManageUsers)
									{
										<button asp-page-handler="ResendEmail"
										        asp-route-id="@Html.Raw(user.ID)"
										        asp-route-p="@Model.Request.RouteValues["p"]"
										        asp-route-p2="@Model.Request.RouteValues["p2"]"
										        Icon="share"
										        text-localized-tag="ADMIN_RESEND_EMAIL"
										        button-style="None"
										        class="dropdown-item">
										</button>
										<button asp-page-handler="Approve"
										        asp-route-id="@Html.Raw(user.ID)"
										        asp-route-p="@Model.Request.RouteValues["p"]"
										        asp-route-p2="@Model.Request.RouteValues["p2"]"
										        button-style="None"
										        class="dropdown-item"
										        Icon="check"
										        text-localized-tag="ADMIN_APPROVE">
										</button>
										<button asp-page-handler="Delete"
										        asp-route-id="@Html.Raw(user.ID)"
										        asp-route-p="@Model.Request.RouteValues["p"]"
										        asp-route-p2="@Model.Request.RouteValues["p2"]"
										        button-style="None"
										        class="dropdown-item"
										        return-confirm-tag="CONFIRM_DELETE"
										        Icon="trash"
										        text-localized-tag="ADMIN_DELETE">
										</button>
									}
								</div>
							}
						</li>
					}
				</ul>
				@if (Model.CanManageUsers)
				{
					<div class="card-body border-top">
						<div class="d-flex flex-wrap gap-2 mb-2">
							<button asp-page-handler="ApproveAll"
							        asp-route-p="@Model.Request.RouteValues["p"]"
							        asp-route-p2="@Model.Request.RouteValues["p2"]"
							        button-style="Primary"
							        button-size="Small"
							        Icon="check"
							        text-localized-tag="APROVE_ALL"
							        return-confirm-tag="CONFIRM_APROVE_ALL"></button>
						</div>
						<div class="input-group input-group-sm">
							<input type="number" asp-for="Input.DaysOld"
							       placeholder="@Model.GetText("DELETE_ALL")"
							       aria-label="@Model.GetText("DELETE_ALL")"
							       class="form-control"/>
							<button asp-page-handler="DeleteAll"
							        asp-route-p="@Model.Request.RouteValues["p"]"
							        asp-route-p2="@Model.Request.RouteValues["p2"]"
							        button-style="Danger"
							        Icon="trash"
							        text-localized-tag="DELETE_ALL"
							        return-confirm-tag="CONFIRM_DELETE_ALL"></button>
						</div>
					</div>
				}
			}
			else
			{
				<div class="card-body flex-grow-1">
					<p class="text-body-secondary text-center mb-0 py-3">
						@Html.Icon("circle-info")@Html.LocalizedText("ADMIN_EVENTLOG", "NO_ENTRY")
					</p>
				</div>
			}
			<div class="card-footer">
				<div class="row justify-content-between align-items-center g-2">
					<div class="col-auto">
						<small class="text-body-secondary">
							@Html.LocalizedTextFormatted("SHOWING_X_TO_X_OF_X", showingFromUnverified, showingToUnverified, Model.Input.UnverifiedCount)
						</small>
					</div>
					<div class="col-auto">
						<pager page-size="@Model.Input.UnverifiedPageSize"
						       count="@Model.Input.UnverifiedCount"
						       query-name="p2" use-submit="false">
						</pager>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
</form>

@section Scripts {
	<script src="~/js/admin-dashboard.min.js" asp-append-version="true"></script>
}
